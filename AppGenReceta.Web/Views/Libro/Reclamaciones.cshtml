@using AppGenReceta.BE;
@model AppGenReceta.Web.Models.Libro.ReclamacionesViewModel
@{
    ViewBag.Title = "Reclamaciones";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

}


<div class="block-header">
    <div class="row">
        <div class="col-lg-7 col-md-6 col-sm-12">
            <h2>
                Reclamaciones
            </h2>
        </div>
        <div class="col-lg-5 col-md-6 col-sm-12">

            <ul class="breadcrumb float-md-right">
                <li class="breadcrumb-item"><a href="javascript:void(0)"><i class="zmdi zmdi-home"></i> Libro</a></li>
                <li class="breadcrumb-item active">Reclamaciones</li>
            </ul>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Basic Examples -->
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card">
                <div class="header">
                    <h2><strong>Busqueda</strong>  </h2>

                </div>
                <div class="body">

                    <form id="formBusqueda">
                        <div class="row clearfix">
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Codigo de Reclamo</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Codigo_formBusqueda">
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Tipo</label>
                                <div class="form-group">
                                    <select class="form-control show-tick" id="IDTipo_formBusqueda" name="IDTipo">
                                        <option value="0">Todos</option>
                                        @foreach (TipoBE tipo in Model.Tipos)
                                        {
                                            <option value="@tipo.IDTipo">@tipo.Nombre</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Estado</label>
                                <div class="form-group">
                                    <select class="form-control show-tick" id="Estado_formBusqueda" name="Estado">
                                        <option value="0">Todos</option>
                                        <option value="1">Pendientes</option>
                                        <option value="2">Atendidos</option>
                                        <option value="3">Cerrados</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                        <div class="float-right">

                            <button type="submit" class="btn btn-raised btn-primary btn-round waves-effect m-l-20" id="btnBuscar">BUSCAR</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover" id="tLibros">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombres</th>
                                    <th>Apellido Paterno</th>
                                    <th>Apellido Materno</th>
                                    <th>Tipo</th>
                                    <th>Fecha Registro</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<input type="hidden" id="URL_ListarLibroReclamoPaginado" value="@Url.Action("ListarLibroReclamoPaginado","Libro")" />
<input type="hidden" id="URL_ObtenerLibroReclamacionPorCodigo" value="@Url.Action("ObtenerLibroReclamacionPorCodigo", "Libro")" />
<input type="hidden" id="URL_EnviarCorreo" value="@Url.Action("EnviarCorreo", "Libro")" />


@section scripts{

    <script type="text/javascript" src="~/Content/assets/bundles/datatablescripts.bundle.js"></script>
    <script src="~/Content/assets/plugins/select2/select2.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-notify/bootstrap-notify.js"></script>

    <script type="text/javascript" src="~/Scripts/Libro/Reclamaciones.js"></script>


}

@section modals {

    <div class="modal fade" id="ModalReclamo" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="title" id="defaultModalLabel">Reclamo <span id="Codigo_ModalReclamo"></span></h4>
                </div>
                <div class="modal-body">

                    <form id="frmActualizarRespuesta" method="post" action="@Url.Action("ActualizarRespuesta","Libro")">

                        <input type="hidden" id="IDLibroReclamacion_ModalReclamo" name="IDLibroReclamacion" />
                        <div class="row clearfix">
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Nombres</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Nombres_ModalReclamo" disabled>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Apellido Paterno</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="ApellidoPaterno_ModalReclamo" disabled>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Apellido Materno</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="ApellidoMaterno_ModalReclamo" disabled>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Documento</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Documento_ModalReclamo" disabled>
                                </div>
                            </div>

                        </div>

                        <div class="row clearfix">
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Correo</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Correo_ModalReclamo" disabled>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Celular o Telefono</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="TelefonoCelular_ModalReclamo" disabled>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Departamento</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Departamento_ModalReclamo" disabled>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Provincia</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Provincia_ModalReclamo" disabled>
                                </div>
                            </div>


                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Distrito</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Distrito_ModalReclamo" disabled>
                                </div>

                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label>Dirección</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Direccion_ModalReclamo" disabled>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                <label>Estado</label>
                                <div class="form-group">
                                    <select class="form-control show-tick" id="Estado_ModalReclamo" name="Estado">
                                        <option value="1">Pendiente</option>
                                        <option value="2">Atendido</option>
                                        <option value="3">Cerrado</option>
                                    </select>
                                </div>

                            </div>
                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label>Bien Contratado</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="BienContratado_ModalReclamo" disabled>
                                </div>

                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label>Monto Reclamado</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="MontoReclamado_ModalReclamo" disabled>
                                </div>

                            </div>

                        </div>
                        <div class="row clearfix">

                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <label>Descripción</label>
                                <div class="form-group">
                                    <textarea id="Descripcion_ModalReclamo" class="form-control" disabled></textarea>
                                </div>

                            </div>


                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label>Tipo</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Tipo_ModalReclamo" disabled>
                                </div>

                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label>Zonal</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Zonal_ModalReclamo" disabled>
                                </div>

                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4">
                                <label>Sede</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Sede_ModalReclamo" disabled>
                                </div>

                            </div>
                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <label>Detalle</label>
                                <div class="form-group">
                                    <textarea id="Detalle_ModalReclamo" class="form-control" disabled></textarea>
                                </div>

                            </div>


                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <label>Pedido</label>
                                <div class="form-group">
                                    <textarea id="Pedido_ModalReclamo" class="form-control" disabled></textarea>
                                </div>

                            </div>


                        </div>

                        <div class="row clearfix">

                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label>Fecha Registro</label>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="FechaRegistro_ModalReclamo" disabled>
                                </div>

                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label>¿Procede?</label>
                                <div class="form-group">
                                    <select class="form-control show-tick" id="Procede_ModalReclamo" name="Procede">
                                        <option value="true">Sí</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>

                            </div>

                        </div>

                        

                        <div class="row clearfix">

                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <label>Respuesta</label>
                                <div class="form-group">
                                    <textarea id="Respuesta_ModalReclamo" class="form-control" name="Respuesta"></textarea>
                                </div>

                            </div>


                        </div>
                    </form>
                </div>
                <div class="modal-footer">

                    <button type="button" class="btn btn-default" id="btnGenerarCorreo">Enviar Correo</button>

                    <button type="button" class="btn btn-primary" id="btnActualizarRespuesta">Actualizar</button>

                    <button type="button" class="btn btn-danger btn-simple btn-round waves-effect" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>


}

<link href="~/Content/assets/plugins/bootstrap-select/css/bootstrap-select.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/assets/plugins/select2/select2.css" />
<link rel="stylesheet" href="~/Content/assets/plugins/jquery-datatable/dataTables.bootstrap4.min.css">


