@{
    ViewBag.Title = "Consumo Adicionales Manuales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string sid = ViewBag.SessionID as string ?? "";
}

<style>
    /* VARIABLES GLOBALES Y SIDEBAR (Gold Standard) */
    :root {
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    body .container.main-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }
    .insumo-module-layout { display: flex; background-color: var(--color-background-body); min-height: 100vh; }
    
    .insumo-sidebar { width: 260px; background-color: var(--hialpesa-dark); color: white; flex-shrink: 0; display: flex; flex-direction: column; padding-top: 35px; box-shadow: 4px 0 10px rgba(0,0,0,0.1); z-index: 10; }
    .sidebar-header { padding: 0 24px 24px 24px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; text-align: center; }
    .sidebar-header h3 { margin: 0; font-size: 18px; font-weight: 700; color: white; letter-spacing: 1px; text-transform: uppercase; line-height: 1.2; }
    .sidebar-header span { font-size: 11px; color: var(--hialpesa-accent); font-weight: 600; display: block; margin-top: 4px; }
    .sidebar-nav { list-style: none; padding: 0; margin: 0; }
    .sidebar-nav li { margin: 4px 12px; border-bottom: none !important; }
    .sidebar-nav a { display: flex; align-items: center; padding: 12px 16px; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 14px; font-weight: 500; transition: all 0.2s; border-radius: 8px; }
    .sidebar-nav a i { margin-right: 12px; width: 20px; text-align: center; font-size: 16px; opacity: 0.8; }
    .sidebar-nav a:hover, .sidebar-nav li.active a { background-color: rgba(255, 255, 255, 0.1); color: white; }
    .sidebar-nav li.active a { font-weight: 600; border-left: 4px solid var(--hialpesa-accent); padding-left: 20px; }

    /* CONTENEDOR PRINCIPAL */
    .insumo-container { flex: 1; padding: 30px 40px; overflow-y: auto; }
    .content-box { background: white; border: 1px solid var(--color-border); border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 20px; }

    /* FILTROS TIPO VB6 */
    .filter-panel { display: flex; gap: 30px; align-items: center; background: #f1f5f9; padding: 15px 20px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 20px; }
    .radio-group { display: flex; flex-direction: column; gap: 8px; border-right: 1px solid #cbd5e1; padding-right: 20px; }
    .radio-item { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #334155; cursor: pointer; }
    .filter-inputs { display: flex; gap: 15px; align-items: center; flex: 1; }
    .filter-inputs input { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; outline: none; }
    
    .btn-primary-hialpesa { background: var(--hialpesa-dark); color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .btn-success-hialpesa { background: #10b981; color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    
    /* TABLA */
    table.dataTable { width: 100% !important; border-collapse: collapse; font-size: 13px; }
    table.dataTable thead th { background: #e2e8f0; color: #475569; padding: 12px; border-bottom: 2px solid #cbd5e1; }
    table.dataTable tbody td { padding: 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    
    /* MODALES */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.6); z-index: 1050; align-items: center; justify-content: center; }
    .modal-content-box { background: white; border-radius: 8px; padding: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); width: 800px; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; }
    .modal-title { margin: 0; font-size: 18px; color: var(--hialpesa-dark); font-weight: 700; }
    .close-btn { cursor: pointer; font-size: 20px; color: #64748b; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 13px; color: #64748b; margin-bottom: 4px; font-weight: 600; }
    .form-control { width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; }
</style>

<div class="insumo-module-layout">
    <!-- SIDEBAR -->
    <div class="insumo-sidebar">
        <div class="sidebar-header">
            <h3>Insumos</h3>
            <span>Almacén de Estampado</span>
        </div>
        <ul class="sidebar-nav">
            <li><a href="@Url.Action("Index", "InsumoEstampado", new { sid = sid })"><i class="fas fa-layer-group"></i> Agrupación de NPs</a></li>
            <li><a href="@Url.Action("AjustarCantidades", "InsumoEstampado", new { sid = sid })"><i class="fas fa-box"></i> Lista de Insumos</a></li>
            <li><a href="@Url.Action("Index", "Proveedor")"><i class="fas fa-truck"></i> Proveedores</a></li>
            <li><a href="@Url.Action("GenerarSolicitud", "InsumoEstampado", new { sid = sid })"><i class="fas fa-check-double"></i> Generar Solicitud</a></li>
            <li><a href="@Url.Action("Voucher", "InsumoEstampado")"><i class="fas fa-receipt"></i> Voucher</a></li>
            <li><a href="@Url.Action("Mantenimiento", "InsumoEstampado")"><i class="fas fa-bars"></i> Mant. Solicitudes</a></li>
            <li class="active"><a href="#"><i class="fas fa-plus-circle"></i> Consumos Adicionales</a></li>
        </ul>
    </div>

    <!-- MAIN AREA -->
    <div class="insumo-container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="font-size: 22px; font-weight: 700; color: var(--hialpesa-dark); margin: 0;">Consumo Adicionales Manuales</h2>
            <button class="btn-success-hialpesa" onclick="abrirModalCabecera()"><i class="fas fa-plus"></i> Nuevo Requerimiento</button>
        </div>

        <div class="content-box">
            <!-- FILTROS -->
            <div class="filter-panel">
                <div class="radio-group">
                    <label class="radio-item"><input type="radio" name="optFiltro" value="2" checked> Fecha</label>
                    <label class="radio-item"><input type="radio" name="optFiltro" value="1"> Partidas (NP)</label>
                </div>
                <div class="filter-inputs">
                    <div>
                        <label style="font-size:12px; color:#64748b;">Desde / Valor 1</label><br/>
                        <input type="date" id="txtFiltro1" class="form-control" style="width: 150px;">
                    </div>
                    <div>
                        <label style="font-size:12px; color:#64748b;">Hasta / Valor 2</label><br/>
                        <input type="date" id="txtFiltro2" class="form-control" style="width: 150px;">
                    </div>
                    <div style="align-self: flex-end;">
                        <button class="btn-primary-hialpesa" onclick="cargarGrilla()"><i class="fas fa-search"></i> Buscar</button>
                    </div>
                </div>
            </div>

            <!-- GRILLA -->
            <table id="tbConsumos" class="dataTable">
                <thead>
                    <tr>
                        <th>Req.</th>
                        <th>Fec. Creación</th>
                        <th>Fec. Impresión</th>
                        <th>Partida (NP)</th>
                        <th>Motivo</th>
                        <th>Nombre Insumo/Maq</th>
                        <th>Unid</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: ADICIONAR CABECERA (AUTOMATIZADO) -->
<div id="modalCabecera" class="modal-overlay">
    <div class="modal-content-box" style="width: 500px; padding:0;">
        <div class="modal-header" style="background:var(--hialpesa-dark); color:white; border-radius: 8px 8px 0 0;">
            <h3 class="modal-title" style="color:white;">Adicionar Cabecera</h3>
            <span class="close-btn" onclick="$('#modalCabecera').hide()" style="color:white;">&times;</span>
        </div>
        
        <div class="form-body" style="padding: 24px;">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div class="form-group">
                    <label style="font-weight:600; font-size:13px;">Fecha Creacion</label>
                    <input type="text" class="form-control" value="@DateTime.Now.ToString("d /MM /yyyy")" readonly style="background:#f8fafc; font-size:13px;">
                </div>
                <div class="form-group">
                    <label style="font-weight:600; font-size:13px;">Fábrica</label>
                    <input type="text" class="form-control" value="001" readonly style="background:#f8fafc; font-size:13px;">
                </div>
            </div>
            
            <div class="form-group" style="margin-top:15px;">
                <label style="font-weight:600; font-size:13px;">Motivo</label>
                <input type="text" class="form-control" value="30 Req.Estampados-NP" readonly style="background:#f8fafc; font-size:13px;">
            </div>

            <div class="form-group" style="display:flex; gap: 10px; align-items: flex-end; margin-top:15px;">
                <div style="flex:1;">
                    <label style="font-weight:600; font-size:13px;">Op (Partida)</label>
                    <input type="text" id="txtBusquedaNP" class="form-control" placeholder="Ej. I7384" style="height:38px;">
                </div>
                <button class="btn-primary-hialpesa" onclick="validarNP()" style="height:38px; border-radius:6px;"><i class="fas fa-check"></i> Validar</button>
            </div>
            
            <div id="pnlCabeceraDetalle" style="display:none; margin-top:20px; padding-top:15px; border-top: 1px dashed #cbd5e1;">
                 <div class="form-group" style="margin-bottom:15px;">
                    <label style="font-weight:600; font-size:13px;">NP Validada</label>
                    <input type="text" id="txtNPValidada" class="form-control" readonly style="background:#f1f5f9; font-weight:700; color:var(--hialpesa-dark);">
                </div>

                <div class="form-group">
                    <label style="font-weight:600; font-size:13px;">Observaciones</label>
                    <textarea id="txtObservaciones" class="form-control" rows="3" placeholder="Escriba las observaciones aquí..."></textarea>
                </div>
                
                <div style="display:flex; justify-content:center; gap:15px; margin-top:30px;">
                    <button class="btn-success-hialpesa" onclick="procesarRequerimientoCompleto()" style="min-width:140px; border-radius:6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <i class="fas fa-plus"></i> Adicionar
                    </button>
                    <button class="btn-hialpesa" onclick="$('#modalCabecera').hide()" style="background:#e2e8f0; color:#475569; min-width:140px; border-radius:6px;">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: DETALLES (INSUMOS) -->
<div id="modalDetalle" class="modal-overlay">
    <div class="modal-content-box" style="width: 800px; padding:0;">
        <div class="modal-header" style="background:var(--hialpesa-dark); color:white; border-radius: 8px 8px 0 0;">
            <h3 class="modal-title" style="color:white;">Ingreso de Químicos y Colorantes</h3>
            <span class="close-btn" onclick="$('#modalDetalle').hide()" style="color:white;">&times;</span>
        </div>
        
        <div class="form-body" style="padding: 24px; display:flex; gap:24px;">
            <!-- Formulario de Ingreso -->
            <div style="flex:1; border-right: 1px dashed #cbd5e1; padding-right: 24px;">
                <input type="hidden" id="hdnNumReq" />
                <input type="hidden" id="hdnNPDetalle" />
                <div class="form-group" style="margin-bottom:12px;">
                    <label style="font-weight:600; font-size:13px;">Requerimiento Nro:</label>
                    <input type="text" id="txtReqDisplay" class="form-control" readonly style="background:#f1f5f9; font-weight:700; font-size:16px; color:var(--hialpesa-dark);">
                </div>
                <div class="form-group" style="margin-bottom:12px;">
                    <label style="font-weight:600; font-size:13px;">Item (Insumo)</label>
                    <select id="cboItem" class="form-control"></select>
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:15px;">
                    <div class="form-group">
                        <label style="font-weight:600; font-size:13px;">Lote</label>
                        <input type="text" id="txtLote" class="form-control" value="0">
                    </div>
                    <div class="form-group">
                        <label style="font-weight:600; font-size:13px;">Cantidad</label>
                        <input type="number" id="txtCantidad" class="form-control" step="0.001">
                    </div>
                </div>
                <button class="btn-primary-hialpesa" style="width:100%; justify-content:center; height:40px; border-radius:6px;" onclick="agregarDetalle()">
                    <i class="fas fa-plus-circle" style="margin-right:8px;"></i> Adicionar Item
                </button>
            </div>
            
            <!-- Resumen de items agregados -->
            <div style="flex:1.2;">
                <label style="font-size:13px; font-weight:700; color:#334155; margin-bottom:8px; display:block;">Insumos Registrados</label>
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; height: 320px; padding:12px; overflow-y:auto; font-size:12px;">
                    <ul id="ulItemsAgregados" style="padding-left:18px; margin:0; list-style-type: decimal;"></ul>
                    <div id="pnlCargandoDetalle" style="display:none; text-align:center; padding-top:100px; color:#64748b;">
                        <i class="fas fa-spinner fa-spin fa-2x"></i><br><br>Cargando detalles...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var dtConsumos;

        $(document).ready(function() {
            var hoy = new Date();
            
            // Format YYYY-MM-DD for input type="date"
            var strHoy = hoy.toISOString().split('T')[0];
            $('#txtFiltro1').val(strHoy);
            $('#txtFiltro2').val(strHoy);

            // Cambiar tipo de input según radio
            $('input[name=optFiltro]').change(function() {
                var val = $(this).val();
                if(val == '2') {
                    $('#txtFiltro1').attr('type', 'date');
                    $('#txtFiltro1').val(strHoy);
                    $('#txtFiltro2').show();
                } else if(val == '1') {
                    $('#txtFiltro1').attr('type', 'text').val('');
                    $('#txtFiltro1').attr('placeholder', 'Ingrese Nro NP');
                    $('#txtFiltro2').hide();
                }
            });

            dtConsumos = $('#tbConsumos').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                order: [[0, 'desc']],
                columnDefs: [
                    { targets: 0, width: '80px' },
                    { targets: [1,2], width: '100px' }
                ]
            });

            // Autocompletado de Insumos (Select2)
            $('#cboItem').select2({
                placeholder: 'Seleccione un insumo...',
                minimumInputLength: 3,
                dropdownParent: $('#modalDetalle'),
                ajax: {
                    url: '@Url.Action("BuscarInsumosSelect2", "Home")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term }; },
                    processResults: function (data) {
                        return { results: data.items || data };
                    }
                }
            });

            cargarGrilla();
        });

        function cargarGrilla() {
            var opt = $('input[name=optFiltro]:checked').val();
            var f1 = $('#txtFiltro1').val();
            var f2 = $('#txtFiltro2').val();
            
            var reqData = {
                opcion: opt,
                desde: opt == '2' ? f1 : '',
                hasta: opt == '2' ? f2 : '',
                np: opt == '1' ? f1 : ''
            };

            Swal.fire({ title: 'Cargando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.post('@Url.Action("Listar", "ConsumoAdicional")', reqData, function(res) {
                Swal.close();
                dtConsumos.clear();
                if(res.success && res.data) {
                    res.data.forEach(function(item) {
                        var btns = `<button class="btn-primary-hialpesa" style="padding:4px 8px; font-size:11px;" onclick="abrirModalDetalle(${item.NumRequerimiento}, '${item.Partida}')" title="Agregar Insumos"><i class="fas fa-plus"></i> Insumos</button>`;
                        
                        dtConsumos.row.add([
                            item.NumRequerimiento,
                            item.FecCreacion,
                            item.UltimaImpresion,
                            item.Partida,
                            item.Motivo,
                            item.Nombre,
                            item.Unidad,
                            `<div style="text-align:center;">${btns}</div>`
                        ]);
                    });
                    dtConsumos.draw();
                } else {
                    Swal.fire('Error', res.message || 'Error al cargar', 'error');
                }
            });
        }

        function abrirModalCabecera() {
            $('#txtBusquedaNP').val('');
            $('#pnlCabeceraDetalle').hide();
            $('#txtMotivo').val('Requerimiento Normal Hidro');
            $('#txtMaquina').val('');
            $('#txtObservaciones').val('');
            $('#modalCabecera').css('display', 'flex');
        }

        function validarNP() {
            var np = $('#txtBusquedaNP').val();
            if(!np) { Swal.fire('Aviso','Ingrese NP','warning'); return; }

            $.post('@Url.Action("ValidarNP", "ConsumoAdicional")', { np: np }, function(res) {
                if(res.success) {
                    $('#txtNPValidada').val(res.data);
                    $('#pnlCabeceraDetalle').show();
                    Swal.fire({icon:'success', title:'NP Validada', toast:true, position:'top-end', showConfirmButton:false, timer:1500});
                } else {
                    $('#pnlCabeceraDetalle').hide();
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }

        function procesarRequerimientoCompleto() {
            var np = $('#txtNPValidada').val();
            var obs = $('#txtObservaciones').val();

            if(!np) return Swal.fire('Error', 'NP no validada', 'warning');

            Swal.fire({
                title: 'Generando Requerimiento',
                text: 'Cargando cabecera e insumos de receta automáticos...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.post('@Url.Action("GenerarRequerimientoCompleto", "ConsumoAdicional")', { np: np, observaciones: obs }, function(res) {
                if(res.success) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: res.message,
                        icon: 'success',
                        confirmButtonColor: '#23693e'
                    }).then(() => {
                        $('#modalCabecera').hide();
                        cargarGrilla();
                    });
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }

        function abrirModalDetalle(numReq, np) {
            $('#hdnNumReq').val(numReq);
            $('#hdnNPDetalle').val(np);
            $('#txtReqDisplay').val(numReq);
            $('#cboItem').val(null).trigger('change');
            $('#txtLote').val('0');
            $('#txtCantidad').val('');
            $('#ulItemsAgregados').empty();
            $('#modalDetalle').fadeIn();
            
            // Cargar items ya registrados
            $('#pnlCargandoDetalle').show();
            $.post('@Url.Action("ListarDetalle", "ConsumoAdicional")', { numReq: numReq }, function(res) {
                $('#pnlCargandoDetalle').hide();
                if(res.success && res.data) {
                    res.data.forEach(function(item) {
                        if(item.CodItem) {
                            $('#ulItemsAgregados').append(`<li><b style="color:var(--hialpesa-dark);">${item.CodItem}</b> - ${item.Nombre} | Cant: <b>${item.ConsumoRequerido}</b> | Lote: ${item.Lote}</li>`);
                        }
                    });
                }
            });
        }

        function agregarDetalle() {
            var numReq = $('#hdnNumReq').val();
            var np = $('#hdnNPDetalle').val();
            var itemSel = $('#cboItem').val(); 
            var lote = $('#txtLote').val();
            var cant = $('#txtCantidad').val();

            if(!itemSel) return Swal.fire('Aviso', 'Seleccione un insumo', 'warning');
            if(!cant || cant <= 0) return Swal.fire('Aviso', 'Ingrese una cantidad válida', 'warning');

            // Select2 devuelve el texto completo, extraemos el código (primeras palabras hasta el primer espacio)
            var codPuro = itemSel.split(' ')[0];
            var nomPuro = $('#cboItem').text().trim().substring(codPuro.length).trim();

            var det = {
                numReq: numReq,
                codItem: codPuro,
                consumo: cant,
                lote: lote
            };

            Swal.showLoading();
            $.post('@Url.Action("GuardarDetalleManual", "ConsumoAdicional")', det, function(res) {
                Swal.close();
                if(res.success) {
                    $('#ulItemsAgregados').append(`<li style="background:#ecfdf5;"><b style="color:#065f46;">${codPuro}</b> - ${nomPuro} | Cant: <b>${cant}</b> | Lote: ${lote} <span class="badge" style="background:#10b981; color:white; font-size:9px; margin-left:5px;">NUEVO</span></li>`);
                    $('#cboItem').val(null).trigger('change');
                    $('#txtCantidad').val('');
                    cargarGrilla(); // Actualizar grilla de fondo
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }
    </script>
}
