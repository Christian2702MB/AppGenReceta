@model AppGenReceta.BE.E_SolicitudResumen
@{
    ViewBag.Title = "Voucher de Requerimiento de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string numReq = ViewBag.NumRequerimiento as string ?? "---";
    var sid = ViewBag.SessionID as string ?? "";
    var detalleERP = ViewBag.DetalleERP as List<AppGenReceta.BE.E_VoucherDetalle> ?? new List<AppGenReceta.BE.E_VoucherDetalle>();
    string firma1 = ViewBag.Firma1 as string ?? "";
    string firma2 = ViewBag.Firma2 as string ?? "";
    string firma3 = ViewBag.Firma3 as string ?? "";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    body {
        background-color: var(--color-background-body);
        font-family: 'Inter', sans-serif;
    }

    /* Full width override */
    body .container.main-container {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .insumo-module-layout {
        display: flex;
        min-height: 100vh;
    }

    .insumo-sidebar {
        width: 260px;
        background-color: var(--hialpesa-dark);
        color: white;
        flex-shrink: 0;
    }

    .insumo-container {
        flex: 1;
        padding: 30px 40px;
    }

    /* VOUCHER STYLES */
    .voucher-card {
        background: white;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 40px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        max-width: 1000px;
        margin: 0 auto;
    }

    .voucher-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 2px dashed #e2e8f0;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .voucher-title h1 {
        font-size: 20px;
        color: var(--hialpesa-dark);
        margin: 0;
    }

    .voucher-title span {
        font-size: 13px;
        color: #64748b;
    }

    .voucher-meta {
        text-align: right;
    }

    .req-number {
        font-size: 18px;
        font-weight: 700;
        color: var(--hialpesa-dark);
    }

    .req-date {
        font-size: 13px;
        color: #64748b;
        display: block;
    }

    .status-badge {
        display: inline-block;
        background: #e0f2fe;
        color: #0369a1;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        margin-top: 8px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 40px;
    }

    .info-item label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .info-item p {
        font-size: 14px;
        color: #1e293b;
        font-weight: 500;
        margin: 0;
    }

    .voucher-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

    .voucher-table th {
        background: #f8fafc;
        padding: 12px;
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        text-align: left;
        border-bottom: 2px solid #e2e8f0;
    }

    .voucher-table td {
        padding: 15px 12px;
        font-size: 13px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .text-center { text-align: center !important; }
    .text-right { text-align: right !important; }

    .total-row td {
        font-weight: 700;
        font-size: 15px;
        color: var(--hialpesa-dark);
        border-bottom: none;
        padding-top: 25px;
    }

    .signatures {
        display: flex;
        justify-content: space-around;
        margin-top: 80px;
        padding-top: 20px;
    }

    .sig-box {
        width: 200px;
        border-top: 1px solid #cbd5e1;
        text-align: center;
        padding-top: 10px;
        font-size: 12px;
        color: #64748b;
    }

    .actions-bar {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 20px;
        max-width: 1000px;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-print:hover { background: #1e293b; transform: translateY(-1px); }

    /* SIDEBAR STYLES (Standard) */
    .sidebar-header { padding: 0 24px 24px 24px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; text-align: center; }
    .sidebar-header h3 { margin: 0; font-size: 18px; font-weight: 700; color: white; letter-spacing: 1px; text-transform: uppercase; }
    .sidebar-header span { font-size: 11px; color: #f39c12; font-weight: 600; display: block; margin-top: 4px; }
    .sidebar-nav { list-style: none; padding: 0; margin: 0; }
    .sidebar-nav li { margin: 4px 12px; }
    .sidebar-nav a { display: flex; align-items: center; padding: 12px 16px; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 14px; font-weight: 500; transition: all 0.2s; border-radius: 8px; }
    .sidebar-nav a i { margin-right: 12px; width: 20px; text-align: center; font-size: 16px; opacity: 0.8; }
    .sidebar-nav a:hover, .sidebar-nav li.active a { background-color: rgba(255, 255, 255, 0.1); color: white; }
    .sidebar-nav li.active a { font-weight: 600; border-left: 4px solid var(--hialpesa-accent); padding-left: 20px; }

    .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
    .top-header h2 { font-size: 20px; font-weight: 600; color: var(--hialpesa-dark); margin: 0; }
    .btn-outline { background: white; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px; cursor: pointer; }

    @@media print {
        .insumo-sidebar, .actions-bar, .top-header, .steps-bar, .top-actions { display: none !important; }
        .insumo-container { padding: 0; margin: 0; width: 100%; }
        .voucher-card { box-shadow: none; border: none; width: 100%; max-width: 100%; padding: 0; }
        .insumo-module-layout { display: block; }
        .preview-section { display: none !important; }
    }

    /* PREVIEW EXCEL ESTILO */
    .preview-section { margin-top: 40px; padding-top: 20px; border-top: 2px dashed #cbd5e1; }
    .preview-title { font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .btn-excel { background: #16a34a; color: white; padding: 10px 20px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; border: none; cursor: pointer; }
    .btn-excel:hover { background: #15803d; color: white; transform: translateY(-1px); }
    .preview-box { border: 1px solid #cbd5e1; border-radius: 8px; padding: 25px; background: white; margin-bottom: 30px; }
    .pv-header { border: 2px solid #64748b; margin-bottom: 20px; padding: 10px; text-align: center; font-weight: bold; font-size: 16px; letter-spacing: 1px; }
    .pv-info-grid { display: grid; grid-template-columns: 1fr 200px; gap: 15px; margin-bottom: 20px; font-size: 12px; }
    .pv-info-row { display: flex; gap: 15px; margin-bottom: 6px; }
    .pv-info-label { font-weight: 700; width: 100px; }
    .pv-table { width: 100%; border-collapse: collapse; font-size: 11px; }
    .pv-table th, .pv-table td { border: 1px solid #cbd5e1; padding: 8px; }
    .pv-table th { background: #e2e8f0; font-weight: 700; text-align: center; }
    .pv-table td.num { text-align: right; }
    .pv-prices { font-size: 9px; font-style: italic; color: #64748b; display: block; margin-top: 4px; }
    .pv-signatures { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 60px; text-align: center; font-size: 11px; font-weight: 600; color: #334155; }
    .pv-sig-box { border-top: 1px solid #000; padding-top: 5px; }
    .pv-sig-space { height: 60px; background: #f2f2f2; border: 1px solid #cbd5e1; border-bottom: none; }
</style>

<div class="insumo-module-layout">
    <!-- SIDEBAR -->
    <div class="insumo-sidebar">
        <div class="sidebar-header">
            <h3>Insumos</h3>
            <span>Almacén de Estampado</span>
        </div>
        <ul class="sidebar-nav">
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-layer-group"></i> Agrupación de NPs</a></li>
            <li><a href="#"><i class="fas fa-box"></i> Lista de Insumos</a></li>
            <li><a href="@Url.Action("Index", "Proveedor")"><i class="fas fa-truck"></i> Proveedores</a></li>
            <li><a href="@Url.Action("GenerarSolicitud", "InsumoEstampado", new { sid = sid })"><i class="fas fa-check-double"></i> Generar Solicitud</a></li>
            <li class="active"><a href="#"><i class="fas fa-file-invoice"></i> Voucher</a></li>
            <li><a href="@Url.Action("Mantenimiento", "InsumoEstampado")"><i class="fas fa-bars"></i> Mant. Solicitudes</a></li>
        </ul>
    </div>

    <div class="insumo-container">
        <div class="top-header">
            <h2>Voucher de Requerimiento de Compra</h2>
            <div class="top-actions">
                <button class="btn-outline">Familia: ES</button>
                <button class="btn-outline">Ayuda <i class="fas fa-external-link-alt"></i></button>
            </div>
        </div>

        <div class="actions-bar">
            <button class="btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> Imprimir voucher
            </button>
        </div>

        <div class="voucher-card">
            <div class="voucher-header">
                <div class="voucher-title">
                    <h1>Solicitud de Requerimiento de Compra</h1>
                    <span>Almacén de Estampado — Módulo Insumos</span>
                </div>
                <div class="voucher-meta">
                    <span class="req-number"># REQ-@DateTime.Now.Year-@numReq</span>
                    <span class="req-date">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                    <span class="status-badge">GENERADO</span>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <label>Motivo</label>
                    <p>@Model.Motivo</p>
                </div>
                <div class="info-item">
                    <label>Observación</label>
                    <p>@(string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observaciones" : Model.Observacion)</p>
                </div>
                <div class="info-item">
                    <label>Responsable</label>
                    <p>ILLANES MENDOZA MANUEL (E2081)</p>
                </div>
                <div class="info-item">
                    <label>NPs Incluidas</label>
                    <p>@(Model.NPsIncluidas != null ? string.Join(", ", Model.NPsIncluidas) : "—")</p>
                </div>
            </div>

            <table class="voucher-table">
                <thead>
                    <tr>
                        <th width="40">#</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th class="text-center">Cant.</th>
                        <th>Unidad</th>
                        <th class="text-right">P. Unit.</th>
                        <th class="text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int i = 1;
                        foreach (var item in Model.Items)
                        {
                            var total = item.CantidadAPedir * item.PrecioUnitario;
                            <tr>
                                <td>@i</td>
                                <td style="font-weight:600">@item.CodigoInsumo</td>
                                <td>@item.Descripcion</td>
                                <td class="text-center" style="font-weight:700">@((int)item.CantidadAPedir)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Presentacion) ? "UNIDAD" : item.Presentacion)</td>
                                <td class="text-right">S/ @item.PrecioUnitario.ToString("N2")</td>
                                <td class="text-right" style="font-weight:600">S/ @total.ToString("N2")</td>
                            </tr>
                            i++;
                        }
                        <tr class="total-row">
                            <td colspan="6" class="text-right">Total Estimado:</td>
                            <td class="text-right">S/ @Model.CostoEstimado.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="signatures">
                <div class="sig-box">Solicitado por</div>
                <div class="sig-box">Aprobado por Logística</div>
            </div>
        </div>

        <!-- SECCION PREVIEW EXCEL -->
        <div class="preview-section">
            <div class="preview-title">
                <span><i class="fas fa-file-excel" style="color:#16a34a; margin-right:8px;"></i> Reporte Detallado de Compra</span>
                <a href="@Url.Action("ExportarVoucherExcel", "InsumoEstampado", new { num = numReq })" class="btn-excel" target="_blank">
                    <i class="fas fa-download"></i> Exportar a Excel
                </a>
            </div>

            <div class="preview-box">
                <div class="pv-header">
                    REQUERIMIENTO DE COMPRA NRO:@numReq
                </div>
                
                @{
                    string cabArea = detalleERP.Count > 0 ? detalleERP[0].NomArea : "Confecciones";
                    string cabMotivo = detalleERP.Count > 0 ? detalleERP[0].DesMotivo : "COMPRA";
                    string cabSolicitante = detalleERP.Count > 0 ? detalleERP[0].Trabajador + " " + detalleERP[0].NomTrabajador : "";
                    string cabObs = detalleERP.Count > 0 ? detalleERP[0].Observacion : "";
                    string cabFecha = detalleERP.Count > 0 ? detalleERP[0].Fecha : DateTime.Now.ToString("dd/MM/yyyy");
                }

                <div class="pv-info-grid">
                    <div>
                        <div class="pv-info-row"><span class="pv-info-label">AREA:</span><span>@cabArea</span></div>
                        <div class="pv-info-row"><span class="pv-info-label">MOTIVO:</span><span>@cabMotivo</span></div>
                        <div class="pv-info-row"><span class="pv-info-label">SOLICITANTE:</span><span>@cabSolicitante</span></div>
                        <div class="pv-info-row"><span class="pv-info-label">OBSERVACION:</span><span>@cabObs</span></div>
                    </div>
                    <div>
                        <div class="pv-info-row" style="justify-content:flex-end"><span class="pv-info-label">FECHA:</span><span>@cabFecha</span></div>
                    </div>
                </div>

                <table class="pv-table">
                    <thead>
                        <tr>
                            <th width="80">SECUENCIA</th>
                            <th width="120">CODIGO REPUESTO</th>
                            <th>DESCRIPCION ITEM</th>
                            <th width="120">CODIGO FABRICACION</th>
                            <th width="80">CANTIDAD</th>
                            <th width="100">UNIDAD MEDIDA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var det in detalleERP)
                        {
                            <tr>
                                <td class="num">@det.Secuencia</td>
                                <td>@(string.IsNullOrEmpty(det.CodRepuesto) ? det.CodItem : det.CodRepuesto)</td>
                                <td>
                                    @det.DesItem
                                    @if (!string.IsNullOrEmpty(det.UltimosPrecios))
                                    {
                                        <span class="pv-prices">Ultimos Precios : @det.UltimosPrecios</span>
                                    }
                                </td>
                                <td>@det.CodFabricacion</td>
                                <td class="num">@det.Cantidad</td>
                                <td class="text-center">@det.DesUniMed</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pv-signatures">
                    <div>
                        <div class="pv-sig-space"></div>
                        <div class="pv-sig-box" style="text-align: left; font-weight: normal; border-top: none;">
                            Elaborado por @(detalleERP.Count > 0 ? detalleERP[0].Trabajador : "")
                        </div>
                    </div>
                    <div>
                        <div class="pv-sig-space"></div>
                        <div class="pv-sig-box">Sr. @firma1</div>
                    </div>
                    <div>
                        <div class="pv-sig-space"></div>
                        <div class="pv-sig-box">Ing. @firma2</div>
                    </div>
                    <div>
                        <div class="pv-sig-space"></div>
                        <div class="pv-sig-box">Ing. @firma3</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (ViewBag.AutoPrint == true)
    {
        <script>
            $(document).ready(function () {
                // Ocultar elementos que no son el reporte para una vista limpia de impresión
                $(".insumo-sidebar, .top-header, .no-print, header, footer, .navbar-hialpesa").hide();
                $(".insumo-container").css({ "padding": "0", "margin": "0", "background": "white" });
                $(".voucher-card").css({ "box-shadow": "none", "border": "none", "max-width": "100%", "padding": "20px" });
                
                // Disparar diálogo de impresión
                setTimeout(function() {
                    window.print();
                }, 500);
            });
        </script>
    }
}
