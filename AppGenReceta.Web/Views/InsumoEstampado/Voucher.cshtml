@model AppGenReceta.BE.E_SolicitudResumen
@{
    ViewBag.Title = "Voucher de Requerimiento de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string numReq = ViewBag.NumRequerimiento as string ?? "---";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    body {
        background-color: var(--color-background-body);
        font-family: 'Inter', sans-serif;
    }

    /* Full width override */
    body .container.main-container {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .insumo-module-layout {
        display: flex;
        min-height: 100vh;
    }

    .insumo-sidebar {
        width: 260px;
        background-color: var(--hialpesa-dark);
        color: white;
        flex-shrink: 0;
    }

    .insumo-container {
        flex: 1;
        padding: 30px 40px;
    }

    /* VOUCHER STYLES */
    .voucher-card {
        background: white;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 40px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        max-width: 1000px;
        margin: 0 auto;
    }

    .voucher-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 2px dashed #e2e8f0;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .voucher-title h1 {
        font-size: 20px;
        color: var(--hialpesa-dark);
        margin: 0;
    }

    .voucher-title span {
        font-size: 13px;
        color: #64748b;
    }

    .voucher-meta {
        text-align: right;
    }

    .req-number {
        font-size: 18px;
        font-weight: 700;
        color: var(--hialpesa-dark);
    }

    .req-date {
        font-size: 13px;
        color: #64748b;
        display: block;
    }

    .status-badge {
        display: inline-block;
        background: #e0f2fe;
        color: #0369a1;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        margin-top: 8px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 40px;
    }

    .info-item label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .info-item p {
        font-size: 14px;
        color: #1e293b;
        font-weight: 500;
        margin: 0;
    }

    .voucher-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

    .voucher-table th {
        background: #f8fafc;
        padding: 12px;
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        text-align: left;
        border-bottom: 2px solid #e2e8f0;
    }

    .voucher-table td {
        padding: 15px 12px;
        font-size: 13px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }

    .text-center { text-align: center !important; }
    .text-right { text-align: right !important; }

    .total-row td {
        font-weight: 700;
        font-size: 15px;
        color: var(--hialpesa-dark);
        border-bottom: none;
        padding-top: 25px;
    }

    .signatures {
        display: flex;
        justify-content: space-around;
        margin-top: 80px;
        padding-top: 20px;
    }

    .sig-box {
        width: 200px;
        border-top: 1px solid #cbd5e1;
        text-align: center;
        padding-top: 10px;
        font-size: 12px;
        color: #64748b;
    }

    .actions-bar {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 20px;
        max-width: 1000px;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-print {
        background: var(--hialpesa-dark);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @@media print {
        .insumo-sidebar, .actions-bar, .top-header, .steps-bar { display: none !important; }
        .insumo-container { padding: 0; }
        .voucher-card { box-shadow: none; border: none; width: 100%; max-width: 100%; }
    }
</style>

<div class="insumo-module-layout">
    <!-- SIDEBAR MOCKUP -->
    <div class="insumo-sidebar"></div>

    <div class="insumo-container">
        <div class="top-header">
            <h2>Voucher de Requerimiento de Compra</h2>
        </div>

        <div class="actions-bar">
            <button class="btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> Imprimir voucher
            </button>
        </div>

        <div class="voucher-card">
            <div class="voucher-header">
                <div class="voucher-title">
                    <h1>Solicitud de Requerimiento de Compra</h1>
                    <span>Almacén de Estampado — Módulo Insumos</span>
                </div>
                <div class="voucher-meta">
                    <span class="req-number"># REQ-@DateTime.Now.Year-@numReq</span>
                    <span class="req-date">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                    <span class="status-badge">GENERADO</span>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <label>Motivo</label>
                    <p>@Model.Motivo</p>
                </div>
                <div class="info-item">
                    <label>Observación</label>
                    <p>@(string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observaciones" : Model.Observacion)</p>
                </div>
                <div class="info-item">
                    <label>Responsable</label>
                    <p>ILLANES MENDOZA MANUEL (2081)</p>
                </div>
                <div class="info-item">
                    <label>NPs Incluidas</label>
                    <p>@(Model.NPsIncluidas != null ? string.Join(", ", Model.NPsIncluidas) : "—")</p>
                </div>
            </div>

            <table class="voucher-table">
                <thead>
                    <tr>
                        <th width="40">#</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th class="text-center">Cant.</th>
                        <th>Unidad</th>
                        <th class="text-right">P. Unit.</th>
                        <th class="text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int i = 1;
                        foreach (var item in Model.Items)
                        {
                            var total = item.CantidadAPedir * item.PrecioUnitario;
                            <tr>
                                <td>@i</td>
                                <td style="font-weight:600">@item.CodigoInsumo</td>
                                <td>@item.Descripcion</td>
                                <td class="text-center" style="font-weight:700">@((int)item.CantidadAPedir)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Presentacion) ? "UNIDAD" : item.Presentacion)</td>
                                <td class="text-right">S/ @item.PrecioUnitario.ToString("N2")</td>
                                <td class="text-right" style="font-weight:600">S/ @total.ToString("N2")</td>
                            </tr>
                            i++;
                        }
                        <tr class="total-row">
                            <td colspan="6" class="text-right">Total Estimado:</td>
                            <td class="text-right">S/ @Model.CostoEstimado.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="signatures">
                <div class="sig-box">Solicitado por</div>
                <div class="sig-box">Aprobado por Logística</div>
            </div>
        </div>
    </div>
</div>
