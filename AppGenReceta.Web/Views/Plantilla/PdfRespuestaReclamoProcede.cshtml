@model AppGenReceta.BE.LibroReclamoBE
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />



</head>
<body>
    <div class="panel-body">

        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top:0px; margin-bottom:5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left:10px; border-left:5px solid #07238a; color: #07238a;font-size:14px;">
                        SERVICIO NACIONAL DE ADIESTRAMIENTO EN TRABAJO INDUSTRIAL - SKINCARE &nbsp;&nbsp;&nbsp;
                        RUC 20131376503
                    </span>
                </h2>




                <div class="row">
                    <div class="col-xs-12 col-sm-12">

                        <span style="padding-left:10px; border-left:5px solid #07238a; color: #07238a;font-size:12px">
                            <b>Dirección del establecimiento:</b> <span id="lblFecha" style="padding-left:10px; color: #07238a;">@Model.Sede.Direccion</span>
                        </span>

                    </div>



                </div>

                <div class="row" style="margin-bottom:10px;">
                    <div class="col-xs-12 col-sm-6">

                        <span style="padding-left:10px; border-left:5px solid #07238a; color: #07238a;font-size:12px;">
                            <b>Fecha: </b><span id="lblFecha" style="padding-left:10px; color: #07238a;">@Model.FechaRegistroString</span>
                        </span>

                    </div>

                    <div class="col-xs-12 col-sm-6">

                        <span style="color: #07238a;font-size:12px;">
                            <b>Hoja de reclamación:</b> <span id="lblReclamacion" style="color: #07238a;">@Model.Codigo</span>
                        </span>

                    </div>

                </div>

            </div>
        </div>

        <form>



            <div class="panel panel-default">
                <div class="panel-body">
                    <h2 class="page-header" style="margin-top: 65px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                        <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;font-size:14px;">Identificación del Consumidor Reclamante</span>
                    </h2>
                    <div class="row" style="min-height:35px;">

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="Contacto" style="font-weight:bold">
                                    Contacto:
                                </label>
                                <div>
                                    @Model.Contacto.Nombre
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="Nombres" style="font-weight:bold">
                                    Nombres:
                                </label>
                                <div>
                                    @Model.Nombres
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="ApellidoPaterno" style="font-weight:bold">
                                    Apellido Paterno:
                                </label>
                                <div>
                                    @Model.ApellidoPaterno
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="ApellidoMaterno" style="font-weight:bold">
                                    Apellido Materno:
                                </label>
                                <div>
                                    @Model.ApellidoMaterno
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="min-height:35px;">

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="Documento" style="font-weight:bold">
                                    ID:
                                </label>
                                <div>
                                    @Model.IDAlumno
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="Documento" style="font-weight:bold">
                                    DNI / CE:
                                </label>
                                <div>
                                    @Model.Documento
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="TelefonoCelular" style="font-weight:bold">
                                    Celular o Teléfono Fijo:
                                </label>
                                <div>
                                    @Model.TelefonoCelular
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="Correo" style="font-weight:bold">
                                    Correo:
                                </label>
                                <div>
                                    @Model.Correo
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="CodigoDepartamento" style="font-weight:bold">
                                    Departamento:
                                </label>
                                <div>
                                    @Model.Ubigeo.Departamento
                                </div>


                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="CodigoProvincia" style="font-weight:bold">
                                    Provincia:
                                </label>
                                <div>
                                    @Model.Ubigeo.Provincia
                                </div>


                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                                <label for="IDUbigeo" style="font-weight:bold">
                                    Distrito:
                                </label>
                                <div>
                                    @Model.Ubigeo.Distrito
                                </div>

                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3">
                            <div class="form-group">
                          

                            </div>
                        </div>

                    </div>

                    <div class="row" style="min-height:35px;">

                        <div class="col-xs-12 col-sm-12">
                            <div class="form-group">
                                <label for="Direccion" style="font-weight:bold">
                                    Dirección:
                                </label>
                                <div>
                                    @Model.Direccion
                                </div>
                            </div>
                        </div>

                    </div>
                    @if (Model.Apoderado != null)
                    {
                        <div class="row" style="min-height:35px;">

                            <div class="col-xs-12 col-sm-12">
                                <div class="form-group">
                                    <label for="" style="font-weight:bold">
                                        Padre o Madre en caso de menor de edad:
                                    </label>
                                    <div>
                                        @Model.Apoderado
                                    </div>

                                </div>
                            </div>

                        </div>
                    }

                </div>
            </div>
            <div class="panel panel-default">
                <div class="panel-body">
                    <h2 class="page-header" style="margin-top:70px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                        <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;font-size:14px;">Identificación del Bien Contratado</span>
                    </h2>
                    <div class="row" style="min-height:35px;">


                        <div class="col-xs-6 col-sm-4">
                            <label style="font-weight:bold">Bien Contratado: </label>
                            <div>
                                @Model.BienContratado.Nombre
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <label style="font-weight:bold">Monto reclamado:</label>
                            <div>
                                @Model.MontoReclamado
                            </div>


                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <label style="font-weight:bold">Clasificación:</label>
                            <div>
                                @Model.Clasificacion.Nombre
                            </div>
                        </div>
                    </div>

                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-12">
                            <label style="font-weight:bold">Descripción:</label>
                            <div>
                                @Model.Descripcion
                            </div>


                        </div>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <h2 class="page-header" style="margin-top: 70px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                        <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;font-size:14px;">Zonal / Sede</span>
                    </h2>

                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-4">
                            <div class="form-group">
                                <label for="IDZonal" style="font-weight:bold">
                                    Zonal
                                </label>
                                <div>
                                    @Model.Sede.Zonal.Nombre
                                </div>



                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-4">
                            <div class="form-group">
                                <label for="IDSede" style="font-weight:bold">
                                    Sede
                                </label>
                                <div>
                                    @Model.Sede.Nombre
                                </div>



                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-4">
                            <div class="form-group">
                                <label for="" style="font-weight:bold">
                                    &nbsp;
                                </label>

                                <input type="text" class="form-control" value="" disabled />



                            </div>

                        </div>




                    </div>

                </div>
            </div>


            <div class="panel panel-default">
                <div class="panel-body">
                    <h2 class="page-header" style="margin-top: 70px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                        <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;font-size:14px;">Detalle de la Reclamación y Pedido del Consumidor</span>
                    </h2>

                    <div class="row" style="min-height:35px;">


                        <div class="col-xs-6 col-sm-12">
                            <label style="font-weight:bold">Tipo: </label>
                            <div>
                                @Model.Tipo.Nombre
                            </div>
                        </div>

                    </div>
                    <br />
                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-12">
                            <div class="form-group">
                                <label for="Detalle" style="font-weight:bold">
                                    Detalle:
                                </label>
                                <div>
                                    @Model.Detalle
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-12">
                            <div class="form-group">
                                <label for="Pedido" style="font-weight:bold">
                                    Pedido:
                                </label>
                                <div>
                                    @Model.Pedido
                                </div>

                            </div>
                        </div>
                    </div>
                    <br />

                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-12">
                            <div class="form-group">
                                <label for="" style="font-weight:bold">
                                    Tiene Evidencia:
                                </label>
                                @if (Model.Evidencia == null)
                                {
                                    <div>
                                        No
                                    </div>


                                }
                                else
                                {
                                    <div>
                                        Sí
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            @if (Model.Respuesta != null)
            {
            <div class="panel panel-default">
                <div class="panel-body">
                    <h2 class="page-header" style="margin-top: 70px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                        <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;font-size:14px;">Respuesta de Reclamo y/o Queja</span>
                    </h2>

                    <div class="row" style="min-height:35px;">


                        <div class="col-xs-6 col-sm-6">
                            <label style="font-weight:bold">Procede: </label>
                            <div>
                                @if (Model.Procede)
                                {
                                    <span>Sí</span>
                                }else
                                {
                                    <span>No</span>
                                }
                            </div>
                        </div>

                        <div class="col-xs-6 col-sm-6">
                            <div class="form-group">
                                <label for="Respuesta" style="font-weight:bold">
                                    Fecha de Respuesta:
                                </label>
                                <div>
                                    @Model.FechaRespuestaString
                                </div>
                            </div>
                        </div>

                    </div>
                    <br />

                    

                    <div class="row" style="min-height:35px;">
                        <div class="col-xs-12 col-sm-12">
                            <div class="form-group">
                                <label for="Respuesta" style="font-weight:bold">
                                    Respuesta:
                                </label>
                                <div>
                                    <p>Estimado(a) Sr./Sra. @Model.Nombres @Model.ApellidoPaterno:</p>
                                    <p>Lo/La saludamos cordialmente, a fin de manifestarle nuestras disculpas por lo ocurrido en relación al reclamo presentado; por este motivo, como responsable de Atención al Cliente estamos procediendo a:</p>
                                    <p>@Model.Respuesta</p>
                                    <p>Estando a lo antes expuesto, SKINCARE, en esta oportunidad, considera que su reclamo es PROCEDENTE.</p>
                                    <p>Nos despedimos reiterando nuestro compromiso de seguir trabajando para brindarle siempre el mejor servicio.</p>                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    

                </div>
            </div>

            }




        </form>

    </div>

    <style>
        

        body {
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            font-size: 12px;
        }

        .form-control {
            border: none;
            display: inline-block;
            width: 100%;
        }

        .container-fluid {
            display: none;
        }

        .col-sm-4 {
            width: 33.3%;
            float: left;
        }

        .col-sm-6 {
            width: 50%;
            float: left;
        }

        .col-sm-3 {
            width: 25%;
            float: left;
        }

        .col-sm-12 {
            width: 100%;
            float: left;
        }
        .form-group label{
            margin-bottom:15px;
        }
    </style>

</body>

</html>
