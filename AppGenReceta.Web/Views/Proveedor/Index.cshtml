@model List<AppGenReceta.BE.E_InsumoProveedor>
@{
    ViewBag.Title = "Proveedores y Presentaciones";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* VARIABLES GLOBALES Y SIDEBAR (Gold Standard) */
    :root {
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    body .container.main-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }
    .insumo-module-layout { display: flex; background-color: var(--color-background-body); min-height: 100vh; }
    
    .insumo-sidebar { width: 260px; background-color: var(--hialpesa-dark); color: white; flex-shrink: 0; display: flex; flex-direction: column; padding-top: 35px; box-shadow: 4px 0 10px rgba(0,0,0,0.1); z-index: 10; }
    .sidebar-header { padding: 0 24px 24px 24px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; text-align: center; }
    .sidebar-header h3 { margin: 0; font-size: 18px; font-weight: 700; color: white; letter-spacing: 1px; text-transform: uppercase; line-height: 1.2; }
    .sidebar-header span { font-size: 11px; color: var(--hialpesa-accent); font-weight: 600; display: block; margin-top: 4px; }
    .sidebar-nav { list-style: none; padding: 0; margin: 0; }
    .sidebar-nav li { margin: 4px 12px; border-bottom: none !important; }
    .sidebar-nav a { display: flex; align-items: center; padding: 12px 16px; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-size: 14px; font-weight: 500; transition: all 0.2s; border-radius: 8px; }
    .sidebar-nav a i { margin-right: 12px; width: 20px; text-align: center; font-size: 16px; opacity: 0.8; }
    .sidebar-nav a:hover, .sidebar-nav li.active a { background-color: rgba(255, 255, 255, 0.1); color: white; }
    .sidebar-nav li.active a { font-weight: 600; border-left: 4px solid var(--hialpesa-accent); padding-left: 20px; }

    /* CONTENEDOR PRINCIPAL */
    .insumo-container { flex: 1; padding: 30px 40px; overflow-y: auto; }
    .content-box { background: white; border: 1px solid var(--color-border); border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 20px; }

    /* FILTROS TIPO VB6 */
    .filter-panel { display: flex; gap: 30px; align-items: center; background: #f1f5f9; padding: 15px 20px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 20px; }
    .filter-inputs { display: flex; gap: 15px; align-items: center; flex: 1; }
    .filter-inputs input, .filter-inputs select { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; outline: none; }
    
    .btn-primary-hialpesa { background: var(--hialpesa-dark); color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .btn-success-hialpesa { background: #10b981; color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .btn-danger-hialpesa { background: #ef4444; color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .btn-info-hialpesa { background: #3b82f6; color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .btn-outline-hialpesa { background: white; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px; cursor: pointer; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02); }
    .btn-text { background: none; border: 1px solid #cbd5e1; color: #475569; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; font-weight: 500; transition: all 0.2s; }
    .btn-text:hover { background: #f8fafc; color: var(--hialpesa-dark); border-color: #94a3b8; }

    /* TABLA */
    table.dataTable, .data-table { width: 100% !important; border-collapse: collapse; font-size: 13px; }
    table.dataTable thead th, .data-table thead th { background: #e2e8f0; color: #475569; padding: 12px; border-bottom: 2px solid #cbd5e1; text-align: left; }
    table.dataTable tbody td, .data-table tbody td { padding: 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    
    /* MODALES */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.6); z-index: 1050; align-items: center; justify-content: center; }
    .modal-content-box { background: white; border-radius: 8px; padding: 0; box-shadow: 0 10px 25px rgba(0,0,0,0.2); width: 950px; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; background: var(--hialpesa-dark); color: white; padding: 15px 24px; border-radius: 8px 8px 0 0; }
    .modal-title { margin: 0; font-size: 18px; font-weight: 700; color: white; }
    .close-btn { cursor: pointer; font-size: 20px; color: white; opacity: 0.8; }
    .close-btn:hover { opacity: 1; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 13px; color: #64748b; margin-bottom: 4px; font-weight: 600; }
    .form-control { width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; }
    .form-body { padding: 24px; }
</style>

<div class="insumo-module-layout">

    <div class="insumo-sidebar">
        <div class="sidebar-header">
            <h3>INSUMOS</h3>
            <span>Almacén de Estampado</span>
        </div>
        <ul class="sidebar-nav">
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-layer-group"></i> Agrupación de NPs</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-box"></i> Lista de Insumos</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-check-double"></i> Generar Solicitud</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-receipt"></i> Voucher</a></li>
            <li><a href="@Url.Action("Mantenimiento", "InsumoEstampado")"><i class="fas fa-bars"></i> Mant. Solicitudes</a></li>
            <li class="active"><a href="@Url.Action("Index", "Proveedor")"><i class="fas fa-truck"></i> Proveedores</a></li>
            <li><a href="@Url.Action("Index", "ConsumoAdicional", new { sid = ViewBag.SessionID })"><i class="fas fa-plus-circle"></i> Consumos Producción</a></li>
        </ul>
    </div>

    <!-- MAIN AREA -->
    <div class="insumo-container">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h1 style="font-size: 20px; font-weight: 600; color: var(--hialpesa-dark); margin: 0;">Gestión de Proveedores</h1>
            <button class="btn-success-hialpesa" onclick="abrirModalNuevo()"><i class="fas fa-plus"></i> Nuevo Proveedor</button>
        </div>

        <div class="content-box">
            <!-- FILTROS -->
            <div class="filter-panel">
                <div class="filter-inputs">
                    <div style="flex:1;">
                        <label style="font-size:12px; color:#64748b; font-weight:600;">Buscar Proveedor o Insumo</label><br/>
                        <input type="text" id="txtBuscar" class="form-control" placeholder="Escriba aquí..." style="width: 100%; max-width: 400px;">
                    </div>
                </div>
            </div>

            <div id="gridWrapper" style="overflow-x:auto;">
                @Html.Partial("_ListaProveedoresGrid", Model)
            </div>
        </div>

    </div>
</div>

<!-- MODAL MANTENIMIENTO PROVEEDOR (EXTENDIDO MAESTRO-DETALLE) -->
<div id="modalProveedor" class="modal-overlay">
    <div class="modal-content-box">
        <div class="modal-header">
            <h3 id="modalTitle" class="modal-title">Registrar Relación: Proveedor e Insumo</h3>
            <span class="close-btn" onclick="cerrarModal()">&times;</span>
        </div>

        <div class="form-body">
            <input type="hidden" id="hdnIdRelacion" value="0" />

            <div style="display:flex; gap:24px;">
                <!-- Columna Izquierda: Datos del Proveedor -->
                <div style="flex:1;">
                    <h4 style="font-size:14px; margin-bottom:15px; border-bottom:1px solid #e2e8f0; padding-bottom:8px; color:var(--hialpesa-dark); font-weight:700;">
                        1. Datos del Proveedor
                    </h4>

                    <div class="form-group">
                        <label>RUC</label>
                        <input type="text" id="txtRuc" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="11" />
                    </div>

                    <div class="form-group">
                        <label>Razón Social</label>
                        <input type="text" id="txtRazonSocial" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Contacto / Email (Opcional)</label>
                        <input type="text" id="txtContacto" class="form-control" />
                    </div>
                </div>

                <!-- Columna Derecha: Relación de Precios e Insumo -->
                <div style="flex:1;">
                    <h4 style="font-size:14px; margin-bottom:15px; border-bottom:1px solid #e2e8f0; padding-bottom:8px; color:var(--hialpesa-dark); font-weight:700;">
                        2. Atributos de Compra
                    </h4>

                    <div class="form-group">
                        <label>Código Insumo Relacionado</label>
                        <select id="txtInsumoRelacionado" class="form-control"></select>
                    </div>

                    <div style="display:flex; gap:15px;">
                        <div class="form-group" style="flex:2;">
                            <label>Presentación</label>
                            <input type="text" id="txtPresentacion" class="form-control" placeholder="Ej. Balde 20 Kg" />
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label>Cap. Num</label>
                            <input type="number" id="txtCapacidad" class="form-control" step="0.1" value="20" onkeyup="calcularCostoTotalModal()" onchange="calcularCostoTotalModal()" />
                        </div>
                    </div>

                    <div style="display:flex; gap:15px; margin-bottom: 20px;">
                        <div class="form-group" style="flex:1;">
                            <label>Unidad Med.</label>
                            <select id="dropUnidad" class="form-control" onchange="cambiarLeyenda()">
                                <option value="kg">Kilos (kg)</option>
                                <option value="litro">Litros (l)</option>
                                <option value="metro">Metros (m)</option>
                                <option value="und">Unidad</option>
                            </select>
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label>Precio X <span id="lblRefUnidad">kg</span></label>
                            <input type="number" id="txtPrecioUnitario" class="form-control" step="0.01" value="0.00" onkeyup="calcularCostoTotalModal()" onchange="calcularCostoTotalModal()" />
                        </div>
                    </div>

                    <div style="display:flex; justify-content:flex-end;">
                        <button type="button" class="btn-primary-hialpesa" onclick="agregarInsumoTemporal()">
                            <i class="fas fa-plus"></i> Añadir Insumo
                        </button>
                    </div>
                </div>
            </div>

            <!-- ZONA DE GRILLA TEMPORAL -->
            <div style="margin-top:20px; margin-bottom:20px; border:1px solid #e2e8f0; border-radius:8px; max-height:220px; overflow-y:auto;">
                <table class="data-table" id="tbResumenInsumos">
                    <thead style="position:sticky; top:0; z-index:1;">
                        <tr>
                            <th>Código Insumo</th>
                            <th>Presentación</th>
                            <th>Capacidad</th>
                            <th>U.M.</th>
                            <th>Precio Unit.</th>
                            <th>Subtotal</th>
                            <th style="text-align:center;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Filas dinámicas -->
                    </tbody>
                </table>
            </div>

            <!-- FOOTER TOTAL Y BOTONES -->
            <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed #cbd5e1; padding-top:20px;">
                <div>
                    <span style="font-size:12px; color:#64748b; font-style:italic;"><i class="fas fa-info-circle"></i> Asegúrese de añadir todos los insumos a la lista antes de guardar.</span>
                </div>
                <div style="display:flex; gap:10px;">
                    <button class="btn-outline-hialpesa" onclick="cerrarModal()">Cancelar</button>
                    <button class="btn-success-hialpesa" onclick="guardarProveedorCompleto()"><i class="fas fa-save"></i> Guardar Todo</button>
                </div>
            </div>
        </div>
    </div>
</div>

