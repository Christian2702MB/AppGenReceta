                    },
                    cache: true
                }
            });

            // Lógica de validación autocompletado de RUC contra Proveedor Externo (DESACTIVADO TEMPORALMENTE POR ERROR 526 PERUAPI)
            /*
            document.getElementById('txtRuc').addEventListener('blur', async function() {
