            */
        });

        var arrayInsumosMemoria = []; // Almacen de objetos a enviar al C#

        function abrirModalNuevo() {
            $('#hdnIdRelacion').val('0');
            $('#txtRuc').val('').prop('readonly', false).css('background-color', '#fff');
            $('#txtRazonSocial').val('').prop('readonly', false).css('background-color', '#fff');
            $('#txtContacto').val('');

            limpiarControlesLadoDerecho();

            arrayInsumosMemoria = [];
            renderTablaTemporales();

            $('#modalTitle').text('Registrar Nuevo Proveedor y sus Insumos');
            $('#modalProveedor').css('display', 'flex');
        }

        function cerrarModal() {
            $('#modalProveedor').css('display', 'none');
        }

        function limpiarControlesLadoDerecho() {
            $('#txtInsumoRelacionado').val(null).trigger('change');
            $('#txtPresentacion').val('');
            $('#txtCapacidad').val('20');
            $('#txtPrecioUnitario').val('0.00');
            $('#dropUnidad').val('kg');
            cambiarLeyenda();
        }

        function cambiarLeyenda() {
            var val = $('#dropUnidad').val();
            $('#lblRefUnidad').text(val);
        }

        function calcularCostoTotalModal() {
            // Ya no es necesario mostrarlo abajo, pero podriamos autocalcular
        }

        function agregarInsumoTemporal() {
            var codInsumoFull = $('#txtInsumoRelacionado').val();
            var presentacion = $('#txtPresentacion').val();
            var cap = parseFloat($('#txtCapacidad').val());
            var um = $('#dropUnidad').val();
            var rawPrecio = $('#txtPrecioUnitario').val();
            var precioU = parseFloat(rawPrecio);

            if (!codInsumoFull) {
                Swal.fire('Atención', 'Debe seleccionar un Código Insumo Relacionado.', 'warning');
                return;
            }
            if (!presentacion || presentacion.trim() === "") {
                Swal.fire('Atención', 'La Presentación es obligatoria.', 'warning');
                return;
            }
            if (isNaN(cap) || cap <= 0) {
                Swal.fire('Atención', 'La Capacidad Numérica debe ser mayor a cero.', 'warning');
                return;
            }
            if (!um || um.trim() === "") {
                Swal.fire('Atención', 'La Unidad de Medida es obligatoria.', 'warning');
                return;
            }
            if (!rawPrecio || rawPrecio.trim() === "" || isNaN(precioU) || precioU <= 0) {
                Swal.fire('Atención', 'El Precio Unitario es obligatorio y debe ser mayor a cero.', 'warning');
                return;
            }

            var parts = codInsumoFull.split(' ');
            var codPuro = parts[0];

            // Validar si ya existe
            var existe = arrayInsumosMemoria.find(x => x.CodigoArticulo === codPuro && x.DescripcionPresentacion === presentacion);
            if (existe) {
                Swal.fire('Aviso', 'Este insumo con esa misma presentación ya está en la lista inferior.', 'info');
                return;
            }

            var obj = {
                CodigoArticulo: codPuro,
                DescripcionPresentacion: presentacion,
                CapacidadNumerica: cap,
                UnidadMedida: um,
                PrecioUnitario: precioU,
                PrecioPresentacion: (cap * precioU) // solo visual
            };

            arrayInsumosMemoria.push(obj);
            renderTablaTemporales();
            limpiarControlesLadoDerecho();
        }

        function renderTablaTemporales() {
            var tbody = $('#tbResumenInsumos tbody');
            tbody.empty();

            if (arrayInsumosMemoria.length === 0) {
                tbody.append('<tr><td colspan="7" style="text-align:center; color:#94a3b8;">No se han agregado insumos. Use el botón "Añadir Insumo".</td></tr>');
                return;
            }

            arrayInsumosMemoria.forEach((item, index) => {
                var html = '<tr>' +
                    '<td style="padding:10px;">' + item.CodigoArticulo + '</td>' +
                    '<td style="padding:10px;">' + item.DescripcionPresentacion + '</td>' +
                    '<td style="padding:10px;">' + item.CapacidadNumerica + '</td>' +
                    '<td style="padding:10px;">' + item.UnidadMedida + '</td>' +
                    '<td style="padding:10px;">' + parseFloat(item.PrecioUnitario).toFixed(2) + '</td>' +
                    '<td style="padding:10px; font-weight:bold;">S/ ' + parseFloat(item.PrecioPresentacion).toFixed(2) + '</td>' +
                    '<td style="padding:10px; text-align:center;"><button class="btn-danger-hialpesa" style="padding:4px 8px; font-size:11px;" onclick="quitarDeLista(' + index + ')" title="Eliminar"><i class="fas fa-trash-alt"></i></button></td>' +
                    '</tr>';
                tbody.append(html);
            });
        }

        function quitarDeLista(idx) {
            arrayInsumosMemoria.splice(idx, 1);
            renderTablaTemporales();
        }

        function guardarProveedorCompleto() {
            var idProv = $('#hdnIdRelacion').val() || 0;
            var ruc = $('#txtRuc').val() || "";
            var raz = $('#txtRazonSocial').val() || "";
            var cont = $('#txtContacto').val() || "";

            if (ruc.trim().length !== 11) {
                Swal.fire('Atención', 'El RUC es obligatorio y debe tener exactamente 11 dígitos.', 'warning');
                return;
            }

            if (raz.trim() === "") {
                Swal.fire('Atención', 'Debe ingresar la Razón Social del Proveedor.', 'warning');
                return;
            }

            if (arrayInsumosMemoria.length === 0) {
                Swal.fire('Atención', 'No ha agregado ningún Insumo a la grilla inferior.', 'warning');
                return;
            }

            // Armar JSON anidado
            var dataPayload = {
                IdProveedor: idProv,
                Ruc: ruc,
                RazonSocial: raz,
                Contacto: cont,
                ListaInsumos: arrayInsumosMemoria
            };

            // Animacion cargando
            Swal.fire({ title: 'Guardando...', text: 'Por favor espere', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
                url: '@Url.Action("GuardarRelacionMulti", "Proveedor")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(dataPayload),
                success: function (res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            cerrarModal();
                            $('#txtBuscar').keyup();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function (err) {
                    Swal.fire('Error Interno', 'Error al invocar el guardado', 'error');
                }
            });
        }

        function editarProveedor(idProveedor) {
            Swal.fire({ title: 'Cargando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            $.ajax({
                url: '@Url.Action("ObtenerProveedor", "Proveedor")',
                type: 'GET',
                data: { idProveedor: idProveedor },
                success: function (res) {
                    Swal.close();
                    if (res.success && res.data) {
                        $('#hdnIdRelacion').val(res.data.IdProveedor); // Usaremos hdnIdRelacion para guardar el ID_PROVEEDOR
                        $('#txtRuc').val(res.data.Ruc).prop('readonly', true).css('background-color', '#f1f5f9');
                        $('#txtRazonSocial').val(res.data.RazonSocial).prop('readonly', true).css('background-color', '#f1f5f9');
                        $('#txtContacto').val(res.data.Contacto);

                        limpiarControlesLadoDerecho();
                        arrayInsumosMemoria = res.data.ListaInsumos || [];

                        // Calcular PrecioPresentacion para la vista JS
                        arrayInsumosMemoria.forEach(i => {
                            i.PrecioPresentacion = i.CapacidadNumerica * i.PrecioUnitario;
                        });

                        renderTablaTemporales();
                        $('#modalTitle').text('Editar Proveedor y su Catálogo');
                        $('#modalProveedor').css('display', 'flex');
                    } else {
                        Swal.fire('Error', res.message || 'No se pudo cargar el proveedor', 'error');
                    }
                }
            });
        }

        function eliminarRelacionGrid(idRelacion) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Se eliminará esta presentación permanentemente.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("EliminarRelacion", "Proveedor")',
                        type: 'POST',
                        data: { idRelacion: idRelacion },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Eliminado', res.message, 'success');
                                $('#txtBuscar').keyup();
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
