@model AppGenReceta.BE.VisitaBE
@using AppGenReceta.BE;
@{
    ViewBag.Title = "Aplicativo Receta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    .swal2-footer {
        text-align: center !important;
    }

    /* Corrección de Select2 para tablas y Bootstrap */
    .select2-container {
        width: 100% !important;
        min-width: 250px;
    }

        .select2-container .select2-selection--single {
            height: 31px !important;
            padding-top: 2px;
            border: 1px solid #ccc !important;
        }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 29px !important;
    }
</style>
<div class="panel-body">
    @*<form action="@Url.Action("RegistrarVisitaCompleta", "Home")" method="post" id="formLibroVisita">*@
    <form id="formLibroVisita">
        <input type="hidden" id="hdnIdVisita" value="0" />
        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Datos de la Cabecera</span>
                </h2>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 mb-3">
                        <div class="row align-items-center bg-light p-2 rounded border" style="margin-bottom: 5px; border-radius:4px; padding: 10px;">
                            <div class="col-sm-2 text-right"><strong>Modo de Registro:</strong></div>
                            <div class="col-sm-4">
                                <label class="radio-inline mr-3" style="cursor:pointer; margin-right: 15px;">
                                    <input type="radio" name="rdoModoRegistro" id="rdoModoNormal" value="NORMAL" onchange="cambiarModoRegistro()"> <span class="label label-primary" style="font-size: 13px;">Proceso Clásico</span>
                                </label>
                                <label class="radio-inline" style="cursor:pointer;">
                                    <input type="radio" name="rdoModoRegistro" id="rdoModoInverso" value="INVERSO" checked="checked" onchange="cambiarModoRegistro()"> <span class="label label-warning" style="font-size: 13px;">Búsqueda por Estilo</span>
                                </label>
                            </div>
                            <div class="col-sm-6 text-muted" id="lblInfoModoRegistro" style="font-size: 13px; font-style: italic;">
                                (Seleccione Cliente &rarr; Temporada &rarr; Estilo)
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Cliente
                            </label>
                            <select id="txtCliente" class="form-control select2">
                                <option value=""> Seleccione un Cliente </option>
                                @if (ViewBag.Cliente != null)
                                {
                                    foreach (NPBE contacto in ViewBag.Cliente)
                                    {
                                        <option value="@contacto.Cliente">@contacto.Cliente</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label>Temporada</label>
                            <select id="txtTemporada" name="txtTemporada" class="form-control">
                                <option value="">Seleccione una Temporada</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Estilo Cliente
                            </label>
                            <select id="txtEstilo" name="txtEstilo" class="form-control select2">
                                <option value="">Seleccione un estilo Cliente</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Estilo Propio
                            </label>
                            <select id="txtEstiloPropio" name="txtEstiloPropio" class="form-control select2">
                                <option value="">Seleccione un estilo Propio</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">Combo</label>
                            <select id="txtCombo" name="txtCombo" class="form-control select2">
                                <option value="">Seleccione un Combo</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Item
                            </label>
                            <select id="txtItem" class="form-control select2">
                                <option value="">Seleccione un Item</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label>Ubicación</label>
                            <select id="txtUbicacion" class="form-control select2">
                                <option value="">Seleccione una Ubicación</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label>Arte <span class="text-muted">(Opcional)</span>:</label>
                            <input type="text" name="txtArte" id="txtArte" class="form-control" placeholder="Ingrese Arte" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Fecha
                            </label>
                            <input type="date" name="dtFechaUDP" class="form-control" value="" id="dtFechaUDP" required />
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Muestrista
                            </label>
                            <input type="text" name="txtOperario" class="form-control" value="" id="txtOperario" required />
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-6">
                        <div class="form-group">
                            <label for="Hub">
                                Técnica
                            </label>
                            <select id="txtTecnica" class="form-control select2">
                                <option value=""> Seleccione una Técnica </option>
                                @*@if (ViewBag.Tecnicas != null)
                                {
                                    foreach (var tecnica in (List<string>)ViewBag.Tecnicas)
                                    {
                                        <option value="@tecnica">@tecnica</option>
                                    }
                                }*@
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                NP - MV
                            </label>
                            <input type="text" name="txtNP" class="form-control" value="" id="txtNP" />
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label for="Hub">
                                Prendas
                            </label>
                            <input type="number" name="txtPrendasReq" class="form-control" value="" id="txtPrendasReq" step="1" min="0" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-3">
                        <label>Color Pantone</label>
                        <input type="text" id="txtNuevoColor" class="form-control" placeholder="Ej: Rojo">
                    </div>
                    <div class="col-md-2">
                        <label>&nbsp;</label>
                        <button type="button" id="btnAgregarColor" class="btn btn-primary btn-block" onclick="agregarColor()">
                            <i class="fa fa-plus mr-2"></i> Agregar Color
                        </button>
                    </div>
                </div>

                <hr />

                <table id="tablaMaestra" class="table table-bordered">
                    <thead style="background-color: #07238a; color: white;">
                        <tr>
                            <th>Color Pantone (Clic para seleccionar)</th>
                            <th>Insumos del Color</th>
                            <th style="width: 100px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTablaMaestra">
                    </tbody>
                </table>

                <div id="panelInsumos" class="panel panel-info" style="display:none; border: 2px solid #07238a;">
                    <div class="panel-heading">Agregando Insumo para: <strong id="lblColorActivo"></strong></div>
                    <div class="panel-body">
                        <div class="row">
                            @*<div class="col-md-3">
                                    <label>Código Insumo</label>
                                    <input type="text" name="cboInsumo" class="form-control" value="" id="cboInsumo" readonly />
                                </div>*@
                            <div class="col-md-8">
                                <label>Descripción Insumo:</label>
                                <select id="txtDescInsumo" name="txtDescInsumo" class="form-control" style="background-color: #eee;" data-url-busqueda="@Url.Action("BuscarInsumosSelect2", "Home")">
                                    <option value="">Seleccione o busque un insumo...</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Stock</label>
                                <input type="text" name="txtStock" class="form-control" value="" id="txtStock" readonly />
                            </div>
                            <div class="col-md-2">
                                <label>Peso(Gr)</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" id="txtCantInsumo" class="form-control" placeholder="0.00" min="0">
                                    <span class="input-group-btn">
                                        <button type="button" id="btnAgregarInsumo" class="btn btn-success btn-sm" onclick="agregarInsumo()" title="Agregar Insumo al Color Seleccionado">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @Html.Hidden("URL_Registrar", Url.Action("RegistrarVisitaCompleta", "Home"))

        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-12 col-sm-4" style="text-align: right">
                        <div class="form-group">
                            <a id="btnRegistrarTodo" class="btn btn-primary px-4 shadow-sm" onclick="guardarRecetaCompleta()"><i class="fa fa-check mr-2"></i> Registrar</a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4" style="text-align: center">
                        <div class="form-group">
                            <a id="btnLimpiar" class="btn btn-warning px-4 shadow-sm text-white" onclick="location.reload();"><i class="fas fa-broom mr-2"></i> Limpiar</a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group" style="text-align: left">
                            <a id="btnCancelarVisita" class="btn btn-danger px-4 shadow-sm"><i class="fa fa-times mr-2"></i> Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>


</div>
@*}*@

@section scripts{
    <!-- Include a polyfill for ES6 Promises (optional) for IE11 -->
    <script src="https://cdn.jsdelivr.net/npm/promise-polyfill9/dist/polyfill.js"></script>
    <script src="https://cdn.polyfill.io/v2/polyfill.min.js"></script>
    <script src="https://npmcdn.com/es6-promise@3.2.1"></script>

    @*<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@9.1.5/dist/sweetalert2.all.min.js"></script>*@
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.9/dist/js/bootstrap-select.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @Scripts.Render("~/bundles/visita")
    <script>
        $(document).ready(function () {
            // Inicializar Select2 con AJAX para optimización
            $('#txtDescInsumo').select2({
                placeholder: 'Seleccione o busque un insumo...',
                ajax: {
                    url: $('#txtDescInsumo').data('url-busqueda'),
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '' };
                    },
                    processResults: function (data) {
                        return { results: data.items };
                    },
                    cache: true
                },
                minimumInputLength: 3,
                language: {
                    inputTooShort: function () {
                        return "Por favor ingrese 3 o más caracteres...";
                    },
                    noResults: function () {
                        return "No se encontraron insumos";
                    },
                    searching: function () {
                        return "Buscando...";
                    }
                }
            });

            // Enter key para el campo cantidad
            $('#txtCantInsumo').on('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    e.preventDefault(); // Evita recargar página
                    $('#btnAgregarInsumo').click(); // Simula el clic
                }
            });

            // Enter key para agregar color
            $('#txtNuevoColor').on('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    e.preventDefault();
                    $('#btnAgregarColor').click();
                }
            });
        });
    </script>

}







