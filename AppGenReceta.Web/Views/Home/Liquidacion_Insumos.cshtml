@{
    ViewBag.Title = "Liquidación de Insumos - Estampado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Carga de Recursos Específicos -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* VARIABLES GLOBALES Y SIDEBAR (Gold Standard de Hialpesa) */
    :root {
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    body .container.main-container { 
        max-width: 100% !important; 
        width: 100% !important; 
        margin: 0 !important; 
        padding: 0 !important; 
    }
    
    .insumo-module-layout { 
        display: flex; 
        background-color: var(--color-background-body); 
        min-height: 100vh; 
    }
    
    /* SIDEBAR CORPORATIVO */
    .insumo-sidebar { 
        width: 260px; 
        background-color: var(--hialpesa-dark); 
        color: white; 
        flex-shrink: 0; 
        display: flex; 
        flex-direction: column; 
        padding-top: 35px; 
        box-shadow: 4px 0 10px rgba(0,0,0,0.1); 
        z-index: 10; 
    }
    
    .sidebar-header { 
        padding: 0 24px 24px 24px; 
        border-bottom: 1px solid rgba(255,255,255,0.1); 
        margin-bottom: 20px; 
        text-align: center; 
    }
    
    .sidebar-header h3 { 
        margin: 0; 
        font-size: 18px; 
        font-weight: 700; 
        color: white; 
        letter-spacing: 1px; 
        text-transform: uppercase; 
        line-height: 1.2; 
    }
    
    .sidebar-header span { 
        font-size: 11px; 
        color: var(--hialpesa-accent); 
        font-weight: 600; 
        display: block; 
        margin-top: 4px; 
    }
    
    .sidebar-nav { 
        list-style: none; 
        padding: 0; 
        margin: 0; 
    }
    
    .sidebar-nav li { 
        margin: 4px 12px; 
        border-bottom: none !important; 
    }
    
    .sidebar-nav a { 
        display: flex; 
        align-items: center; 
        padding: 12px 16px; 
        color: rgba(255, 255, 255, 0.7); 
        text-decoration: none; 
        font-size: 14px; 
        font-weight: 500; 
        transition: all 0.2s; 
        border-radius: 8px; 
    }
    
    .sidebar-nav a i { 
        margin-right: 12px; 
        width: 20px; 
        text-align: center; 
        font-size: 16px; 
        opacity: 0.8; 
    }
    
    .sidebar-nav a:hover, .sidebar-nav li.active a { 
        background-color: rgba(255, 255, 255, 0.1); 
        color: white; 
    }
    
    .sidebar-nav li.active a { 
        font-weight: 600; 
        border-left: 4px solid var(--hialpesa-accent); 
        padding-left: 20px; 
    }

    /* CONTENEDOR PRINCIPAL */
    .insumo-container { 
        flex: 1; 
        padding: 30px 40px; 
        overflow-y: auto; 
    }
    
    .content-box { 
        background: white; 
        border: 1px solid var(--color-border); 
        border-radius: 12px; 
        padding: 24px; 
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); 
        margin-bottom: 20px; 
    }

    /* BOTONES HIALPESA */
    .btn-primary-hialpesa { 
        background: var(--hialpesa-dark); 
        color: white; 
        border: 1px solid var(--hialpesa-dark); 
        padding: 10px 24px; 
        border-radius: 8px; 
        font-weight: 700; 
        font-size: 13px;
        cursor: pointer; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px; 
        box-shadow: 0 4px 6px rgba(0,45,114,0.2);
        transition: all 0.2s;
    }
    .btn-primary-hialpesa:hover {
        background: #001f52;
        color: white;
        text-decoration: none;
    }

    .btn-outline-hialpesa { 
        background: white; 
        border: 1px solid #cbd5e1; 
        padding: 8px 16px; 
        border-radius: 6px; 
        font-size: 13px; 
        font-weight: 600; 
        color: #475569; 
        display: inline-flex; 
        align-items: center; 
        gap: 6px; 
        cursor: pointer; 
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02); 
        transition: all 0.2s;
    }
    .btn-outline-hialpesa:hover {
        background: #f8fafc;
        color: var(--hialpesa-dark);
        border-color: #94a3b8;
        text-decoration: none;
    }

    /* PESTAÑAS PERSONALIZADAS */
    .nav-tabs-custom { 
        display: flex; 
        gap: 5px; 
        border-bottom: 1px solid #dee2e6; 
        margin-bottom: 20px; 
        background: #f1f5f9; 
        padding: 5px 10px 0; 
        border-radius: 8px 8px 0 0; 
    }
    
    .tab-item { 
        padding: 10px 20px; 
        font-size: 13px; 
        font-weight: 600; 
        color: #64748b; 
        text-decoration: none; 
        border-radius: 6px 6px 0 0; 
        border: 1px solid transparent; 
        border-bottom: none; 
        transition: 0.2s; 
    }
    .tab-item:hover {
        color: var(--hialpesa-dark);
        text-decoration: none;
    }
    .tab-item.active { 
        background: #fff; 
        color: var(--hialpesa-dark); 
        border-color: #dee2e6; 
        border-bottom: 2px solid #fff; 
        margin-bottom: -1px; 
    }
    .tab-item i { 
        margin-right: 8px; 
    }

    /* TABLA ESTILO CORPORATIVO */
    .table-title { 
        padding: 15px 20px; 
        border-bottom: 1px solid #f1f5f9; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .table-title h2 { 
        font-size: 15px; 
        font-weight: 700; 
        color: var(--hialpesa-dark); 
        margin: 0; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
    }
    .table-title h2::before { 
        content: ""; 
        display: inline-block; 
        width: 3px; 
        height: 16px; 
        background-color: var(--hialpesa-dark); 
    }

    .erp-table { 
        width: 100%; 
        border-collapse: collapse; 
        margin-bottom: 0;
    }
    .erp-table thead th { 
        background-color: var(--hialpesa-dark); 
        color: #fff; 
        font-size: 11px; 
        font-weight: 600; 
        text-transform: uppercase; 
        padding: 12px 15px; 
        border: none; 
        letter-spacing: 0.5px; 
    }
    .erp-table tbody td { 
        font-size: 13px; 
        padding: 12px 15px; 
        vertical-align: middle; 
        border-bottom: 1px solid #f1f5f9; 
    }

    .badge-status { 
        font-size: 11px; 
        font-weight: 700; 
        padding: 4px 12px; 
        border-radius: 20px; 
        background: #fef08a; 
        color: #854d0e; 
    }
    .badge-status.disponible { 
        background: #dcfce7; 
        color: #166534; 
    }

    /* BOTONES DE ACCIÓN PILL (DE MOCKUP) */
    .btn-action-pill { 
        font-size: 11px; 
        font-weight: 700; 
        padding: 4px 12px; 
        border-radius: 20px; 
        border: 1px solid #cbd5e1; 
        background: #fff; 
        color: #475569; 
        display: inline-flex; 
        align-items: center; 
        gap: 6px; 
        transition: 0.2s; 
        cursor: pointer;
    }
    .btn-action-pill:hover { 
        background: #f8fafc; 
        text-decoration: none;
    }
    
    .btn-action-pill.btn-consumo { border-color: var(--hialpesa-dark); color: var(--hialpesa-dark); }
    .btn-action-pill.btn-consumo:hover { background: #e0f2fe; }
    
    .btn-action-pill.btn-merma { border-color: var(--hialpesa-accent); color: var(--hialpesa-accent); }
    .btn-action-pill.btn-merma:hover { background: #fff7ed; }

    .btn-action-pill.btn-dev { border-color: #64748b; color: #475569; }
    .btn-action-pill.btn-dev:hover { background: #f1f5f9; }
    
    .btn-action-pill.btn-ingreso { border-color: #0ea5e9; color: #0ea5e9; background: #f0f9ff; }
    .btn-action-pill.btn-ingreso:hover { background: #e0f2fe; }

    /* DETALLE AGRUPADO POR COLOR */
    .detail-container { 
        padding: 10px 0; 
        background: #f8fafc; 
        border-bottom: 2px solid #cbd5e1; 
    }
    
    .color-group-header { 
        background: #fff; 
        padding: 10px 25px; 
        font-size: 13px; 
        font-weight: 700; 
        color: #334155; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        border-bottom: 1px solid #f1f5f9; 
        border-top: 1px solid #f1f5f9; 
        cursor: pointer; 
        user-select: none; 
    }
    .color-group-header:hover { 
        background: #f1f5f9; 
    }
    .color-group-header i { 
        color: #94a3b8; 
        font-size: 12px; 
        transition: transform 0.3s; 
    }
    .color-group-header.collapsed i { 
        transform: rotate(-90deg); 
    }
    
    .inner-table { 
        background: #fff; 
        width: 100%; 
        margin-bottom: 0; 
        border-collapse: collapse;
    }
    .inner-table thead th { 
        background: #f8fafc; 
        color: #64748b; 
        font-size: 10px; 
        font-weight: 700; 
        border-bottom: 2px solid #e2e8f0; 
        padding: 10px 15px; 
        text-transform: uppercase;
    }
    .inner-table tbody td { 
        font-size: 12px; 
        padding: 10px 15px; 
        border-bottom: 1px solid #f1f5f9; 
        color: #475569; 
    }
    
    .table-footer-note { 
        padding: 10px 25px; 
        font-size: 12px; 
        color: #64748b; 
        background: #fff; 
        border-top: 1px solid #f1f5f9; 
        display: flex; 
        align-items: center; 
        gap: 8px; 
    }

    /* MODAL STYLES */
    .modal-custom .modal-header { 
        background-color: var(--hialpesa-dark); 
        color: white; 
        padding: 15px 20px; 
        border-bottom: none; 
        border-radius: 12px 12px 0 0;
    }
    .modal-custom .modal-header .close { 
        color: white; 
        opacity: 1; 
        font-size: 24px; 
    }
    .modal-custom .modal-title { 
        font-size: 16px; 
        font-weight: 700; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        color: white;
        margin: 0;
    }
    .modal-custom .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }
    .modal-custom label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .modal-custom .form-control, .modal-custom .form-select {
        border-radius: 6px;
        border-color: #cbd5e1;
        font-size: 13px;
    }
    
    .compact-swal { 
        padding: 1rem !important; 
        border-radius: 12px !important; 
    }
</style>

<div class="insumo-module-layout">

    <!-- SIDEBAR CORPORATIVO -->
    <div class="insumo-sidebar">
        <div class="sidebar-header">
            <h3>HIALPESA</h3>
            <span>Control de Producción</span>
        </div>
        <ul class="sidebar-nav">
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-layer-group"></i> Agrupación de NPs</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-box"></i> Lista de Insumos</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-check-double"></i> Generar Solicitud</a></li>
            <li><a href="@Url.Action("Index", "InsumoEstampado")"><i class="fas fa-receipt"></i> Voucher</a></li>
            <li><a href="@Url.Action("Mantenimiento", "InsumoEstampado")"><i class="fas fa-bars"></i> Mant. Solicitudes</a></li>
            <li><a href="@Url.Action("Index", "Proveedor")"><i class="fas fa-truck"></i> Proveedores</a></li>
            <li><a href="@Url.Action("Index", "ConsumoAdicional", new { sid = ViewBag.SessionID })"><i class="fas fa-plus-circle"></i> Consumos Producción</a></li>
            <li class="active"><a href="@Url.Action("Liquidacion_Insumos", "Home")"><i class="fas fa-calculator"></i> Liquidación Insumos</a></li>
        </ul>
    </div>

    <!-- MAIN AREA -->
    <div class="insumo-container">
        
        <!-- CABECERA -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <h1 style="font-size: 22px; font-weight: 700; color: var(--hialpesa-dark); margin: 0;">
                    <i class="fas fa-flask"></i> Liquidación de Insumos de Estampado
                </h1>
                <p style="color: #64748b; font-size: 13px; margin: 4px 0 0 0;">Control operativo de consumos, mermas y reutilización</p>
            </div>
            <button class="btn-primary-hialpesa" onclick="abrirNuevaLiquidacion()"><i class="fas fa-plus"></i> Nueva Liquidación</button>
        </div>

        <!-- CONTENEDOR TABS Y TABLAS -->
        <div class="content-box">
            
            <!-- TABS MOCKUP -->
            <div class="nav-tabs-custom">
                <a href="javascript:void(0)" class="tab-item active" id="tabLinkLiquidaciones" onclick="switchMainTab('liquidaciones')">
                    <i class="fas fa-file-alt"></i> Liquidaciones (NP/Combo)
                </a>
                <a href="javascript:void(0)" class="tab-item" id="tabLinkMermas" onclick="switchMainTab('mermas')">
                    <i class="fas fa-sync-alt"></i> Mermas Reutilizables
                </a>
            </div>

            <!-- CONTENIDO TAB 1: LIQUIDACIONES -->
            <div id="panelLiquidaciones">
                <div class="table-title">
                    <h2>Liquidaciones Activas</h2>
                    <button class="btn-outline-hialpesa" onclick="actualizarLista()" style="padding: 4px 12px; font-size: 11px;">
                        <i class="fas fa-sync"></i> Actualizar
                    </button>
                </div>
                
                <div style="overflow-x:auto;">
                    <table class="erp-table" id="tablaLiquidacionesActivas">
                        <thead>
                            <tr>
                                <th>NP</th>
                                <th>Combo</th>
                                <th>Cliente</th>
                                <th>Estilo</th>
                                <th>Estado</th>
                                <th>Fecha Creación</th>
                                <th>Fecha Cierre</th>
                                <th style="width: 320px; text-align: center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dinámico -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CONTENIDO TAB 2: MERMAS -->
            <div id="panelMermas" style="display: none;">
                <div class="table-title">
                    <h2>Inventario de Mermas (Stock secundario en producción)</h2>
                </div>
                
                <div style="overflow-x:auto;">
                    <table class="erp-table" id="tablaMermasStock">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Descripción / Color</th>
                                <th>Técnica</th>
                                <th>NP Origen</th>
                                <th>F. Generación</th>
                                <th>F. Vencimiento</th>
                                <th class="text-right">Cant. Disponible</th>
                                <th>U.M.</th>
                                <th>Estado</th>
                                <th style="text-align: center;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dinámico -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- ============================================== -->
<!-- MODALES DE CONTROL OPERATIVO (BOOTSTRAP 3) -->
<!-- ============================================== -->

<!-- 1. MODAL CONSUMO -->
<div class="modal fade modal-custom" id="consumoModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-tint"></i> Registrar Consumo Diario</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Insumo en Receta</label>
                    <select class="form-control" id="ddlConsumoInsumo">
                        <!-- Carga dinámica -->
                    </select>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Cantidad consumida (gr)</label>
                    <input type="number" class="form-control" id="txtConsumoCantidad" placeholder="0.00" step="0.01" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-hialpesa" onclick="registrarConsumo()" style="padding: 6px 18px;">Registrar</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. MODAL MERMA -->
<div class="modal fade modal-custom" id="mermaModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--hialpesa-accent);">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-sync-alt"></i> Registrar Merma</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Insumo</label>
                    <select class="form-control" id="ddlMermaInsumo">
                        <!-- Carga dinámica -->
                    </select>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Cantidad (gr) a merma</label>
                    <input type="number" class="form-control" id="txtMermaCantidad" placeholder="0.00" step="0.01" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-hialpesa" onclick="registrarMerma()" style="background-color: var(--hialpesa-accent); border-color: var(--hialpesa-accent); padding: 6px 18px;">Registrar</button>
            </div>
        </div>
    </div>
</div>

<!-- 3. MODAL INGRESO -->
<div class="modal fade modal-custom" id="ingresoModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-plus-circle"></i> Ingreso Adicional de Insumos</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7 form-group">
                        <label>Insumo</label>
                        <select class="form-control" id="ddlIngresoInsumo">
                            <!-- Carga dinámica -->
                        </select>
                    </div>
                    <div class="col-md-5 form-group">
                        <label>Cantidad adicional (gr)</label>
                        <input type="number" class="form-control" id="txtIngresoCantidad" placeholder="0.00" step="0.01" />
                    </div>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Motivo del Ingreso (Obligatorio)</label>
                    <textarea class="form-control" id="txtIngresoMotivo" rows="2" placeholder="Ej. Pérdida o merma del lote inicial..."></textarea>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-md-7 form-group">
                        <label>¿Reutilizar stock de merma?</label>
                        <select class="form-control" id="ddlIngresoReutilizarMerma">
                            <option value="">No reutilizar (Ingreso nuevo de almacén)</option>
                            <option value="MER-2405-01">MER-2405-01 (Mezcla dorado cielo - 250.00 gr)</option>
                        </select>
                    </div>
                    <div class="col-md-5 form-group">
                        <label>Fecha Vencimiento Lote</label>
                        <input type="date" class="form-control" id="txtIngresoVencimiento" value="2026-12-30" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-hialpesa" onclick="registrarIngreso()" style="padding: 6px 18px;">Registrar Ingreso</button>
            </div>
        </div>
    </div>
</div>

<!-- 4. MODAL DEVOLUCIÓN -->
<div class="modal fade modal-custom" id="devolucionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-exchange-alt"></i> Devolución al Almacén Central</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Insumo a Devolver</label>
                    <select class="form-control" id="ddlDevolucionInsumo">
                        <!-- Carga dinámica -->
                    </select>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Cantidad a retornar</label>
                    <input type="number" class="form-control" id="txtDevolucionCantidad" placeholder="No mayor al saldo disponible" step="0.01" />
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Motivo o Destino</label>
                    <select class="form-control" id="ddlDevolucionMotivo">
                        <option>Reasignación: saldo destinado a otra NP o requerimiento</option>
                        <option>Venta: saldo disponible para venta externa</option>
                        <option>Desecho: saldo no utilizable por contaminación</option>
                        <option>Uso para muestras: saldo destinado a pruebas o desarrollos</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-hialpesa" onclick="registrarDevolucion()" style="padding: 6px 18px;">Registrar</button>
            </div>
        </div>
    </div>
</div>

<!-- 5. MODAL NUEVA LIQUIDACIÓN -->
<div class="modal fade modal-custom" id="nuevaModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-file-alt"></i> Nueva Liquidación Diaria</h4>
            </div>
            <div class="modal-body">
                <div class="row" style="margin-bottom: 20px; display:flex; align-items: flex-end;">
                    <div class="col-md-4 form-group">
                        <label>Desde</label>
                        <input type="date" class="form-control input-sm" id="txtFiltroDesde" value="2026-05-01" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Hasta</label>
                        <input type="date" class="form-control input-sm" id="txtFiltroHasta" value="2026-05-20" />
                    </div>
                    <div class="col-md-4 form-group">
                        <button class="btn-primary-hialpesa" onclick="buscarNPsPendientes()" style="padding: 5px 15px; font-size:12px; width:100%; display:block; text-align:center;"><i class="fas fa-search"></i> Buscar NPs</button>
                    </div>
                </div>
                
                <table class="erp-table" id="tablaNPsPendientes">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;"><input type="checkbox" id="chkAllNPs" onclick="toggleAllNPsCheckboxes(this)" /></th>
                            <th>NP</th>
                            <th>Combo</th>
                            <th>Cliente</th>
                            <th>Estilo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Pendientes de liquidar -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-hialpesa" onclick="generarLiquidacion()" style="padding: 6px 18px;"><i class="fas fa-cogs"></i> Generar Liquidación</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script type="text/javascript">
    
    // BASE DE DATOS DE LIQUIDACIONES ACTIVAS (MOCKUP INICIAL)
    var activeLiquidations = {
        "H5668": {
            np: "H5668",
            combo: "Rojo",
            cliente: "Vince",
            estilo: "S58458",
            estado: "En proceso",
            creacion: "01/05/2026",
            cierre: "--",
            colores: [
                {
                    pantone: "White",
                    insumos: [
                        { codigo: "AX4858", nombre: "Plastizol azul", tecnica: "Plastisol", um: "gr", requerido: 60.00, entregado: 90.00, consumido: 81.00, devuelto: 5.00, merma: 4.00, saldo: 0.00, loteVenc: "Lote A / 30/11/26", trazabilidad: "Entrega inicial" }
                    ]
                },
                {
                    pantone: "Rojo fuego",
                    insumos: [
                        { codigo: "BZ7721", nombre: "Base plastisol rojo", tecnica: "Plastisol", um: "gr", requerido: 40.00, entregado: 45.00, consumido: 38.00, devuelto: 0.00, merma: 7.00, saldo: 0.00, loteVenc: "Lote B / 15/12/28", trazabilidad: "Reasignado NP H5667" }
                    ]
                }
            ]
        }
    };

    // BASE DE DATOS DE NPS PENDIENTES
    var pendingNPs = {
        "I7779": {
            np: "I7779",
            combo: "FALL NAVY",
            cliente: "FORTY SEVEN",
            estilo: "E2938",
            estado: "En proceso",
            creacion: "20/05/2026",
            cierre: "--",
            colores: [
                {
                    pantone: "Navy Blue",
                    insumos: [
                        { codigo: "NV4901", nombre: "Tinta Azul Marino", tecnica: "Plastisol", um: "gr", requerido: 120.00, entregado: 150.00, consumido: 135.00, devuelto: 10.00, merma: 5.00, saldo: 0.00, loteVenc: "Lote N / 20/05/27", trazabilidad: "Entrega inicial" }
                    ]
                }
            ]
        },
        "H5669": {
            np: "H5669",
            combo: "SPRING GREEN",
            cliente: "VINCE",
            estilo: "S58459",
            estado: "En proceso",
            creacion: "20/05/2026",
            cierre: "--",
            colores: [
                {
                    pantone: "Spring Green",
                    insumos: [
                        { codigo: "GR3882", nombre: "Base Verde Primavera", tecnica: "Al Agua", um: "gr", requerido: 80.00, entregado: 90.00, consumido: 85.00, devuelto: 2.00, merma: 3.00, saldo: 0.00, loteVenc: "Lote G / 15/06/28", trazabilidad: "Entrega inicial" }
                    ]
                }
            ]
        }
    };

    // INVENTARIO DE STOCK DE MERMAS REUTILIZABLES
    var mermasStock = [
        { codigo: "MER-2405-01", descripcion: "Mezcla dorado cielo", tecnica: "Plastisol", npOrigen: "H5668", fGeneracion: "07/05/2026", fVencimiento: "07/08/2026", cantDisponible: 250.00, um: "gr", estado: "Disponible" }
    ];

    // Variables de control de estado del UI
    var selectedNP = "";
    var currentTab = "liquidaciones";

    $(document).ready(function() {
        renderLiquidaciones();
        renderMermas();
        renderNPsPendientes();
    });

    // ── CAMBIO DE TABS PRINCIPALES ──
    function switchMainTab(tab) {
        currentTab = tab;
        $(".tab-item").removeClass("active");
        if (tab === "liquidaciones") {
            $("#tabLinkLiquidaciones").addClass("active");
            $("#panelLiquidaciones").show();
            $("#panelMermas").hide();
        } else {
            $("#tabLinkMermas").addClass("active");
            $("#panelLiquidaciones").hide();
            $("#panelMermas").show();
        }
    }

    // ── ACTUALIZAR LISTA CON SWEETALERT ──
    function actualizarLista() {
        Swal.fire({
            title: 'Sincronizando...',
            text: 'Conectando con el almacén central de Hialpesa',
            allowOutsideClick: false,
            timer: 1200,
            didOpen: () => {
                Swal.showLoading();
            }
        }).then(() => {
            renderLiquidaciones();
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Registros actualizados.',
                showConfirmButton: false,
                timer: 2000
            });
        });
    }

    // ── REDIBUJAR MONITOR DE LIQUIDACIONES ACTIVAS ──
    function renderLiquidaciones() {
        var $tbody = $("#tablaLiquidacionesActivas tbody");
        $tbody.empty();

        if (Object.keys(activeLiquidations).length === 0) {
            $tbody.append(`<tr><td colspan="8" class="text-center text-muted" style="padding: 20px;">No hay liquidaciones activas.</td></tr>`);
            return;
        }

        Object.keys(activeLiquidations).forEach(function(key) {
            var item = activeLiquidations[key];
            
            // Fila principal de NP
            var rowHtml = `<tr style="background: #fff; border-top: 2px solid #f1f5f9;">
                <td><strong>${item.np}</strong></td>
                <td>${item.combo}</td>
                <td>${item.cliente}</td>
                <td>${item.estilo}</td>
                <td><span class="badge-status">${item.estado}</span></td>
                <td>${item.creacion}</td>
                <td>${item.cierre}</td>
                <td>
                    <div class="d-flex gap-2" style="display: flex; gap: 8px; justify-content: center;">
                        <button class="btn-action-pill btn-consumo" onclick="abrirModalOperacion('${item.np}', 'consumo')"><i class="fas fa-tint"></i> Consumo</button>
                        <button class="btn-action-pill btn-merma" onclick="abrirModalOperacion('${item.np}', 'merma')"><i class="fas fa-sync-alt"></i> Merma</button>
                        <button class="btn-action-pill btn-dev" onclick="abrirModalOperacion('${item.np}', 'devolucion')"><i class="fas fa-exchange-alt"></i> Dev.</button>
                        <button class="btn-action-pill btn-ingreso" onclick="abrirModalOperacion('${item.np}', 'ingreso')"><i class="fas fa-plus-circle"></i> +Ingreso</button>
                    </div>
                </td>
            </tr>`;

            // Fila expandida de detalle
            var detailRowHtml = `<tr>
                <td colspan="8" style="padding: 0;">
                    <div class="detail-container">`;

            item.colores.forEach(function(col, cIndex) {
                detailRowHtml += `
                    <!-- GRUPO: ${col.pantone} -->
                    <div class="color-group-header" onclick="toggleColorGroupDOM(this)">
                        <i class="fas fa-chevron-down"></i> Color Pantone: <strong>${col.pantone}</strong>
                    </div>
                    <div class="color-group-content">
                        <table class="inner-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Insumo</th>
                                    <th>Técnica</th>
                                    <th>U.M.</th>
                                    <th class="text-right">Requerido</th>
                                    <th class="text-right">Entregado</th>
                                    <th class="text-right">Consumido</th>
                                    <th class="text-right">Devuelto</th>
                                    <th class="text-right">Merma</th>
                                    <th class="text-right">Saldo</th>
                                    <th>Lote / Venc.</th>
                                    <th>Trazabilidad</th>
                                </tr>
                            </thead>
                            <tbody>`;
                
                col.insumos.forEach(function(ins) {
                    // Cálculo dinámico de Saldo
                    var saldoVal = ins.entregado - ins.consumido - ins.devuelto - ins.merma;
                    if (saldoVal < 0) saldoVal = 0;

                    detailRowHtml += `<tr>
                        <td><strong>${ins.codigo}</strong></td>
                        <td>${ins.nombre}</td>
                        <td>${ins.tecnica}</td>
                        <td>${ins.um}</td>
                        <td class="text-right">${ins.requerido.toFixed(2)}</td>
                        <td class="text-right"><strong>${ins.entregado.toFixed(2)}</strong></td>
                        <td class="text-right">${ins.consumido.toFixed(2)}</td>
                        <td class="text-right">${ins.devuelto.toFixed(2)}</td>
                        <td class="text-right text-warning"><strong>${ins.merma.toFixed(2)}</strong></td>
                        <td class="text-right text-primary"><strong>${saldoVal.toFixed(2)}</strong></td>
                        <td>${ins.loteVenc}</td>
                        <td><span class="text-muted">${ins.trazabilidad}</span></td>
                    </tr>`;
                });

                detailRowHtml += `</tbody>
                        </table>
                    </div>`;
            });

            detailRowHtml += `
                        <div class="table-footer-note" style="margin-top: 10px;">
                            <i class="fas fa-info-circle text-primary"></i> <strong>Fórmula de Balance:</strong> Saldo disponible = Entregados - Consumos - Devoluciones - Mermas.
                        </div>
                    </div>
                </td>
            </tr>`;

            $tbody.append(rowHtml);
            $tbody.append(detailRowHtml);
        });
    }

    // ── REDIBUJAR INVENTARIO DE STOCK DE MERMAS ──
    function renderMermas() {
        var $tbody = $("#tablaMermasStock tbody");
        $tbody.empty();

        if (mermasStock.length === 0) {
            $tbody.append(`<tr><td colspan="10" class="text-center text-muted" style="padding: 20px;">No hay stock de mermas registradas.</td></tr>`);
            return;
        }

        mermasStock.forEach(function(item) {
            var row = `<tr>
                <td><strong>${item.codigo}</strong></td>
                <td>${item.descripcion}</td>
                <td>${item.tecnica}</td>
                <td>${item.npOrigen}</td>
                <td>${item.fGeneracion}</td>
                <td>${item.fVencimiento}</td>
                <td class="text-right"><strong>${item.cantDisponible.toFixed(2)}</strong></td>
                <td>${item.um}</td>
                <td><span class="badge-status disponible">${item.estado}</span></td>
                <td style="text-align: center;">
                    <button class="btn btn-xs btn-outline-hialpesa" onclick="usarMermaEnTaller('${item.codigo}')" style="border-color: #0ea5e9; color: #0ea5e9; font-weight: 700;">Usar</button>
                </td>
            </tr>`;
            $tbody.append(row);
        });
    }

    // ── CARGAR LISTADO DE NPS PENDIENTES EN EL MODAL NUEVA LIQUIDACIÓN ──
    function renderNPsPendientes() {
        var $tbody = $("#tablaNPsPendientes tbody");
        $tbody.empty();

        if (Object.keys(pendingNPs).length === 0) {
            $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 20px;">No se encontraron NPs pendientes para el rango de fechas.</td></tr>`);
            return;
        }

        Object.keys(pendingNPs).forEach(function(key) {
            var item = pendingNPs[key];
            var row = `<tr>
                <td style="text-align: center;">
                    <input type="checkbox" class="chk-np-pendiente" data-np="${item.np}" />
                </td>
                <td><strong>${item.np}</strong></td>
                <td>${item.combo}</td>
                <td>${item.cliente}</td>
                <td>${item.estilo}</td>
            </tr>`;
            $tbody.append(row);
        });
    }

    // ── COLLAPSE/EXPAND GRUPOS PANTONE ──
    function toggleColorGroupDOM(element) {
        $(element).toggleClass("collapsed");
        $(element).next(".color-group-content").slideToggle(200);
    }

    // ── ACCIÓN DE REUTILIZAR STOCK DE MERMA ──
    function usarMermaEnTaller(codigoMerma) {
        Swal.fire({
            title: 'Asignar Stock de Merma',
            text: `¿Desea asignar el stock del lote de merma ${codigoMerma} a una orden de producción activa?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#002D72',
            cancelButtonColor: '#cbd5e1',
            confirmButtonText: 'Sí, asignar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                // Simular paso de datos a ingreso de insumos
                abrirModalOperacion("H5668", "ingreso");
                $("#ddlIngresoReutilizarMerma").val(codigoMerma);
                switchMainTab("liquidaciones");
            }
        });
    }

    // ── APERTURA DE MODALES CON LOGICA DE CARGA DE INSUMOS DE ESA NP ──
    function abrirModalOperacion(np, tipo) {
        selectedNP = np;
        var liq = activeLiquidations[np];
        if (!liq) return;

        // Limpiar inputs
        $("#txtConsumoCantidad").val('');
        $("#txtMermaCantidad").val('');
        $("#txtIngresoCantidad").val('');
        $("#txtIngresoMotivo").val('');
        $("#txtDevolucionCantidad").val('');

        // Recolectar todos los insumos de esta NP
        var selectOptionsHtml = "";
        liq.colores.forEach(function(col) {
            col.insumos.forEach(function(ins) {
                selectOptionsHtml += `<option value="${ins.codigo}">${ins.nombre} (${col.pantone})</option>`;
            });
        });

        if (tipo === "consumo") {
            $("#ddlConsumoInsumo").html(selectOptionsHtml);
            $("#consumoModal").modal("show");
        } else if (tipo === "merma") {
            $("#ddlMermaInsumo").html(selectOptionsHtml);
            $("#mermaModal").modal("show");
        } else if (tipo === "ingreso") {
            $("#ddlIngresoInsumo").html(selectOptionsHtml);
            $("#ingresoModal").modal("show");
        } else if (tipo === "devolucion") {
            $("#ddlDevolucionInsumo").html(selectOptionsHtml);
            $("#devolucionModal").modal("show");
        }
    }

    // ── REGISTRO DE ACCIÓN: CONSUMO ──
    function registrarConsumo() {
        var codInsumo = $("#ddlConsumoInsumo").val();
        var cant = parseFloat($("#txtConsumoCantidad").val());

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }

        // Buscar insumo en base de datos local y modificar
        var insFound = findInsumoInNP(selectedNP, codInsumo);
        if (insFound) {
            insFound.consumido += cant;
            insFound.trazabilidad = "Consumo diario registrado";
            renderLiquidaciones();
            $("#consumoModal").modal("hide");
            
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Consumo diario guardado exitosamente.',
                showConfirmButton: false,
                timer: 3000
            });
        }
    }

    // ── REGISTRO DE ACCIÓN: MERMA ──
    function registrarMerma() {
        var codInsumo = $("#ddlMermaInsumo").val();
        var cant = parseFloat($("#txtMermaCantidad").val());

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#f39c12' });
            return;
        }

        var insFound = findInsumoInNP(selectedNP, codInsumo);
        if (insFound) {
            insFound.merma += cant;
            insFound.trazabilidad = "Merma de lote registrada";
            
            // Agregar al inventario de mermas stock
            var mermaId = "MER-" + new Date().getFullYear().toString().substring(2) + "05-0" + (mermasStock.length + 1);
            mermasStock.push({
                codigo: mermaId,
                descripcion: "Merma de " + insFound.nombre,
                tecnica: insFound.tecnica,
                npOrigen: selectedNP,
                fGeneracion: "Hoy",
                fVencimiento: "Dentro de 3 meses",
                cantDisponible: cant,
                um: insFound.um,
                estado: "Disponible"
            });

            renderLiquidaciones();
            renderMermas();
            $("#mermaModal").modal("hide");

            Swal.fire({
                title: '¡Merma Registrada!',
                text: `Se ha creado el lote de stock secundario ${mermaId} con ${cant.toFixed(2)} ${insFound.um}.`,
                icon: 'success',
                confirmButtonColor: '#f39c12'
            });
        }
    }

    // ── REGISTRO DE ACCIÓN: INGRESO ADICIONAL ──
    function registrarIngreso() {
        var codInsumo = $("#ddlIngresoInsumo").val();
        var cant = parseFloat($("#txtIngresoCantidad").val());
        var motivo = $("#txtIngresoMotivo").val().trim();
        var mermaReutilizada = $("#ddlIngresoReutilizarMerma").val();

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }
        if (!motivo) {
            Swal.fire({ title: 'Campo requerido', text: 'Por favor, detalle el motivo de este ingreso adicional.', icon: 'warning', confirmButtonColor: '#002D72' });
            return;
        }

        var insFound = findInsumoInNP(selectedNP, codInsumo);
        if (insFound) {
            insFound.entregado += cant;
            if (mermaReutilizada) {
                insFound.trazabilidad = "Stock de merma " + mermaReutilizada + " reincorporado";
                // Descontar del inventario de mermas
                var mIdx = mermasStock.findIndex(m => m.codigo === mermaReutilizada);
                if (mIdx !== -1) {
                    mermasStock[mIdx].cantDisponible -= cant;
                    if (mermasStock[mIdx].cantDisponible <= 0) {
                        mermasStock.splice(mIdx, 1);
                    }
                }
            } else {
                insFound.trazabilidad = "Entrega adicional de almacén: " + motivo;
            }

            renderLiquidaciones();
            renderMermas();
            $("#ingresoModal").modal("hide");

            Swal.fire({
                title: 'Ingreso Procesado',
                text: 'Las cantidades y balance se actualizaron correctamente.',
                icon: 'success',
                confirmButtonColor: '#002D72'
            });
        }
    }

    // ── REGISTRO DE ACCIÓN: DEVOLUCIÓN AL ALMACÉN ──
    function registrarDevolucion() {
        var codInsumo = $("#ddlDevolucionInsumo").val();
        var cant = parseFloat($("#txtDevolucionCantidad").val());
        var motivo = $("#ddlDevolucionMotivo").val();

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }

        var insFound = findInsumoInNP(selectedNP, codInsumo);
        if (insFound) {
            var saldo = insFound.entregado - insFound.consumido - insFound.devuelto - insFound.merma;
            if (cant > saldo) {
                Swal.fire({ title: 'Sobrepasa Saldo', text: 'La cantidad a devolver no puede exceder el saldo disponible (' + saldo.toFixed(2) + ' ' + insFound.um + ').', icon: 'error', confirmButtonColor: '#002D72' });
                return;
            }

            insFound.devuelto += cant;
            insFound.trazabilidad = "Devolución: " + motivo.split(":")[0];
            
            renderLiquidaciones();
            $("#devolucionModal").modal("hide");

            Swal.fire({
                title: 'Devolución Procesada',
                text: 'Se registraron ' + cant.toFixed(2) + ' gr retornados al almacén.',
                icon: 'success',
                confirmButtonColor: '#002D72'
            });
        }
    }

    // ── ABRIR MODAL NUEVA LIQUIDACIÓN ──
    function abrirNuevaLiquidacion() {
        $("#chkAllNPs").prop("checked", false);
        $(".chk-np-pendiente").prop("checked", false);
        $("#nuevaModal").modal("show");
    }

    // ── BUSQUEDA FILTRADA DE NPS PENDIENTES ──
    function buscarNPsPendientes() {
        Swal.fire({
            title: 'Buscando órdenes...',
            text: 'Filtrando lotes cerrados sin balance en base de datos',
            timer: 1000,
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        }).then(() => {
            renderNPsPendientes();
        });
    }

    // ── SELECCIONAR / DESELECCIONAR TODOS LOS PENDIENTES ──
    function toggleAllNPsCheckboxes(master) {
        $(".chk-np-pendiente").prop("checked", $(master).prop("checked"));
    }

    // ── GENERAR NUEVA LIQUIDACIÓN DESDE EL MODAL ──
    function generarLiquidacion() {
        var selectedKeys = [];
        $(".chk-np-pendiente:checked").each(function() {
            selectedKeys.push($(this).data("np"));
        });

        if (selectedKeys.length === 0) {
            Swal.fire({ title: 'Atención', text: 'Por favor, seleccione al menos una NP para liquidar.', icon: 'warning', confirmButtonColor: '#002D72' });
            return;
        }

        selectedKeys.forEach(function(key) {
            var npData = pendingNPs[key];
            if (npData) {
                // Mover NP a activas
                activeLiquidations[key] = npData;
                // Remover de pendientes
                delete pendingNPs[key];
            }
        });

        renderLiquidaciones();
        renderNPsPendientes();
        $("#nuevaModal").modal("hide");

        Swal.fire({
            title: 'Liquidaciones Creadas',
            text: 'Las órdenes seleccionadas fueron cargadas en la lista de liquidaciones activas.',
            icon: 'success',
            confirmButtonColor: '#002D72'
        });
    }

    // ── FUNCION AUXILIAR PARA ENCONTRAR INSUMO DENTRO DE UNA NP ──
    function findInsumoInNP(np, codInsumo) {
        var liq = activeLiquidations[np];
        if (!liq) return null;
        
        var insumoEncontrado = null;
        liq.colores.forEach(function(col) {
            col.insumos.forEach(function(ins) {
                if (ins.codigo === codInsumo) {
                    insumoEncontrado = ins;
                }
            });
        });
        return insumoEncontrado;
    }

</script>
}