@model IEnumerable<AppGenReceta.BE.LIQ_MOV_SolicitudBE>
@{
    ViewBag.Title = "Bandeja de Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string rolActual = ViewBag.RolActual ?? "";
    bool esLiquidador = (rolActual == "Liquidador" || rolActual == "Administrador");
    bool esAprobador = (rolActual == "Aprobador Insumos" || rolActual == "Aprobador Mermas" || rolActual == "Administrador");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* ESTANDARIZACION GLOBAL DE BOTONES UI/UX */
    .btn { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); z-index: 1; position: relative; }
    .table .btn:hover { transform: scale(1.05) translateY(0); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

    :root {
        --hialpesa-blue: #002D72;
        --hialpesa-accent: #f39c12;
        --bg-light: #f8f9fa;
    }

    body { background-color: var(--bg-light); }

    .table thead {
        background-color: #f4f8fa !important;
        border-top: 4px solid var(--hialpesa-blue) !important;
        border-bottom: 2px solid #DEE2E6 !important;
    }

    .table thead th {
        border: none !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        font-size: 0.95rem !important;
        letter-spacing: 0.5px;
        padding: 12px 16px !important;
        color: var(--hialpesa-blue) !important;
    }

    .table tbody tr { transition: all 0.2s; }
    .table tbody tr:hover { background-color: rgba(0, 45, 114, 0.03); }

    .btn-header-back {
        background-color: #f8f9fa;
        color: #6c757d;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 20px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

    .btn-header-back:hover {
        background-color: #e2e6ea;
        color: #495057;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        text-decoration: none;
    }

    .btn-header-new {
        background-color: var(--hialpesa-accent);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 24px;
        box-shadow: 0 4px 10px rgba(243, 156, 18, 0.2);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--hialpesa-accent);
        text-decoration: none;
        cursor: pointer;
    }

    .btn-header-new:hover, .btn-header-new:focus {
        background-color: #d68910;
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(243, 156, 18, 0.35);
        text-decoration: none;
    }

    /* Animación de pulso */
    .btn-pulse { animation: pulse-animation 2s infinite; }
    @@keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0 rgba(0, 45, 114, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(0, 45, 114, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 45, 114, 0); }
    }

    .badge-estado {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.90rem;
        font-weight: 700;
        display: inline-block;
    }
    .estado-pendiente { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .estado-aprobado { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .estado-observado { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
</style>

<div class="container-fluid py-4">

    <!-- Título y Botones de Acción -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 25px; padding: 0 10px;">
        <div style="flex: 1 1 auto; margin-bottom: 15px;">
            <h1 style="margin: 0; color: var(--hialpesa-blue); font-weight: 800; font-size: 28px; border-left: 6px solid var(--hialpesa-blue); padding-left: 15px; letter-spacing: -0.5px;">
                Bandeja de Movimientos
            </h1>
            <p style="margin: 5px 0 0 20px; color: #6c757d; font-size: 14px;">Gestión y aprobación de saldos NP, stock operativo y mermas.</p>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 15px;">
            <a href="@Url.Action("Index", "Liquidacion")" class="btn-header-back">
                <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Regresar
            </a>

            @if (esLiquidador)
            {
                <a onclick="abrirModalPedidos()" class="btn-header-new text-white" style="background-color: #002D72; border-color: #001a41;">
                    <i class="fas fa-file-invoice" style="margin-right: 8px;"></i> Movimiento Pedidos
                </a>
                <a onclick="abrirModalCrear()" class="btn-header-new btn-pulse text-white" style="background-color: #17a2b8; border-color: #117a8b; margin-left: 10px;">
                    <i class="fas fa-plus-circle" style="margin-right: 8px;"></i> Ajuste Manual
                </a>
            }
        </div>
    </div>

    <!-- Panel de Filtros -->
    <div class="panel panel-default shadow-sm mb-4" style="border: 1px solid #cbd5e1; border-left: 6px solid var(--hialpesa-blue); border-radius: 8px; background: white;">
        <div class="panel-body" style="padding: 15px;">
            <form method="get" action="@Url.Action("Index", "Movimientos")">
                <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 15px;">
                    <div style="flex: 1; min-width: 200px;">
                        <label class="font-weight-bold text-muted mb-1"><i class="fas fa-calendar-alt" style="color: var(--hialpesa-blue); margin-right: 4px;"></i> Desde</label>
                        <input type="date" class="form-control" name="start" value="@ViewBag.FechaInicio" required />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label class="font-weight-bold text-muted mb-1"><i class="fas fa-calendar-check" style="color: var(--hialpesa-blue); margin-right: 4px;"></i> Hasta</label>
                        <input type="date" class="form-control" name="end" value="@ViewBag.FechaFin" required />
                    </div>
                    <div style="flex: 0 0 auto; min-width: auto; padding-bottom: 2px;">
                        <button type="submit" class="btn btn-primary px-4 mb-0" style="border-radius: 6px; background-color: var(--hialpesa-blue); border: none;">
                            <i class="fas fa-search mr-2"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Campo de Búsqueda Global -->
    <div style="margin-bottom: 20px; max-width: 450px;">
        <div class="input-group shadow-sm" style="border-radius: 30px; overflow: hidden; border: 1px solid #dee2e6;">
            <span class="input-group-addon" style="background: white; border: none; padding-left: 15px; color: #6c757d;">
                <i class="fas fa-search"></i>
            </span>
            <input type="text" id="txtBusquedaGlobal" class="form-control" placeholder="Buscar en la tabla..."
                   style="border: none; box-shadow: none; font-size: 15px; height: 45px; padding-left: 10px;">
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div style="padding: 40px 20px; text-align:center; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; margin: 15px;">
                    <i class="fas fa-clipboard-list" style="font-size: 48px; color: #cbd5e1; margin-bottom: 15px;"></i>
                    <h4 style="color: #64748b; font-weight: 600; font-size: 16px; margin-top: 0;">Sin Movimientos</h4>
                    <p style="font-size: 13px; color: #94a3b8; margin-bottom: 0;">No se encontraron solicitudes registradas bajo los criterios de búsqueda.</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="padding: 15px;">
                    <table class="table table-hover table-bordered table-striped align-middle" id="tbMovimientos" style="width: 100%;">
                        <thead>
                            <tr>
                                <th class="text-center">N° Solicitud</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Tipo</th>
                                <th class="text-center">Generado Por</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">N° ERP</th>
                                <th class="text-center" style="width: 150px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-weight-bold text-primary">@item.IdSolicitud.ToString("D5")</td>
                                    <td class="text-center">@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@item.TipoMovimiento</td>
                                    <td class="text-center">@item.UsuarioLiquidador</td>
                                    <td class="text-center">
                                        @if (item.Estado == "Pendiente") { <span class="badge-estado estado-pendiente">Pendiente</span> }
                                        else if (item.Estado == "Aprobado") { <span class="badge-estado estado-aprobado">Aprobado</span> }
                                        else if (item.Estado == "Observado") { <span class="badge-estado estado-observado">Observado</span> }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.NumMovimientoERP))
                                        {
                                            <span class="badge bg-secondary" style="font-size: 0.90rem;">@item.NumMovimientoERP</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-primary" onclick="verDetalles(@item.IdSolicitud)" title="Ver Detalles" style="color: white; background-color: var(--hialpesa-blue); border-color: var(--hialpesa-blue);">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        @if (esAprobador && item.Estado == "Pendiente")
                                        {
                                            <button class="btn btn-sm btn-success ms-1" onclick="aprobar(@item.IdSolicitud)" title="Aprobar">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger ms-1" onclick="observar(@item.IdSolicitud)" title="Observar">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Detalles -->
<div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background-color: var(--hialpesa-blue); color: white; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom: 4px solid var(--hialpesa-accent);">
                <h5 class="modal-title" style="font-weight: 700;"><i class="fas fa-list mr-2"></i> Detalle de Solicitud</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="background-color: var(--bg-light);">
                <div class="table-responsive bg-white" style="border-radius: 8px; border: 1px solid #dee2e6;">
                    <table class="table table-hover table-striped mb-0" id="tbDetalles">
                        <thead style="background-color: #f1f5f9;">
                            <tr>
                                <th style="color: var(--hialpesa-blue);">NP / Ref</th>
                                <th style="color: var(--hialpesa-blue);">Código</th>
                                <th style="color: var(--hialpesa-blue);">Insumo</th>
                                <th style="color: var(--hialpesa-blue);">Lote</th>
                                <th class="text-right" style="color: var(--hialpesa-blue);">Cant.</th>
                                <th style="color: var(--hialpesa-blue);">UM</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="background-color: #f8f9fa;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 6px;"><i class="fas fa-times"></i> Cerrar</button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_CrearMovimiento")
@Html.Partial("_NuevoMovimientoPedidos")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            var table = $('#tbMovimientos').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json' },
                order: [[0, "desc"]],
                dom: '<"top">rt<"bottom"ilp><"clear">' // Oculta el buscador por defecto (f)
            });

            $('#txtBusquedaGlobal').on('keyup', function () {
                table.search(this.value).draw();
            });
        });

        function abrirModalCrear() {
            $('#modalCrearMovimiento').modal('show');
        }

        function verDetalles(idSolicitud) {
            $.get('@Url.Action("ObtenerDetalle", "Movimientos")', { idSolicitud: idSolicitud }, function(res) {
                if (res.success) {
                    var tbody = $('#tbDetalles tbody');
                    tbody.empty();
                    $.each(res.data, function(i, item) {
                        tbody.append('<tr>' +
                            '<td>' + (item.NP || item.CodMermaOrigen || '-') + '</td>' +
                            '<td>' + item.CodItem + '</td>' +
                            '<td>' + item.NombreItem + '</td>' +
                            '<td>' + (item.Lote || '-') + '</td>' +
                            '<td><strong>' + item.Cantidad.toFixed(4) + '</strong></td>' +
                            '<td>' + item.UM + '</td>' +
                            '</tr>');
                    });
                    $('#modalDetalle').modal('show');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }

        function aprobar(id) {
            Swal.fire({
                title: '¿Aprobar solicitud?',
                text: "Esto registrará el movimiento en el ERP Hialpesa.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, aprobar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Aprobar", "Movimientos")', { idSolicitud: id }, function(res) {
                        if(res.success) {
                            Swal.fire('¡Aprobado!', 'El movimiento se generó con el N° ERP: ' + res.numMovimiento, 'success').then(()=> location.reload());
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }

        function observar(id) {
            Swal.fire({
                title: 'Observar Solicitud',
                input: 'textarea',
                inputPlaceholder: 'Ingrese el motivo de observación...',
                showCancelButton: true,
                confirmButtonText: 'Guardar Observación',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    $.post('@Url.Action("Observar", "Movimientos")', { idSolicitud: id, observacion: result.value }, function(res) {
                        if(res.success) {
                            Swal.fire('Observado', 'La solicitud ha sido observada.', 'success').then(()=> location.reload());
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}
