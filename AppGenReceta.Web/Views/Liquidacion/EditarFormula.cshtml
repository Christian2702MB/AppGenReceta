@model AppGenReceta.BE.LIQ_FormulaBE
@{
    ViewBag.Title = "Editar Fórmula";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string rolActual = ViewBag.RolActual ?? "Visualizador";
    bool soloLectura = Model.IsReadOnly;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    /* ESTANDARIZACION GLOBAL DE BOTONES UI/UX */
    .btn { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); z-index: 1; position: relative; }
    .table .btn:hover { transform: scale(1.05) translateY(0); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

    .swal2-footer { text-align: center !important; }
    
    .select2-container { width: 100% !important; min-width: 250px; }
    .select2-container .select2-selection--single { height: 31px !important; padding-top: 2px; border: 1px solid #ccc !important; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 29px !important; }

    .col-prueba-header { background-color: #f8f9fa !important; border-bottom: 3px solid #17a2b8 !important; min-width: 130px; }
    .col-prueba-cell { background-color: #fdfdfe; }
    .prueba-elegida { background-color: #d4edda !important; border-bottom: 3px solid #28a745 !important; transition: background-color 0.3s ease; }

    .th-prueba { background-color: #f8f9fa; min-width: 85px; width: 85px; padding: 6px; }
    .td-prueba { padding: 4px 6px; }
    
    .btn-header-back { background-color: #f8f9fa; color: #6c757d; border: 1px solid #dee2e6; border-radius: 8px; font-weight: 600; padding: 10px 20px; text-decoration: none; display: inline-flex; align-items: center; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .btn-header-back:hover { background-color: #e2e6ea; color: #495057; text-decoration: none; transform: translateY(-3px); box-shadow: 0 6px 12px rgba(0,0,0,0.08); }
</style>

<div class="panel-body">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div style="flex: 1 1 auto; margin-bottom: 5px;">
            <h1 style="margin: 0; color: #002D72; font-weight: 800; font-size: 26px; border-left: 6px solid #27ae60; padding-left: 15px;">
                Editar Fórmula #@Model.IdFormula
                @if (Model.Estado == "Cerrada")
                {
                    <span class="label label-danger ml-2" style="font-size: 14px; position: relative; top: -2px;">Cerrada</span>
                }
                else if (Model.Estado == "Creada")
                {
                    <span class="label ml-2" style="background-color: #cce5ff; color: #004085; font-size: 14px; position: relative; top: -2px;">Creada</span>
                }
                else if (Model.Estado == "Activa")
                {
                    <span class="label label-success ml-2" style="font-size: 14px; position: relative; top: -2px;">Activa</span>
                }
                else if (Model.Estado == "En Proceso")
                {
                    <span class="label ml-2" style="background-color: #fff3cd; color: #856404; font-size: 14px; position: relative; top: -2px;">En Proceso</span>
                }
                else if (Model.Estado == "Pendiente")
                {
                    <span class="label label-warning ml-2" style="font-size: 14px; position: relative; top: -2px;">Pendiente</span>
                }
                else if (Model.Estado == "Liquidado")
                {
                    <span class="label ml-2" style="background-color: #d1ecf1; color: #0c5460; font-size: 14px; position: relative; top: -2px;">Liquidado</span>
                }
                else if (Model.Estado == "Terminado")
                {
                    <span class="label label-default ml-2" style="font-size: 14px; position: relative; top: -2px;">Terminado</span>
                }
                else
                {
                    <span class="label label-primary ml-2" style="font-size: 14px; position: relative; top: -2px;">@Model.Estado</span>
                }
            </h1>
            <p style="margin: 5px 0 0 20px; color: #6c757d; font-size: 14px;">
                Ajuste las cantidades de los insumos y configure las mezclas químicas según los requerimientos de planta.
            </p>
        </div>
        <a href="@Url.Action("MantenimientoFormulas", "Liquidacion")" class="btn-header-back">
            <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Regresar
        </a>
    </div>

    <form id="formFormula">
        <input type="hidden" id="hdnIdFormula" value="@Model.IdFormula" />
        <input type="hidden" id="hdnIdRecetaOrigen" value="@Model.IdRecetaOrigen" />

        <div class="panel panel-default shadow-sm">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 15px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Datos de la Cabecera</span>
                </h2>

                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Cliente</label><input type="text" class="form-control" value="@Model.Cliente" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Temporada</label><input type="text" class="form-control" value="@Model.Temporada" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Estilo Cliente</label><input type="text" class="form-control" value="@Model.Estilo" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Estilo Propio</label><input type="text" class="form-control" value="@Model.EstiloPropio" readonly /></div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Combo</label><input type="text" class="form-control" value="@Model.ComboCabecera" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Item</label><input type="text" class="form-control" value="@Model.Item" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Ubicación</label><input type="text" class="form-control" value="@Model.Ubicacion" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Arte (Opcional)</label><input type="text" class="form-control" value="@Model.Arte" readonly /></div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group">
                            <label>Fecha</label>
                            @{
                                string fechaMuestra = Model.FechaUDP;
                                DateTime parsedDate;
                                if (DateTime.TryParse(Model.FechaUDP, out parsedDate))
                                {
                                    fechaMuestra = parsedDate.ToString("dd/MM/yyyy");
                                }
                            }
                            <input type="text" class="form-control" value="@fechaMuestra" readonly />
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Muestrista</label><input type="text" class="form-control" value="@Model.Operario" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-6">
                        <div class="form-group"><label>Técnica</label><input type="text" class="form-control" value="@Model.Tecnica" readonly /></div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group"><label>NP - MV</label><input type="text" class="form-control" value="@Model.NP" readonly /></div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
                        <div class="form-group"><label>Prendas</label><input type="text" class="form-control" value="@Model.PrendasReq" readonly /></div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label>Observaciones</label>
                            <textarea id="txtObservacionesFormula" class="form-control" rows="3" placeholder="Ingrese observaciones adicionales..." style="resize: vertical;" @(soloLectura ? "readonly" : "")>@Model.Observaciones</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!soloLectura)
        {
            <div class="panel panel-warning shadow-sm">
                <div class="panel-heading" style="background-color: #fcf8e3;">
                    <strong><i class="fa fa-plus-circle"></i> Agregar Elementos</strong>
                </div>
                <div class="panel-body">
                    <div class="btn-group pull-right">
                        <button type="button" class="btn btn-warning btn-sm" id="btnHabilitarEdicion" style="margin-right: 5px; color: #fff; background-color: #f39c12; border-color: #e67e22;">
                            <i class="fa fa-edit"></i> Habilitar Edición
                        </button>
                        <button type="button" class="btn btn-info btn-sm" onclick="abrirModalPrueba()" style="margin-right: 5px;">
                            <i class="fa fa-flask"></i> Nueva Formula (Gr)
                        </button>
                    </div>
                    <div class="row" style="margin-top: 15px;">
                        <div class="col-md-12">
                            <label>Seleccionar Color a asignar Insumo:</label>
                            <div class="row">
                                <div class="col-md-3">
                                    <select id="ddlColorDestino" class="form-control"></select>
                                </div>
                                <div class="col-md-6">
                                    <select id="txtDescInsumo" class="form-control" style="background-color: #eee;" data-url-busqueda="@Url.Action("BuscarInsumosSelect2", "Home")">
                                        <option value="">Seleccione o busque un insumo...</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-success btn-block" id="btnAgregarInsumo" type="button" onclick="agregarInsumoAColor()" title="Agregar Insumo" style="height: 31px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; padding: 0 12px;">
                                        <i class="fa fa-plus"></i> Agregar Insumo
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col-sm-12">
                <h4 class="text-primary"><i class="fas fa-flask"></i> Detalle de Fórmula</h4>
                <div class="table-responsive" style="overflow-x: auto; white-space: nowrap; padding-bottom: 15px;">
                    <div id="contenedorColores"></div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    @if (!soloLectura)
                    {
                        <div class="col-xs-12 col-sm-6" style="text-align: right">
                            <button type="button" id="btnGuardarFormula" class="btn btn-primary px-4 shadow-sm" onclick="guardarFormulaCompleta()">
                                <i class="fa fa-save"></i> Actualizar
                            </button>
                        </div>
                        <div class="col-xs-12 col-sm-6" style="text-align: left">
                            <button type="button" class="btn btn-danger px-4 shadow-sm" onclick="confirmarCancelacion()">
                                <i class="fa fa-times"></i> Cancelar
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-xs-12 text-center">
                            <a class="btn btn-primary px-4 shadow-sm" href="@Url.Action("MantenimientoFormulas", "Liquidacion")">
                                <i class="fa fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>



    <!-- Modal Agregar Prueba -->
    <div class="modal fade" id="modalAgregarPrueba" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title">Ingresar Nueva Formula (Gr)</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nombre de la Formula</label>
                        <select id="txtNombrePrueba" class="form-control select2" style="width: 100%;">
                            <option value="">Escriba el nombre...</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer text-center">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="agregarColumnaPrueba()">Agregar Columna</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        window.g_isReadOnly = '@soloLectura'.toLowerCase() === 'true';
        window.idFormulaActual = @Model.IdFormula;
        window.urlGuardarFormula = "@Url.Action("GuardarFormula", "Liquidacion")";
        window.urlMantenimiento = "@Url.Action("MantenimientoFormulas", "Liquidacion")";
    </script>
    
    <script src="@Url.Content("~/Scripts/Liquidacion/EditarFormula.js")?v=@DateTime.Now.Ticks"></script>
}
