@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- MODAL HABILITAR NP (RECEPCIÓN EN BLANCO) -->
<div class="modal fade modal-custom" id="habilitarNPModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #0ea5e9;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fas fa-check-circle"></i> Habilitar NP para Control</h4>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <p style="font-size: 13px; color: #64748b; margin-bottom: 15px;">Seleccione la NP (Fórmula) que desea habilitar en el panel de Control Operativo. Esto simulará una recepción automática en blanco.</p>
                <div class="form-group">
                    <label>Buscar NP <span style="color:red">*</span></label>
                    <select class="form-control" id="ddlNPHabilitar" style="width: 100%;">
                        <option value="">Seleccione una NP...</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 12px 12px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; font-weight: 600; font-size: 13px;">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="habilitarNP()" style="background-color: #0ea5e9; border-color: #0ea5e9; border-radius: 6px; font-weight: 600; font-size: 13px;"><i class="fas fa-save"></i> Habilitar</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    
    // ── HABILITAR NP EN BLANCO ──
    function abrirModalHabilitarNP() {
        Swal.fire({ title: 'Cargando NPs...', didOpen: () => { Swal.showLoading(); } });
        
        $.get('@Url.Action("ObtenerNPsSinRecepcion", "Liquidacion")', function(res) {
            Swal.close();
            var $ddl = $("#ddlNPHabilitar");
            $ddl.empty().append('<option value="">Seleccione una NP...</option>');
            
            if(res && res.length > 0) {
                res.forEach(function(item) {
                    $ddl.append('<option value="' + item.NP + '">' + item.NP + ' - ' + (item.Cliente || 'SIN CLIENTE') + ' (' + (item.Estilo || 'SIN ESTILO') + ')</option>');
                });
            } else {
                $ddl.append('<option value="" disabled>No hay NPs pendientes de habilitar</option>');
            }
            
            // Inicializar Select2
            $ddl.select2({
                dropdownParent: $('#habilitarNPModal'),
                placeholder: 'Seleccione o busque una NP',
                allowClear: true
            });
            
            $("#habilitarNPModal").modal("show");
        }).fail(function() {
            Swal.fire('Error', 'No se pudieron cargar las NPs disponibles.', 'error');
        });
    }

    function habilitarNP() {
        var np = $("#ddlNPHabilitar").val();
        if(!np) {
            Swal.fire('Atención', 'Debe seleccionar una NP.', 'warning');
            return;
        }

        Swal.fire({
            title: 'Habilitando...',
            text: 'Registrando recepción en blanco',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        $.post('@Url.Action("HabilitarNP", "Liquidacion")', { np: np }, function(res) {
            if(res.success) {
                $("#habilitarNPModal").modal("hide");
                Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                    cargarDataInicial();
                });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        }).fail(function() {
            Swal.fire('Error', 'Problema de red al intentar habilitar.', 'error');
        });
    }
    
    // BASES DE DATOS FRONTEND (AHORA SE CARGAN VÍA AJAX)
    var activeLiquidations = {};
    var finishedLiquidations = {};
    var mermasStock = [];



    // Variables de control de estado del UI
    var selectedNP = "";
    var currentTab = "liquidaciones";

    $(document).ready(function() {
        renderNPsPendientes();
        cargarDataInicial();

        // Inicializar tooltips Bootstrap para el Stepper
        $('[data-toggle="tooltip"]').tooltip({ container: 'body' });

        // Listeners para bloqueos de inputs
        $("#chkNoMerma").change(function() {
            if($(this).is(":checked")) {
                $("#txtMermaColorCantidad").val("0.00").prop("disabled", true);
                $("#txtMermaColorVencimiento").val("").prop("disabled", true);
            } else {
                $("#txtMermaColorCantidad").val("").prop("disabled", false);
                $("#txtMermaColorVencimiento").val("").prop("disabled", false);
            }
        });

        $("#chkNoAjuste").change(function() {
            if($(this).is(":checked")) {
                $("#txtAjusteCantidad").val("0.00").prop("disabled", true);
                $("#txtAjusteMotivo").val("No existe ajuste").prop("disabled", true);
            } else {
                $("#txtAjusteCantidad").val("").prop("disabled", false);
                $("#txtAjusteMotivo").val("").prop("disabled", false);
            }
        });

        // Listener para popup Devolucion
        // Listener para popup Devolucion
        $("#ddlTipoDevolucion").change(function() {
            var tipo = $(this).val();
            var $motivo = $("#ddlMotivoDevolucion");
            $motivo.empty();
            if (tipo === "Almacén Central") {
                $motivo.append('<option value="Venta: saldo disponible para venta externa">Venta: saldo disponible para venta externa</option>');
                $motivo.append('<option value="Desecho: saldo no utilizable por contaminación">Desecho: saldo no utilizable por contaminación</option>');
            } else if (tipo === "Almacén Operativo") {
                $motivo.append('<option value="Reasignación: saldo destinado a otra NP o requerimiento">Reasignación: saldo destinado a otra NP o requerimiento</option>');
                $motivo.append('<option value="Uso para muestras: saldo destinado a pruebas o desarrollos">Uso para muestras: saldo destinado a pruebas o desarrollos</option>');
            }
        });
    });

    // ── STEPPER: ACTUALIZAR ESTADO VISUAL ──
    function actualizarStepper(estadoTexto, tipoNP) {
        // Mapeo de estado textual a numérico
        var estadoId = 1; // Default: Activo
        if (tipoNP === 'terminada') {
            estadoId = 5; // Terminado
        } else {
            var estadoLower = (estadoTexto || '').toLowerCase();
            if (estadoLower === 'activa' || estadoLower === 'activo') estadoId = 1;
            else if (estadoLower === 'en proceso') estadoId = 2;
            else if (estadoLower === 'pendiente' || estadoLower === 'pendiente de liquidación') estadoId = 3;
            else if (estadoLower === 'cerrada' || estadoLower === 'liquidado') estadoId = 4;
            else if (estadoLower === 'terminada' || estadoLower === 'terminado') estadoId = 5;
        }

        // Limpiar clases previas
        for (var i = 1; i <= 5; i++) {
            $('#step-' + i).removeClass('completed current');
        }
        for (var j = 1; j <= 4; j++) {
            var nextJ = j + 1;
            $('#line-' + j + '-' + nextJ).removeClass('filled');
        }

        // Pintar círculos completados y el actual
        for (var s = 1; s <= 5; s++) {
            if (s < estadoId) {
                $('#step-' + s).addClass('completed');
            } else if (s === estadoId) {
                $('#step-' + s).addClass('current');
            }
        }

        // Pintar líneas entre pasos completados
        for (var l = 1; l < estadoId; l++) {
            var nextL = l + 1;
            $('#line-' + l + '-' + nextL).addClass('filled');
        }

        // Gestión de visibilidad de controles de cierre global y botones individuales
        if (estadoId === 4) {
            $("#alertaCierreLiquidado").show();
            $("#headerCierreGlobal").css("display", "flex");
            $("#alertaTerminadoFase5").hide();
            $(".btn-dev").prop("disabled", false).css({"opacity": "1", "pointer-events": "auto"});
        } else if (estadoId === 5) {
            $("#alertaCierreLiquidado").hide();
            $("#headerCierreGlobal").hide();
            $("#alertaTerminadoFase5").show();
            $(".btn-dev").prop("disabled", true).css({"opacity": "0.5", "pointer-events": "none"});
            
            // Modo Solo Lectura Fase 5
            $("#detailNpState").find("input, select, button").not(".tab-item, .btn-collapse").prop("disabled", true).addClass("disabled-phase5");
        } else {
            $("#alertaCierreLiquidado").hide();
            $("#headerCierreGlobal").hide();
            $("#alertaTerminadoFase5").hide();
            $(".btn-dev").prop("disabled", true).css({"opacity": "0.5", "pointer-events": "none"});
            
            // Restaurar Controles
            $(".disabled-phase5").prop("disabled", false).removeClass("disabled-phase5");
        }

        // Renderizar botón de acción de fase
        renderBotonAccionFase(estadoId, tipoNP);
    }

    // ── MAQUINA DE ESTADOS: ACCIONES Y AUTO-AVANCE ──
    function renderBotonAccionFase(estadoId, tipoNP) {
        var $container = $("#btnAccionFaseContainer");
        $container.empty();

        if (estadoId === 1 && tipoNP !== 'terminada') {
            $container.append(`
                <button class="btn btn-sm btn-primary btn-pulse-blue" style="background-color: var(--hialpesa-blue); border-color: var(--hialpesa-blue);" onclick="avanzarEstadoNP('En Proceso', '¿Estás seguro de pasar a En Proceso?', 'Asegúrate de haber registrado todos los consumos. Esto bloqueará nuevos ingresos.')">
                    Avanzar a En Proceso <i class="fas fa-arrow-right ml-1"></i>
                </button>
            `);
        } else if (estadoId === 2 && tipoNP !== 'terminada') {
            $container.append(`
                <button class="btn btn-sm btn-warning" style="color: #fff; background-color: var(--hialpesa-accent); border-color: var(--hialpesa-accent);" onclick="solicitarLiquidacion()">
                    Solicitar Liquidación <i class="fas fa-arrow-right ml-1"></i>
                </button>
            `);
        } else if (estadoId === 3 && tipoNP !== 'terminada') {
            $container.append(`
                <button class="btn btn-sm" style="background-color: #0d9488; border-color: #0d9488; color: white; font-weight: 600;" onclick="finalizarLiquidacion()">
                    <i class="fas fa-check-circle mr-1"></i> Finalizar Liquidación
                </button>
            `);
        } else if (estadoId === 5 || tipoNP === 'terminada') {
            // Generación de Siguiente Versión / Lote Parcial
            $container.append(`
                <button type="button" class="btn btn-sm ms-3 btn-crear-version" style="background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-weight: 600; transition: all 0.2s;" data-idnp="` + selectedNP + `" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.borderColor='#94a3b8';" onmouseout="this.style.backgroundColor='#f8fafc'; this.style.borderColor='#cbd5e1';">
                    <i class="fas fa-code-branch me-1" style="color: #64748b;"></i> Dividir Lote / Crear Versión
                </button>
            `);
        }
    }

    function avanzarEstadoNP(nuevoEstado, tituloConfirm, textoConfirm) {
        Swal.fire({
            title: tituloConfirm,
            text: textoConfirm,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#002D72',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, confirmar'
        }).then((result) => {
            if (result.value) {
                Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading(); } });
                $.post('@Url.Action("AvanzarEstadoNP", "Liquidacion")', { np: selectedNP, nuevoEstado: nuevoEstado }, function (res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => { cargarDataInicial(); });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            }
        });
    }

    $(document).on('click', '.btn-crear-version', function() {
        var npOriginal = $(this).data('idnp');
        
        Swal.fire({ title: 'Verificando historial de versiones...', didOpen: () => { Swal.showLoading(); } });

        $.get('@Url.Action("PredecirSiguienteVersion", "Liquidacion")', { np: npOriginal }, function(resPrediccion) {
            Swal.close();
            var siguienteNP = resPrediccion.success ? resPrediccion.siguienteNP : (npOriginal + "-VX");

            Swal.fire({
                title: '¿Generar versión ' + siguienteNP + '?',
                html: `
                    <p style="font-size: 14px; color: #666; margin-bottom: 15px;">
                        El registro actual se conservará intacto en el historial. La nueva versión iniciará en estado <b>Activa</b>.
                    </p>
                    <div style="text-align: left;">
                        <label style="font-weight: bold; font-size: 13px; color: #333;">Motivo de la división <span style="color: red;">*</span></label>
                        <textarea id="swal-observacion-version" class="form-control" rows="3" placeholder="Ej. Material adicional solicitado por cliente..."></textarea>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0ea5e9',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, crear versión',
                cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    var obs = document.getElementById('swal-observacion-version').value.trim();
                    if (!obs) {
                        Swal.showValidationMessage('Debe ingresar un motivo u observación.');
                        return false;
                    }
                    return obs;
                }
            }).then((result) => {
            if (result.value || result.isConfirmed) {
                var observacion = result.value;
                Swal.fire({ title: 'Generando versión...', didOpen: () => { Swal.showLoading(); } });
                $.post('@Url.Action("GenerarSiguienteVersion", "Liquidacion")', { np: npOriginal, observacion: observacion }, function(res) {
                    if (res.success) {
                        var nuevaNP = res.nuevaNP || (npOriginal + "-VX");
                        Swal.fire({
                            title: '¡Versión Generada!',
                            html: `
                                <p>Se ha generado exitosamente la orden <b>${nuevaNP}</b>.</p>
                                <p style="margin-top: 15px; font-size: 14px; color: #555;">¿Cómo deseas proceder con esta nueva versión?</p>
                            `,
                            icon: 'success',
                            showDenyButton: true,
                            showCancelButton: true,
                            confirmButtonColor: '#0ea5e9',
                            denyButtonColor: '#28a745',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: '<i class="fas fa-truck-loading"></i> Recibir Físico',
                            denyButtonText: '<i class="fas fa-check-circle"></i> Habilitar en Blanco',
                            cancelButtonText: 'Cerrar',
                            allowOutsideClick: false,
                            width: '500px'
                        }).then((actionResult) => {
                            if (actionResult.isConfirmed) {
                                // Opción 1: Ir a Recepción Física
                                var baseNP = nuevaNP.indexOf('-V') > -1 ? nuevaNP.substring(0, nuevaNP.indexOf('-V')) : nuevaNP;
                                window.location.href = '@Url.Action("Requerimientos", "Liquidacion")' + '?np=' + encodeURIComponent(baseNP);
                            } else if (actionResult.isDenied) {
                                // Opción 2: Habilitar NP en Blanco automáticamente
                                Swal.fire({ title: 'Habilitando orden...', didOpen: () => { Swal.showLoading(); } });
                                $.post('@Url.Action("HabilitarNP", "Liquidacion")', { np: nuevaNP }, function(resHab) {
                                    if(resHab.success) {
                                        Swal.fire('¡Éxito!', resHab.message, 'success').then(() => { cargarDataInicial(); });
                                    } else {
                                        Swal.fire('Atención', resHab.message, 'warning').then(() => { cargarDataInicial(); });
                                    }
                                }).fail(function() {
                                    Swal.fire('Error', 'No se pudo conectar con el servidor', 'error').then(() => { cargarDataInicial(); });
                                });
                            } else {
                                // Opción 3: Quedarse en la pantalla actual
                                cargarDataInicial();
                            }
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }).fail(function() {
                    Swal.fire('Error', 'No se pudo conectar con el servidor', 'error');
                });
            }
        });
        });
    });

    function solicitarLiquidacion() {
        var item = activeLiquidations[selectedNP];
        if (!item || !item.colores || item.colores.length === 0) {
            ejecutarAvanceFase3(false);
            return;
        }

        var totalColores = item.colores.length;
        var coloresConMerma = 0;

        item.colores.forEach(function(col) {
            var tieneMerma = false;
            if (col.bloqueoMerma) {
                tieneMerma = true;
            } else if (col.insumos) {
                col.insumos.forEach(function(ins) {
                    if (ins.merma > 0) tieneMerma = true;
                });
            }
            if (tieneMerma) coloresConMerma++;
        });

        if (coloresConMerma === totalColores) {
            Swal.fire({
                title: '¿Solicitar Liquidación?',
                text: 'Se procederá a cambiar el estado de la NP para el registro de ajustes.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, continuar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase3(false);
                }
            });
        } else if (coloresConMerma === 0) {
            Swal.fire({
                title: 'No se detectaron mermas',
                text: 'No ha registrado ninguna merma para los colores de esta NP. ¿Desea declarar que NO EXISTE MERMA GLOBAL y solicitar la liquidación de todos modos?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, declarar sin merma',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase3(true);
                }
            });
        } else {
            Swal.fire({
                title: 'Mermas incompletas',
                text: `Faltan ${totalColores - coloresConMerma} color(es) sin registrar mermas. ¿Desea declarar que no existen mermas para los colores restantes y solicitar la liquidación?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, autocompletar sin merma',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase3(true);
                }
            });
        }
    }

    function ejecutarAvanceFase3(hasNoMermaGlobal) {
        Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading(); } });
        $.post('@Url.Action("AvanzarEstadoNP", "Liquidacion")', { np: selectedNP, nuevoEstado: 'Pendiente', hasNoMermaGlobal: hasNoMermaGlobal }, function (res) {
            if (res.success) {
                Swal.fire('¡Éxito!', res.message, 'success').then(() => { cargarDataInicial(); });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        }).fail(function() { Swal.fire('Error', 'Fallo en la conexión.', 'error'); });
    }

    function finalizarLiquidacion() {
        var item = activeLiquidations[selectedNP];
        if (!item || !item.colores || item.colores.length === 0) {
            ejecutarAvanceFase4(false);
            return;
        }

        var totalInsumos = 0;
        var insumosConAjuste = 0;

        item.colores.forEach(function(col) {
            if (col.insumos) {
                col.insumos.forEach(function(ins) {
                    totalInsumos++;
                    if (ins.ajuste !== 0 || ins.bloqueoAjuste) {
                        insumosConAjuste++;
                    }
                });
            }
        });

        if (insumosConAjuste === totalInsumos) {
            Swal.fire({
                title: '¿Finalizar Liquidación?',
                text: 'Esto cerrará la NP por completo y la pasará a estado Liquidado.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, finalizar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase4(false);
                }
            });
        } else if (insumosConAjuste === 0) {
            Swal.fire({
                title: 'No se detectaron ajustes',
                text: 'No ha registrado ningún ajuste para los insumos de esta NP. ¿Desea declarar que NO EXISTEN AJUSTES GLOBALES y finalizar la liquidación de todos modos?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, declarar sin ajustes',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase4(true);
                }
            });
        } else {
            Swal.fire({
                title: 'Ajustes incompletos',
                text: `Faltan ${totalInsumos - insumosConAjuste} insumo(s) sin registrar ajustes. ¿Desea declarar que no existen ajustes para los restantes y finalizar la liquidación?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, autocompletar sin ajustes',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    ejecutarAvanceFase4(true);
                }
            });
        }
    }

    function ejecutarAvanceFase4(hasNoAjusteGlobal) {
        Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading(); } });
        $.post('@Url.Action("AvanzarEstadoNP", "Liquidacion")', { np: selectedNP, nuevoEstado: 'Liquidado', hasNoAjusteGlobal: hasNoAjusteGlobal }, function (res) {
            if (res.success) {
                Swal.fire('¡Éxito!', res.message, 'success').then(() => { cargarDataInicial(); });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        }).fail(function() { Swal.fire('Error', 'Fallo en la conexión.', 'error'); });
    }

    function terminarNPGlobal() {
        var liq = activeLiquidations[selectedNP];
        if (!liq) return;

        var haySaldos = false;
        liq.colores.forEach(function(col) {
            col.insumos.forEach(function(ins) {
                var saldoLiquidar = ins.stockRecibido - ins.consumidoSolicitud - (ins.ajusteSolicitud || 0) - (ins.devueltoCentral || 0) - (ins.devueltoOperativo || 0);
                if (saldoLiquidar > 0) {
                    haySaldos = true;
                }
            });
        });

        if (!haySaldos) {
            // Escenario A: Todo en cero
            Swal.fire({
                title: '¿Estás seguro de Terminar la NP?',
                text: 'Todos los saldos han sido procesados. Esta acción cerrará la liquidación permanentemente.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, confirmar'
            }).then((result) => {
                if (result.value) {
                    Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading(); } });
                    $.post('@Url.Action("TerminarNP", "Liquidacion")', { np: selectedNP, destinoGlobal: "" }, function (res) {
                        if (res.success) {
                            Swal.fire('¡Éxito!', res.message, 'success').then(() => { cargarDataInicial(); });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        } else {
            // Escenario B: Saldos Pendientes (Cierre Masivo Automático)
            Swal.fire({
                title: 'Detectamos saldos pendientes a liquidar',
                text: 'Selecciona el destino para procesar la devolución global y automática de todos los saldos remanentes antes de cerrar la NP:',
                icon: 'info',
                input: 'radio',
                inputOptions: {
                    'Almacén Central': 'Enviar al Almacén Central',
                    'Almacén Operativo': 'Enviar al Almacén Operativo'
                },
                inputValidator: (value) => {
                    if (!value) {
                        return 'Debes seleccionar un almacén de destino';
                    }
                },
                showCancelButton: true,
                confirmButtonColor: '#002D72',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Procesar y Terminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.value) {
                    var destinoGlobal = result.value;
                    Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading(); } });
                    $.post('@Url.Action("TerminarNP", "Liquidacion")', { np: selectedNP, destinoGlobal: destinoGlobal }, function (res) {
                        if (res.success) {
                            Swal.fire('¡Éxito!', res.message, 'success').then(() => { cargarDataInicial(); });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    }

    // ── CARGA ASÍNCRONA DESDE EL BACKEND ──
    function cargarDataInicial() {
        // 1. Cargar Activas
        $.get('@Url.Action("ObtenerLiquidacionesConsolidadas", "Liquidacion")?estado=Activa', function(data) {
            activeLiquidations = mapearLiquidaciones(data);
            
            // 2. Cargar Terminadas
            $.get('@Url.Action("ObtenerLiquidacionesConsolidadas", "Liquidacion")?estado=Cerrada', function(dataCerradas) {
                finishedLiquidations = mapearLiquidaciones(dataCerradas);
                
                // 3. Cargar Mermas
                $.get('@Url.Action("ObtenerMermasStock", "Liquidacion")', function(mermasData) {
                    mermasStock = mermasData.map(m => ({
                        codigo: m.Codigo, descripcion: m.Descripcion, tecnica: m.Tecnica, npOrigen: m.NPOrigen, 
                        fGeneracion: m.FechaGeneracion, fVencimiento: m.FechaVencimiento, cantDisponible: m.CantidadDisponible, 
                        um: m.UM, estado: m.Estado
                    }));

                    // Render UI Completa
                    renderSidebarNPs();
                    renderMermas();
                    
                    if (selectedNP) {
                        var isTerminada = finishedLiquidations[selectedNP] != null;
                        selectNP(selectedNP, isTerminada ? 'terminada' : 'activa', true);
                    } else {
                        let firstKey = Object.keys(activeLiquidations)[0];
                        if(firstKey) selectNP(firstKey, 'activa', false);
                    }
                });
            });
        });
    }

    function mapearLiquidaciones(datosBackend) {
        var dict = {};
        if (datosBackend && datosBackend.length) {
            datosBackend.forEach(function(item) {
                dict[item.NP] = {
                    np: item.NP, cliente: item.Cliente, estilo: item.Estilo, temporada: item.Temporada, estiloPropio: item.EstiloPropio,
                    estado: item.Estado, creacion: item.Creacion, cierre: item.Cierre,
                    colores: item.Colores.map(c => ({
                        pantone: c.Pantone,
                        bloqueoMerma: c.BloqueoMerma,
                        insumos: c.Insumos.map(i => ({
                            codigo: i.Codigo, nombre: i.Nombre, tecnica: i.Tecnica, um: i.UM,
                            requerido: i.Requerido, consumido: i.Consumido,
                            consumidoInicial: i.ConsumidoInicial, consumidoSolicitud: i.ConsumidoSolicitud, ajusteSolicitud: i.AjusteSolicitud,
                            devuelto: i.Devuelto, merma: i.Merma, ajuste: i.Ajuste, saldo: i.Saldo, 
                            loteVenc: i.LoteVenc, trazabilidad: i.Trazabilidad,
                            stockRecibido: i.StockRecibido,
                            stockOperativo: i.StockOperativo,
                            devueltoCentral: i.DevueltoCentral || 0,
                            devueltoOperativo: i.DevueltoOperativo || 0,
                            bloqueoAjuste: i.BloqueoAjuste,
                            stockTotal: i.StockTotal || 0,
                            consumidoTotal: i.ConsumidoTotal || 0,
                            ajusteInicial: i.AjusteInicial || 0,
                            ajusteTotal: i.AjusteTotal || 0,
                            saldoInicial: i.SaldoInicial || 0,
                            saldoSolicitud: i.SaldoSolicitud || 0,
                            saldoTotal: i.SaldoTotal || 0
                        }))
                    }))
                };
            });
        }
        return dict;
    }

    // ── CAMBIO DE TABS PRINCIPALES ──
    function switchMainTab(tab) {
        currentTab = tab;
        $(".tab-item").removeClass("active");
        $(".tab-content-panel").hide();

        if (tab === "liquidaciones") {
            $("#tabLinkLiquidaciones").addClass("active");
            $("#panelLiquidaciones").show();
        } else if (tab === "mermas") {
            $("#tabLinkMermas").addClass("active");
            $("#panelMermas").show();
        } else if (tab === "tratamiento") {
            $("#tabLinkTratamiento").addClass("active");
            $("#panelTratamiento").show();
        }
    }

    // ── COLLAPSE SIDEBAR ──
    function toggleSidebar() {
        $("#npSidebar").toggleClass("collapsed");
    }

    // ── REDIBUJAR SIDEBAR (MASTER LIST) ──
    function renderSidebarNPs() {
        var $containerActivas = $("#listaNPsContainer");
        var $containerTerminadas = $("#listaNPsTerminadasContainer");
        $containerActivas.empty();
        $containerTerminadas.empty();

        // 1. Activas
        var keysActivas = Object.keys(activeLiquidations);
        if (keysActivas.length === 0) {
            $containerActivas.append(`<div class="text-center text-muted" style="padding: 20px; font-size: 12px;">No hay NPs activas.</div>`);
        } else {
            keysActivas.forEach(function(key) {
                var item = activeLiquidations[key];
                var activeClass = (selectedNP === key) ? "active" : "";
                
                var cardHtml = `
                <div class="np-item ${activeClass}" onclick="selectNP('${key}', 'activa')" id="np-item-${key}">
                    <div class="np-item-icon"><i class="fas fa-file-invoice"></i></div>
                    <div class="np-text">
                        <div class="np-code">${item.np}</div>
                        <div class="np-sub">${item.cliente} - ${item.estilo} (${item.estiloPropio || ''})</div>
                    </div>
                </div>`;
                
                $containerActivas.append(cardHtml);
            });
        }

        // 2. Terminadas
        var keysTerminadas = Object.keys(finishedLiquidations);
        if (keysTerminadas.length === 0) {
            $containerTerminadas.append(`<div class="text-center text-muted" style="padding: 20px; font-size: 12px;">No hay NPs terminadas.</div>`);
        } else {
            keysTerminadas.forEach(function(key) {
                var item = finishedLiquidations[key];
                var activeClass = (selectedNP === key) ? "active" : "";
                
                var cardHtml = `
                <div class="np-item ${activeClass}" onclick="selectNP('${key}', 'terminada')" id="np-item-${key}" style="opacity: 0.7;">
                    <div class="np-item-icon" style="background: #cbd5e1;"><i class="fas fa-archive"></i></div>
                    <div class="np-text">
                        <div class="np-code">${item.np}</div>
                        <div class="np-sub">${item.cliente} - Cerrado: ${item.cierre} (${item.estiloPropio || ''})</div>
                    </div>
                </div>`;
                
                $containerTerminadas.append(cardHtml);
            });
        }
    }

    // ── BUSCADOR SIDEBAR ──
    function filtrarSidebar() {
        var texto = $("#txtBuscarSidebar").val().toLowerCase();
        $(".np-item").each(function() {
            var npText = $(this).text().toLowerCase();
            if (npText.indexOf(texto) > -1) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }

    // ── SELECCIONAR NP Y REDIBUJAR DETALLE (DETAIL VIEW) ──
    function selectNP(np, tipo = 'activa', keepCurrentTab = false) {
        selectedNP = np;
        
        // Actualizar UI del Sidebar
        $(".np-item").removeClass("active");
        $(`#np-item-${np}`).addClass("active");
        
        var item = (tipo === 'activa') ? activeLiquidations[np] : finishedLiquidations[np];

        // Si no hay NP seleccionado
        if (!item) {
            $("#noNpSelectedState").show();
            $("#detailNpState").hide();
            $("#globalStepperContainer").hide();
            return;
        }

        $("#lblDetailNP").text(item.np);
        $("#lblDetailCliente").text(item.cliente);
        $("#lblDetailTemporada").text(item.temporada);
        var estilosCombo = [];
        if (item.estilo) estilosCombo.push(item.estilo);
        if (item.estiloPropio) estilosCombo.push(item.estiloPropio);
        $("#lblDetailEstilos").text(estilosCombo.join(' / ') || '-');
        $("#lblDetailEstado").text(item.estado);

        if (item.estado === 'Terminado') {
            $("#thAccionCierre").hide();
        } else {
            $("#thAccionCierre").show();
        }

        // Pestañas Inteligentes: Determinar estado base
        var estId = 1;
        var estadoLower = (item.estado || '').toLowerCase();
        if (estadoLower === 'en proceso') estId = 2;
        else if (estadoLower === 'pendiente' || estadoLower === 'pendiente de liquidación') estId = 3;
        else if (estadoLower === 'cerrada' || estadoLower === 'liquidado') estId = 4;
        else if (estadoLower === 'terminada' || estadoLower === 'terminado') estId = 5;

        // Deshabilitar Mermas en Activo (1)
        if (estId < 2) {
            $("#tabLinkMermas").css({"opacity": "0.5", "pointer-events": "none"}).attr("title", "Disponible en fase En Proceso");
        } else {
            $("#tabLinkMermas").css({"opacity": "1", "pointer-events": "auto"}).removeAttr("title");
        }

        // Deshabilitar Tratamiento Saldos en Activo, En Proceso y Pendiente (1, 2, 3)
        if (estId < 4) {
            $("#tabLinkTratamiento").css({"opacity": "0.5", "pointer-events": "none"}).attr("title", "Disponible en fase Liquidado");
        } else {
            $("#tabLinkTratamiento").css({"opacity": "1", "pointer-events": "auto"}).removeAttr("title");
        }

        // Volver a la pestaña principal si cambiamos manualmente de NP o si pasó a Terminado automáticamente
        if (!keepCurrentTab || estId === 5) {
            switchMainTab("liquidaciones");
        }

        // Actualizar Stepper de Progreso
        actualizarStepper(item.estado, tipo);

        // Renderizar Mermas para que los botones reaccionen a la fase de la NP actual
        renderMermas();

        // Dibujar Colores y Tabla interior
        var $coloresContainer = $("#coloresDetailContainer");
        $coloresContainer.empty();
        
        var $saldosTbody = $("#tablaTratamientoSaldos tbody");
        $saldosTbody.empty();
        $("#lblSaldosNP").text(item.np);

        if(!item.colores || item.colores.length === 0) {
            $coloresContainer.append(`
                <div style="padding: 40px 20px; text-align:center; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; margin-top: 15px;">
                    <i class="fas fa-box-open" style="font-size: 48px; color: #cbd5e1; margin-bottom: 15px;"></i>
                    <h4 style="color: #64748b; font-weight: 600; font-size: 16px; margin-top: 0;">Sin Insumos Registrados</h4>
                    <p style="font-size: 13px; color: #94a3b8; margin-bottom: 0;">No se encontraron insumos asociados a esta Orden de Producción.</p>
                </div>
            `);
            $saldosTbody.append(`
                <tr>
                    <td colspan="9" class="text-center" style="padding: 40px;">
                        <i class="fas fa-check-double" style="font-size: 40px; color: #cbd5e1; margin-bottom: 15px;"></i>
                        <h4 style="color: #64748b; font-weight: 600; font-size: 14px; margin-top: 0;">No hay saldos pendientes</h4>
                        <p style="font-size: 12px; color: #94a3b8; margin-bottom: 0;">Todos los insumos han sido liquidados o no hay saldos a tratar en esta etapa.</p>
                    </td>
                </tr>
            `);
        } else {
            var haySaldos = false;

            item.colores.forEach(function(col) {
                var colorHtml = `
                    <div class="color-group-header">
                        <div style="flex: 1;" onclick="toggleColorGroupDOM(this.parentNode)">
                            <i class="fas fa-palette" style="color: var(--hialpesa-blue);"></i> Color Pantone: <strong>${col.pantone}</strong>
                            <i class="fas fa-chevron-down" style="margin-left: 10px;"></i>
                        </div>
                        <div style="margin-left: auto;">
                            ${(function() {
                                if (tipo !== 'activa') return '';
                                var estadoLower = (item.estado || '').toLowerCase();
                                var estId = 1;
                                if (estadoLower === 'en proceso') estId = 2;
                                else if (estadoLower === 'pendiente' || estadoLower === 'pendiente de liquidación') estId = 3;
                                else if (estadoLower === 'cerrada' || estadoLower === 'liquidado') estId = 4;
                                
                                var disableMerma = (estId !== 2 || col.bloqueoMerma) ? 'disabled="disabled"' : '';
                                var titleMerma = col.bloqueoMerma ? 'Merma bloqueada (No existe)' : 'Registrar Merma para el Color';
                                if (estId !== 2) titleMerma = 'Solo permitido en Fase En Proceso';

                                return `<button class="btn btn-xs btn-warning ${disableMerma ? 'disabled' : ''}" style="font-size:11px; padding:4px 8px; color: #fff; background-color: var(--hialpesa-accent); border-color: var(--hialpesa-accent);" onclick="abrirModalMermaColor('${item.np}', '${col.pantone}')" title="${titleMerma}" ${disableMerma}><i class="fas fa-sync-alt"></i> Merma</button>`;
                            })()}
                        </div>
                    </div>
                    <div class="color-group-content">
                        <div class="inner-table-wrapper">
                            <table class="inner-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Insumo</th>
                                        <th>U.M.</th>
                                        <!-- <th class="text-center">Req.</th> -->
                                        <th class="text-center">Stock Inicial</th>
                                        <th class="text-center">Consumido</th>
                                        <!-- <th class="text-center">Devuelto</th> -->
                                        <!-- <th class="text-center">Merma</th> -->
                                        <th class="text-center">Ajuste</th>
                                        <th class="text-center">Saldo</th>
                                        ${(item.estado === 'Terminado') ? '' : '<th style="text-align: center; width: 220px;">Acciones Operativas</th>'}
                                    </tr>
                                </thead>
                                <tbody>`;
                
                col.insumos.forEach(function(ins) {
                    var stockInicialTotal = (ins.stockOperativo || 0) + (ins.stockRecibido || 0);
                    var saldoVal = stockInicialTotal - ins.consumido - (ins.ajuste || 0);
                    if (saldoVal < 0) saldoVal = 0;

                    // Si la NP no está cerrada, mostrar botones operativos por fila
                    var accionesHtml = "";
                    if (tipo === 'activa') {
                        // Derivar estadoId localmente para renderizado condicional de botones
                        var estadoLower = (item.estado || '').toLowerCase();
                        var estId = 1;
                        if (estadoLower === 'en proceso') estId = 2;
                        else if (estadoLower === 'pendiente' || estadoLower === 'pendiente de liquidación') estId = 3;
                        else if (estadoLower === 'cerrada' || estadoLower === 'liquidado') estId = 4;

                        var disableConsumo = estId !== 1 ? 'disabled="disabled"' : '';
                        var disableAjuste = (estId !== 3 || ins.bloqueoAjuste) ? 'disabled="disabled"' : '';
                        var hideIngreso = estId !== 1 ? 'display: none;' : '';

                        var titleAjuste = ins.bloqueoAjuste ? 'Ajuste bloqueado (No existe)' : 'Ajuste de Saldo';
                        if (estId !== 3) titleAjuste = 'Solo permitido en Fase Pendiente';

                        var titleConsumo = estId !== 1 ? 'Solo permitido en Fase Activa' : 'Registrar Consumo';

                        accionesHtml = `
