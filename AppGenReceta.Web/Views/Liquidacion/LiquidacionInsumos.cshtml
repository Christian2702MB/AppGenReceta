    // ── ACCIÓN DE REUTILIZAR STOCK DE MERMA ──
    function usarMermaEnTaller(codigoMerma) {
        if(!selectedNP) {
            Swal.fire('Atención', 'Seleccione primero una NP en el panel lateral.', 'warning');
            switchMainTab("liquidaciones");
            return;
        }
        Swal.fire({
            title: 'Asignar Stock de Merma',
            text: `¿Desea asignar el stock del lote de merma ${codigoMerma} a la orden de producción actual (${selectedNP})?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#002D72',
            cancelButtonColor: '#cbd5e1',
            confirmButtonText: 'Sí, asignar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                // Simular paso de datos a ingreso de insumos
                abrirModalOperacion(selectedNP, "ingreso");
                $("#ddlIngresoReutilizarMerma").val(codigoMerma);
                switchMainTab("liquidaciones");
            }
        });
    }

    function abrirModalOperacion(np, codInsumo, tipo, pantoneName = null) {
        selectedNP = np;
        var liq = activeLiquidations[np] || finishedLiquidations[np];
        if (!liq) return;
        
        // Guardar color temporalmente para operaciones que lo requieran
        $("#consumoModal").data("color", pantoneName);
        $("#ajusteModal").data("color", pantoneName);
        $("#ingresoModal").data("color", pantoneName);
        $("#devolucionModal").data("color", pantoneName);

        // Limpiar inputs
        $("#txtConsumoCantidad").val('');
        $("#txtMermaCantidad").val('');
        $("#txtIngresoCantidad").val('');
        $("#txtIngresoMotivo").val('');
        $("#txtDevolucionCantidad").val('');

        // Recolectar insumos para mostrar
        var selectOptionsHtml = "";
        liq.colores.forEach(function(col) {
            col.insumos.forEach(function(ins) {
                // Si pasamos el código del insumo, auto-seleccionarlo y deshabilitar para obligar la acción por fila
                var isSelected = (ins.codigo === codInsumo) ? "selected" : "";
                selectOptionsHtml += `<option value="${ins.codigo}" ${isSelected}>${ins.nombre} (${col.pantone})</option>`;
            });
        });

        if (tipo === "consumo") {
            $("#txtSaldoInicial").val("Cargando...");
            $("#txtSaldoSolicitud").val("Cargando...");
            $("#txtSaldoTotal").val("Cargando...");
            $("input[name='optFuenteConsumo'][value='Stock Inicial']").prop("checked", true);
            
            $("#tbodyHistorialConsumo").html('<tr><td colspan="4" class="text-center">Cargando historial...</td></tr>');
            
            $.get('@Url.Action("ObtenerSaldosInsumo", "Liquidacion")?np=' + selectedNP + '&codInsumo=' + codInsumo, function(response) {
                if (response && !response.error) {
                    $("#txtSaldoInicial").val(response.StockInicial.toFixed(2));
                    $("#txtSaldoSolicitud").val(response.StockSolicitud.toFixed(2));
                    $("#txtSaldoTotal").val(response.StockTotal.toFixed(2));
                    
                    var $tbody = $("#tbodyHistorialConsumo");
                    $tbody.empty();
                    if (response.HistorialConsumo && response.HistorialConsumo.length > 0) {
                        response.HistorialConsumo.forEach(function(op) {
                            $tbody.append(`
                                <tr>
                                    <td>${op.Fecha}</td>
                                    <td>${op.Usuario}</td>
                                    <td>${op.Fuente}</td>
                                    <td class="text-right text-primary"><strong>${op.Cantidad.toFixed(2)}</strong></td>
                                </tr>
                            `);
                        });
                    } else {
                        $tbody.append('<tr><td colspan="4" class="text-center text-muted" style="padding:15px;">No hay consumos registrados</td></tr>');
                    }
                } else {
                    $("#txtSaldoInicial").val("0.00");
                    $("#txtSaldoSolicitud").val("0.00");
                    $("#txtSaldoTotal").val("0.00");
                    $("#tbodyHistorialConsumo").html('<tr><td colspan="4" class="text-center text-danger">Error al cargar historial</td></tr>');
                    console.error("Error obteniendo stock:", response.error);
                }
            });

            $("#ddlConsumoInsumo").html(selectOptionsHtml).prop("disabled", true);
            $("#consumoModal").modal("show");
            setTimeout(function() { $("#txtConsumoCantidad").focus(); }, 400);
        } else if (tipo === "merma") {
            // Ya no aplica desde aqui, merma es por color
        } else if (tipo === "ingreso") {
            $("#ddlIngresoInsumo").html(selectOptionsHtml).prop("disabled", true);
            $("#ingresoModal").modal("show");
            setTimeout(function() { $("#txtIngresoCantidad").focus(); }, 400);
        } else if (tipo === "devolucion") {
            var saldoDevolucion = arguments.length > 4 ? arguments[4] : null;
            $("#txtDevolucionCantidad").val(saldoDevolucion !== null ? saldoDevolucion.toFixed(2) : '');
            $("#ddlTipoDevolucion").prop("disabled", false).val($("#ddlTipoDevolucion option:first").val());
            $("#ddlDevolucionInsumo").html(selectOptionsHtml).prop("disabled", true);
            
            cargarHistoricoDevoluciones(np, codInsumo);

            $("#devolucionModal").modal("show");
            setTimeout(function() { $("#txtDevolucionCantidad").focus(); }, 400);
        } else if (tipo === "ajuste") {
            $("#txtAjusteSaldoInicial").val("Cargando...");
            $("#txtAjusteSaldoSolicitud").val("Cargando...");
            $("#txtAjusteSaldoTotal").val("Cargando...");
            $("input[name='optFuenteAjuste'][value='Stock Inicial']").prop("checked", true);

            $("#txtAjusteCantidad").val('').prop("disabled", false);
            $("#txtAjusteMotivo").val('').prop("disabled", false);
            $("#chkNoAjuste").prop("checked", false);
            $("#ddlAjusteInsumo").html(selectOptionsHtml).prop("disabled", true);
            
            $.get('@Url.Action("ObtenerSaldosInsumo", "Liquidacion")?np=' + np + '&codInsumo=' + codInsumo, function(response) {
                if (response && !response.error) {
                    $("#txtAjusteSaldoInicial").val(response.StockInicial.toFixed(2));
                    $("#txtAjusteSaldoSolicitud").val(response.StockSolicitud.toFixed(2));
                    $("#txtAjusteSaldoTotal").val(response.StockTotal.toFixed(2));
                } else {
                    $("#txtAjusteSaldoInicial").val("0.00");
                    $("#txtAjusteSaldoSolicitud").val("0.00");
                    $("#txtAjusteSaldoTotal").val("0.00");
                    console.error("Error obteniendo stock ajuste:", response.error);
                }
            });

            cargarHistoricoAjustes(np, codInsumo);
            
            $("#ajusteModal").modal("show");
            setTimeout(function() { $("#txtAjusteCantidad").focus(); }, 400);
        }
    }

    function abrirModalMermaColor(np, pantoneDesc) {
        selectedNP = np;
        $("#hdnMermaColorPantone").val(pantoneDesc);
