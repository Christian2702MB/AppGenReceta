        if(!selectedNP) {
            Swal.fire('Atención', 'Seleccione primero una NP en el panel lateral.', 'warning');
            switchMainTab("liquidaciones");
            return;
        }
        Swal.fire({
            title: 'Asignar Stock de Merma',
            text: `¿Desea asignar el stock del lote de merma ${codigoMerma} a la orden de producción actual (${selectedNP})?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#002D72',
            cancelButtonColor: '#cbd5e1',
            confirmButtonText: 'Sí, asignar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
