                            <button class="btn btn-xs ${disableAjuste ? 'disabled' : ''}" style="font-size:11px; padding:4px 8px; margin-right: 4px; background-color: #0d9488; border-color: #0d9488; color: white;" onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'ajuste', '${col.pantone}')" title="${titleAjuste}" ${disableAjuste}><i class="fas fa-sliders-h"></i> Ajuste</button>
                            <button class="btn btn-xs btn-info" style="font-size:11px; padding:4px 8px; background-color: #0ea5e9; border-color: #0ea5e9; color: #fff; display: none !important;" onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'ingreso', '${col.pantone}')" title="Ingreso Adicional"><i class="fas fa-plus"></i></button>
                        `;
                    }

                    colorHtml += `<tr>
                        <td><strong>${ins.codigo}</strong></td>
                        <td>${ins.nombre}</td>
                        <td>${ins.um}</td>
                        <!-- <td class="text-right">${ins.requerido.toFixed(2)}</td> -->
                        <td style="vertical-align: middle;">
                            <div style="font-weight: bold; color: #475569; font-size: 14px; text-align: right; margin-bottom: 2px;">${ins.stockTotal.toFixed(2)}</div>
                            <div class="text-muted" style="font-size: 10.3px; text-align: right; line-height: 1.2;">
                                <div><span style="opacity: 0.75;">Ini:</span> ${(ins.stockOperativo || 0).toFixed(0)}</div>
                                <div><span style="opacity: 0.75;">Rec:</span> ${(ins.stockRecibido || 0).toFixed(0)}</div>
                            </div>
                        </td>
                        <td style="vertical-align: middle;">
                            <div style="font-weight: bold; color: #475569; font-size: 14px; text-align: right; margin-bottom: 2px;">${ins.consumidoTotal.toFixed(2)}</div>
                            <div class="text-muted" style="font-size: 10.3px; text-align: right; line-height: 1.2;">
                                <div><span style="opacity: 0.75;">Ini:</span> ${(ins.consumidoInicial || 0).toFixed(0)}</div>
                                <div><span style="opacity: 0.75;">Rec:</span> ${(ins.consumidoSolicitud || 0).toFixed(0)}</div>
                            </div>
                        </td>
                        <!-- <td class="text-right">${(ins.devuelto || 0).toFixed(2)}</td> -->
                        <!-- <td class="text-right text-warning"><strong>${(ins.merma || 0).toFixed(2)}</strong></td> -->
                        <td style="vertical-align: middle;">
                            <div style="font-weight: bold; color: #475569; font-size: 14px; text-align: right; margin-bottom: 2px;">${ins.ajusteTotal.toFixed(2)}</div>
                            <div class="text-muted" style="font-size: 10.3px; text-align: right; line-height: 1.2;">
                                <div><span style="opacity: 0.75;">Ini:</span> ${(ins.ajusteInicial || 0).toFixed(0)}</div>
                                <div><span style="opacity: 0.75;">Rec:</span> ${(ins.ajusteSolicitud || 0).toFixed(0)}</div>
                            </div>
                        </td>
                        <td style="vertical-align: middle;">
                            <div style="font-weight: bold; color: #475569; font-size: 14px; text-align: right; margin-bottom: 2px;">${Math.max(0, ins.saldoTotal).toFixed(2)}</div>
                            <div class="text-muted" style="font-size: 10.3px; text-align: right; line-height: 1.2;">
                                <div><span style="opacity: 0.75;">Ini:</span> ${Math.max(0, ins.saldoInicial).toFixed(0)}</div>
                                <div><span style="opacity: 0.75;">Rec:</span> ${Math.max(0, ins.saldoSolicitud).toFixed(0)}</div>
                            </div>
                        </td>
                        ${(item.estado === 'Terminado') ? '' : `<td style="text-align: center; white-space: nowrap;">${accionesHtml}</td>`}
                    </tr>`;

                    // Llenar tabla de Tratamiento de Saldos
                    var saldoLiquidar = ins.stockRecibido - ins.consumidoSolicitud - (ins.ajusteSolicitud || 0) - (ins.devueltoCentral || 0) - (ins.devueltoOperativo || 0);
                    if (saldoLiquidar > 0 || (ins.devueltoCentral || 0) > 0 || (ins.devueltoOperativo || 0) > 0) {
                        haySaldos = true;
                        var isLiquidado = (item.estado || '').toLowerCase() === 'liquidado' || (item.estado || '').toLowerCase() === 'cerrada';
                        var disabledStr = isLiquidado ? '' : 'disabled="disabled"';
                        var styleStr = isLiquidado ? '' : 'opacity: 0.5; pointer-events: none;';
                        var accionSaldo = `<button class="btn-action-pill btn-dev" style="white-space: normal; line-height: 1.1; padding: 4px 10px; margin: 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-align: left; ${styleStr}" ${disabledStr} onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'devolucion', '${col.pantone}', ${saldoLiquidar})"><i class="fas fa-exchange-alt" style="font-size: 14px;"></i> <span>Devolver<br>Saldo</span></button>`;

                        $saldosTbody.append(`
                            <tr>
                                <td class="text-center"><strong>${ins.codigo}</strong></td>
                                <td class="text-left">${ins.nombre}</td>
                                <td class="text-right">${(ins.stockRecibido || 0).toFixed(2)}</td>
                                <td class="text-right">${(ins.consumidoSolicitud || 0).toFixed(2)}</td>
                                <td class="text-right">${(ins.ajusteSolicitud || 0).toFixed(2)}</td>
                                <td class="text-right" style="color: #0ea5e9; font-size: 14px;"><strong>${saldoLiquidar.toFixed(2)}</strong></td>
                                <td class="text-right">${(ins.devueltoCentral || 0).toFixed(2)}</td>
                                <td class="text-right">${(ins.devueltoOperativo || 0).toFixed(2)}</td>
                                ${(item.estado === 'Terminado') ? '' : `<td style="text-align: center;">${accionSaldo}</td>`}
                            </tr>
                        `);
                    }
                });

                colorHtml += `  </tbody>
                            </table>
                        </div>
                    </div>`;
                $coloresContainer.append(colorHtml);
            });

            if (!haySaldos) {
                $saldosTbody.append('<tr><td colspan="8" class="text-center" style="padding:20px;">No hay saldos pendientes de tratar en esta NP.</td></tr>');
            }
        }

        $("#noNpSelectedState").hide();
        $("#detailNpState").fadeIn(200);
        $("#globalStepperContainer").fadeIn(200);
    }

    // ── REDIBUJAR INVENTARIO DE STOCK DE MERMAS ──
    function renderMermas() {
        var $tbody = $("#tablaMermasStock tbody");
        $tbody.empty();

        if (mermasStock.length === 0) {
            $tbody.append(`<tr><td colspan="9" class="text-center text-muted" style="padding: 20px;">No hay stock de mermas registradas.</td></tr>`);
            return;
        }

        // Lógica de Estado Global (Bloqueo por Fase 1 y ocultamiento por Fase 5)
        var faseInvalida = true;
        var estadoLower = '';
        if (selectedNP && activeLiquidations[selectedNP]) {
            estadoLower = (activeLiquidations[selectedNP].estado || '').toLowerCase();
            if (estadoLower === 'activa' || estadoLower === 'activo') {
                faseInvalida = false;
            }
        } else if (selectedNP && finishedLiquidations[selectedNP]) {
            estadoLower = (finishedLiquidations[selectedNP].estado || '').toLowerCase();
        }

        // La cabecera AUDITORÍA siempre debe ser visible
        $("#thAccionMerma").show();

        // Obtener fecha actual sin horas para comparar
        var hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        mermasStock.forEach(function(item) {
            // Parsear "DD/MM/YYYY"
            var partes = item.fVencimiento ? item.fVencimiento.split('/') : [];
            var fVencDate = null;
            if (partes.length === 3) {
                fVencDate = new Date(partes[2], partes[1] - 1, partes[0]);
                fVencDate.setHours(0, 0, 0, 0);
            }

            var estaVencida = false;
            if (fVencDate && fVencDate < hoy) {
                estaVencida = true;
            }

            var badgeClass = estaVencida ? "vencida" : "disponible";
            var badgeText = estaVencida ? "Vencida" : "Disponible";

            var row = `<tr>
                <td class="text-center"><strong>${item.codigo}</strong></td>
                <td>${item.descripcion}</td>
                <td class="text-center">${item.npOrigen}</td>
                <td class="text-center">${item.fGeneracion}</td>
                <td class="text-center">${item.fVencimiento}</td>
                <td class="text-right"><strong>${item.cantDisponible.toFixed(2)}</strong></td>
                <td class="text-center">${item.um}</td>
                <td class="text-center"><span class="badge-status ${badgeClass}">${badgeText}</span></td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-info" title="Ver movimientos" onclick="abrirHistorialMerma('${item.codigo}')">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>`;
            $tbody.append(row);
        });
    }

