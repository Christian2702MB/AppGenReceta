                            })()}
                        </div>
                    </div>
                    <div class="color-group-content">
                        <div class="inner-table-wrapper">
                            <table class="inner-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Insumo</th>
                                        <th>U.M.</th>
                                        <th class="text-right">Req.</th>
                                        <th class="text-right">Stock Inicial</th>
                                        <th class="text-right">Consumido</th>
                                        <!-- <th class="text-right">Devuelto</th> -->
                                        <!-- <th class="text-right">Merma</th> -->
                                        <th class="text-right">Ajuste</th>
                                        <th class="text-right">Saldo</th>
                                        ${(item.estado === 'Terminado') ? '' : '<th style="text-align: center; width: 220px;">Acciones Operativas</th>'}
                                    </tr>
                                </thead>
                                <tbody>`;
                
                col.insumos.forEach(function(ins) {
                    var stockInicialTotal = (ins.stockOperativo || 0) + (ins.stockRecibido || 0);
                    var saldoVal = stockInicialTotal - ins.consumido - (ins.ajuste || 0);
                    if (saldoVal < 0) saldoVal = 0;

                    // Si la NP no está cerrada, mostrar botones operativos por fila
                    var accionesHtml = "";
                    if (tipo === 'activa') {
                        // Derivar estadoId localmente para renderizado condicional de botones
                        var estadoLower = (item.estado || '').toLowerCase();
                        var estId = 1;
                        if (estadoLower === 'en proceso') estId = 2;
                        else if (estadoLower === 'pendiente' || estadoLower === 'pendiente de liquidación') estId = 3;
                        else if (estadoLower === 'cerrada' || estadoLower === 'liquidado') estId = 4;

                        var disableConsumo = estId !== 1 ? 'disabled="disabled"' : '';
                        var disableAjuste = (estId !== 3 || ins.bloqueoAjuste) ? 'disabled="disabled"' : '';
                        var hideIngreso = estId !== 1 ? 'display: none;' : '';

                        var titleAjuste = ins.bloqueoAjuste ? 'Ajuste bloqueado (No existe)' : 'Ajuste de Saldo';
                        if (estId !== 3) titleAjuste = 'Solo permitido en Fase Pendiente';

                        var titleConsumo = estId !== 1 ? 'Solo permitido en Fase Activa' : 'Registrar Consumo';

                        accionesHtml = `
                            <button class="btn btn-xs btn-primary-hialpesa ${estId !== 1 ? 'disabled' : ''}" style="font-size:11px; padding:4px 8px; margin-right: 4px;" onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'consumo', '${col.pantone}')" title="${titleConsumo}" ${disableConsumo}><i class="fas fa-tint"></i> Consumo</button>
                            <button class="btn btn-xs btn-success ${disableAjuste ? 'disabled' : ''}" style="font-size:11px; padding:4px 8px; margin-right: 4px;" onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'ajuste', '${col.pantone}')" title="${titleAjuste}" ${disableAjuste}><i class="fas fa-sliders-h"></i> Ajuste</button>
                            <button class="btn btn-xs btn-info" style="font-size:11px; padding:4px 8px; background-color: #0ea5e9; border-color: #0ea5e9; color: #fff; display: none !important;" onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'ingreso', '${col.pantone}')" title="Ingreso Adicional"><i class="fas fa-plus"></i></button>
                        `;
                    }

                    colorHtml += `<tr>
                        <td><strong>${ins.codigo}</strong></td>
                        <td>${ins.nombre}</td>
                        <td>${ins.um}</td>
                        <td class="text-right">${ins.requerido.toFixed(2)}</td>
                        <td class="text-right text-info"><strong>${((ins.stockOperativo || 0) + (ins.stockRecibido || 0)).toFixed(2)}</strong></td>
                        <td class="text-right">${ins.consumido.toFixed(2)}</td>
                        <!-- <td class="text-right">${ins.devuelto.toFixed(2)}</td> -->
                        <!-- <td class="text-right text-warning"><strong>${ins.merma.toFixed(2)}</strong></td> -->
                        <td class="text-right"><strong>${(ins.ajuste || 0).toFixed(2)}</strong></td>
                        <td class="text-right text-primary"><strong>${saldoVal.toFixed(2)}</strong></td>
                        ${(item.estado === 'Terminado') ? '' : `<td style="text-align: center; white-space: nowrap;">${accionesHtml}</td>`}
                    </tr>`;

                    // Llenar tabla de Tratamiento de Saldos
                    var saldoLiquidar = ins.stockRecibido - ins.consumidoSolicitud - (ins.ajusteSolicitud || 0) - (ins.devueltoCentral || 0) - (ins.devueltoOperativo || 0);
                    if (saldoLiquidar > 0 || (ins.devueltoCentral || 0) > 0 || (ins.devueltoOperativo || 0) > 0) {
                        haySaldos = true;
                        var isLiquidado = (item.estado || '').toLowerCase() === 'liquidado' || (item.estado || '').toLowerCase() === 'cerrada';
                        var disabledStr = isLiquidado ? '' : 'disabled="disabled"';
                        var styleStr = isLiquidado ? '' : 'opacity: 0.5; pointer-events: none;';
                        var accionSaldo = `<button class="btn-action-pill btn-dev" style="${styleStr}" ${disabledStr} onclick="abrirModalOperacion('${item.np}', '${ins.codigo}', 'devolucion', '${col.pantone}', ${saldoLiquidar})"><i class="fas fa-exchange-alt"></i> Devolver Saldo</button>`;

                        $saldosTbody.append(`
                            <tr>
                                <td><strong>${ins.codigo}</strong></td>
                                <td>${ins.nombre}</td>
                                <td class="text-right">${(ins.stockRecibido || 0).toFixed(2)}</td>
                                <td class="text-right text-primary" style="font-size:14px;"><strong>${saldoLiquidar.toFixed(2)}</strong></td>
                                <td class="text-right">${(ins.devueltoCentral || 0).toFixed(2)}</td>
                                <td class="text-right">${(ins.devueltoOperativo || 0).toFixed(2)}</td>
                                ${(item.estado === 'Terminado') ? '' : `<td style="text-align: center;">${accionSaldo}</td>`}
                            </tr>
                        `);
                    }
                });

                colorHtml += `  </tbody>
                            </table>
                        </div>
                    </div>`;
                $coloresContainer.append(colorHtml);
            });

            if (!haySaldos) {
                $saldosTbody.append('<tr><td colspan="8" class="text-center" style="padding:20px;">No hay saldos pendientes de tratar en esta NP.</td></tr>');
            }
        }

        $("#noNpSelectedState").hide();
        $("#detailNpState").fadeIn(200);
        $("#globalStepperContainer").fadeIn(200);
    }

    // ── REDIBUJAR INVENTARIO DE STOCK DE MERMAS ──
    function renderMermas() {
        var $tbody = $("#tablaMermasStock tbody");
        $tbody.empty();

        if (mermasStock.length === 0) {
            $tbody.append(`<tr><td colspan="9" class="text-center text-muted" style="padding: 20px;">No hay stock de mermas registradas.</td></tr>`);
            return;
        }

        // Lógica de Estado Global (Bloqueo por Fase 1 y ocultamiento por Fase 5)
        var faseInvalida = true;
        var estadoLower = '';
        if (selectedNP && activeLiquidations[selectedNP]) {
            estadoLower = (activeLiquidations[selectedNP].estado || '').toLowerCase();
            if (estadoLower === 'activa' || estadoLower === 'activo') {
                faseInvalida = false;
            }
        } else if (selectedNP && finishedLiquidations[selectedNP]) {
            estadoLower = (finishedLiquidations[selectedNP].estado || '').toLowerCase();
        }

        if (estadoLower === 'terminado') {
            $("#thAccionMerma").hide();
        } else {
            $("#thAccionMerma").show();
        }

        // Obtener fecha actual sin horas para comparar
        var hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        mermasStock.forEach(function(item) {
            // Parsear "DD/MM/YYYY"
            var partes = item.fVencimiento ? item.fVencimiento.split('/') : [];
            var fVencDate = null;
            if (partes.length === 3) {
                fVencDate = new Date(partes[2], partes[1] - 1, partes[0]);
                fVencDate.setHours(0, 0, 0, 0);
            }

            var estaVencida = false;
            if (fVencDate && fVencDate < hoy) {
                estaVencida = true;
            }

            var badgeClass = estaVencida ? "vencida" : "disponible";
            var badgeText = estaVencida ? "Vencida" : "Disponible";
            var btnText = estaVencida ? "No disponible" : "Usar";
            var isDisabled = (estaVencida || faseInvalida) ? 'disabled="disabled"' : '';
            
            var btnStyle = "font-weight: 700;";
            if (estaVencida) {
                btnStyle += " border-color: #fca5a5; color: #ef4444; opacity: 0.6; cursor: not-allowed;";
            } else if (faseInvalida) {
                btnStyle += " border-color: #94a3b8; color: #94a3b8; opacity: 0.6; cursor: not-allowed;";
            } else {
                btnStyle += " border-color: #0ea5e9; color: #0ea5e9;";
            }

            var row = `<tr>
                <td><strong>${item.codigo}</strong></td>
                <td>${item.descripcion}</td>
                <td>${item.npOrigen}</td>
                <td>${item.fGeneracion}</td>
                <td>${item.fVencimiento}</td>
                <td class="text-right"><strong>${item.cantDisponible.toFixed(2)}</strong></td>
                <td>${item.um}</td>
                <td><span class="badge-status ${badgeClass}">${badgeText}</span></td>
                ${(estadoLower === 'terminado') ? '' : `<td style="text-align: center;">
                    <button class="btn btn-xs btn-outline-hialpesa" onclick="usarMermaEnTaller('${item.codigo}')" style="${btnStyle}" ${isDisabled}>${btnText}</button>
                </td>`}
            </tr>`;
            $tbody.append(row);
        });
    }

    // ── CARGAR LISTADO DE NPS PENDIENTES EN EL MODAL NUEVA LIQUIDACIÓN (AJAX) ──
    function renderNPsPendientes(dataArray) {
        var $tbody = $("#tablaNPsPendientes tbody");
