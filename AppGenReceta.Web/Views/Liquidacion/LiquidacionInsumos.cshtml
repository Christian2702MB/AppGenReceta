@{
    ViewBag.Title = "Liquidación de Insumos - Estampado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Carga de Recursos Específicos -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    /* ESTANDARIZACION GLOBAL DE BOTONES UI/UX */
    .btn { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); z-index: 1; position: relative; }
    .table .btn:hover { transform: scale(1.05) translateY(0); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

    /* VARIABLES GLOBALES (Gold Standard de Hialpesa) */
    :root {
        --hialpesa-blue: #002D72;
        --hialpesa-dark: #002D72;
        --hialpesa-accent: #f39c12;
        --color-background-body: #f8f9fc;
        --color-border: #e2e8f0;
    }

    .btn-header-back {
        background-color: #f8f9fa;
        color: #6c757d;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 20px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

    .btn-header-back:hover {
        background-color: #e2e6ea;
        color: #495057;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        text-decoration: none;
    }

    /* BOTONES HIALPESA */
    .btn-primary-hialpesa { 
        background: var(--hialpesa-dark); 
        color: white; 
        border: 1px solid var(--hialpesa-dark); 
        padding: 10px 24px; 
        border-radius: 8px; 
        font-weight: 700; 
        font-size: 13px;
        cursor: pointer; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px; 
        box-shadow: 0 4px 6px rgba(0,45,114,0.2);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .btn-primary-hialpesa:hover {
        background: #001f52;
        color: white;
        text-decoration: none;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,45,114,0.3);
    }

    .btn-outline-hialpesa { 
        background: white; 
        border: 1px solid #cbd5e1; 
        padding: 8px 16px; 
        border-radius: 6px; 
        font-size: 13px; 
        font-weight: 600; 
        color: #475569; 
        display: inline-flex; 
        align-items: center; 
        gap: 6px; 
        cursor: pointer; 
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02); 
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .btn-outline-hialpesa:hover {
        background: #f8fafc;
        color: var(--hialpesa-dark);
        border-color: #94a3b8;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.06);
    }

    /* MASTER-DETAIL LAYOUT */
    .layout-wrapper {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        min-height: calc(100vh - 200px);
    }

    /* SIDEBAR (NPs) */
    .sidebar-container {
        width: 280px;
        background: white;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease;
        flex-shrink: 0;
        overflow: hidden;
    }
    .sidebar-container.collapsed {
        width: 64px;
    }
    .sidebar-header {
        padding: 15px;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
    }
    .sidebar-title {
        font-weight: 700;
        color: var(--hialpesa-dark);
        margin: 0;
        font-size: 14px;
        white-space: nowrap;
    }
    .btn-collapse {
        background: transparent;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 5px;
    }
    .sidebar-content {
        padding: 10px;
        overflow-y: auto;
        max-height: 600px;
    }
    .np-item {
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid transparent;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .np-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);

        border-color: #cbd5e1;
    }
    .np-item.active {
        background: var(--hialpesa-blue);
        color: white;
        border-color: var(--hialpesa-blue);
    }
    .np-item-icon {
        background: #e2e8f0;
        color: #475569;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }
    .np-item.active .np-item-icon {
        background: rgba(255,255,255,0.2);
        color: white;
    }
    .np-text {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .np-code {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 2px;
    }
    .np-sub {
        font-size: 11px;
        color: #64748b;
    }
    .np-item.active .np-sub {
        color: #cbd5e1;
    }
    
    /* COLLAPSED STATE LOGIC */
    .sidebar-container.collapsed .sidebar-title,
    .sidebar-container.collapsed .np-text {
        display: none;
    }
    .sidebar-container.collapsed .np-item {
        padding: 12px 5px;
        justify-content: center;
    }
    
    /* MAIN CONTENT */
    .main-content {
        flex: 1;
        min-width: 0; /* previene desbordamiento en flex */
        background: white;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    }

    /* PESTAÑAS PERSONALIZADAS */
    .nav-tabs-custom { 
        display: flex; 
        gap: 5px; 
        border-bottom: 1px solid #dee2e6; 
        background: #f1f5f9; 
        padding: 15px 15px 0; 
        border-radius: 12px 12px 0 0; 
    }
    
    .tab-item { 
        padding: 10px 20px; 
        font-size: 13px; 
        font-weight: 600; 
        color: #64748b; 
        text-decoration: none; 
        border-radius: 8px 8px 0 0; 
        border: 1px solid transparent; 
        border-bottom: none; 
        transition: 0.2s; 
    }
    .tab-item:hover {
        color: var(--hialpesa-dark);
        text-decoration: none;
    }
    .tab-item.active { 
        background: #fff; 
        color: var(--hialpesa-dark); 
        border-color: #dee2e6; 
        border-bottom: 2px solid #fff; 
        margin-bottom: -1px; 
    }
    .tab-item i { 
        margin-right: 8px; 
    }

    .tab-content-panel {
        padding: 20px;
    }

    /* TABLA ESTILO CORPORATIVO */
    .table-title { 
        padding-bottom: 15px; 
        border-bottom: 1px solid #f1f5f9; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 15px;
    }
    .table-title h2 { 
        font-size: 16px; 
        font-weight: 700; 
        color: var(--hialpesa-dark); 
        margin: 0; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
    }
    .table-title h2::before { 
        content: ""; 
        display: inline-block; 
        width: 4px; 
        height: 18px; 
        background-color: var(--hialpesa-dark); 
    }

    .erp-table { 
        width: 100%; 
        border-collapse: collapse; 
        margin-bottom: 0;
    }
    .erp-table thead th { 
        background-color: var(--hialpesa-dark); 
        color: #fff; 
        font-size: 10.5px; 
        font-weight: 600; 
        text-transform: uppercase; 
        padding: 12px 15px; 
        border: none; 
        letter-spacing: 0.5px; 
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .erp-table tbody td { 
        font-size: 13px; 
        padding: 12px 15px; 
        vertical-align: middle; 
        border-bottom: 1px solid #f1f5f9; 
    }

    .badge-status { 
        font-size: 11px; 
        font-weight: 700; 
        padding: 4px 12px; 
        border-radius: 20px; 
        background: #fef08a; 
        color: #854d0e; 
        white-space: nowrap;
        display: inline-block;
    }
    .badge-status.disponible { 
        background: #dcfce7; 
        color: #166534; 
    }
    .badge-status.vencida {
        background: #fee2e2;
        color: #991b1b;
    }

    /* BOTONES DE ACCIÓN PILL */
    .btn-action-pill { 
        font-size: 11px; 
        font-weight: 700; 
        padding: 4px 12px; 
        border-radius: 20px; 
        border: 1px solid #cbd5e1; 
        background: white;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
    }
    .btn-action-pill:hover { 
        background: #f8fafc; 
        text-decoration: none;
        transform: scale(1.05) translateY(0);
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .btn-action-pill.btn-consumo { border-color: var(--hialpesa-dark); color: var(--hialpesa-dark); }
    .btn-action-pill.btn-consumo:hover { background: #e0f2fe; }
    
    .btn-action-pill.btn-merma { border-color: var(--hialpesa-accent); color: var(--hialpesa-accent); }
    .btn-action-pill.btn-merma:hover { background: #fff7ed; }

    .btn-action-pill.btn-dev { border-color: #8b5cf6; color: #8b5cf6; font-weight: 600; }
    .btn-action-pill.btn-dev:hover { background: #f3e8ff; color: #7c3aed; border-color: #7c3aed; }
    
    .btn-action-pill.btn-ingreso { border-color: #0ea5e9; color: #0ea5e9; background: #f0f9ff; }
    .btn-action-pill.btn-ingreso:hover { background: #e0f2fe; }

    /* DETALLE AGRUPADO POR COLOR */
    .detail-container { 
        padding: 10px 0; 
    }
    
    .color-group-header { 
        background: #fff; 
        padding: 12px 20px; 
        font-size: 14px; 
        font-weight: 700; 
        color: #334155; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: 10px;
        cursor: pointer; 
        user-select: none; 
        transition: 0.2s;
    }
    .color-group-header:hover { 
        background: #f8fafc; 
        border-color: #cbd5e1;
    }
    .color-group-header i.fa-chevron-down { 
        color: #94a3b8; 
        font-size: 12px; 
        transition: transform 0.3s; 
        margin-left: auto;
    }
    .color-group-header.collapsed i.fa-chevron-down { 
        transform: rotate(-90deg); 
    }
    
    .inner-table-wrapper {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow-x: auto;
        overflow-y: hidden;
        margin-bottom: 15px;
    }

    .inner-table { 
        background: #fff; 
        width: 100%; 
        margin-bottom: 0; 
        border-collapse: collapse;
    }
    .inner-table thead th { 
        background: #f8fafc; 
        color: #64748b; 
        font-size: 10.5px; 
        font-weight: 700; 
        border-bottom: 1px solid #e2e8f0; 
        padding: 12px 15px; 
        text-transform: uppercase;
        text-align: center;
    }
    .inner-table tbody td { 
        font-size: 13px; 
        padding: 12px 15px; 
        border-bottom: 1px solid #f1f5f9; 
        color: #475569; 
    }
    
    /* MODAL STYLES */
    .modal-custom .modal-header { 
        background-color: var(--hialpesa-dark); 
        color: white; 
        padding: 15px 20px; 
        border-bottom: none; 
        border-radius: 12px 12px 0 0;
    }
    .modal-custom .modal-header .close { 
        color: white; 
        opacity: 1; 
        font-size: 24px; 
    }
    .modal-custom .modal-title { 
        font-size: 16px; 
        font-weight: 700; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        color: white;
        margin: 0;
    }
    .modal-custom .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }
    .modal-custom label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .modal-custom .form-control, .modal-custom .form-select {
        border-radius: 6px;
        border-color: #cbd5e1;
        font-size: 13px;
    }
    /* STEPPER DE PROGRESO */
    .liq-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px 30px;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        position: relative;
    }
    .liq-stepper-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
        flex: 0 0 auto;
    }
    .liq-stepper-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 3px solid #cbd5e1;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 800;
        color: #94a3b8;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
        position: relative;
    }
    .liq-stepper-circle:hover {
        transform: scale(1.15);
        box-shadow: 0 4px 15px rgba(0, 45, 114, 0.25);
    }
    .liq-stepper-step.completed .liq-stepper-circle {
        background: var(--hialpesa-blue, #002D72);
        border-color: var(--hialpesa-blue, #002D72);
        color: #fff;
        box-shadow: 0 3px 10px rgba(0, 45, 114, 0.3);
    }
    .liq-stepper-step.current .liq-stepper-circle {
        background: var(--hialpesa-accent, #f39c12);
        border-color: var(--hialpesa-accent, #f39c12);
        color: #fff;
        box-shadow: 0 3px 12px rgba(243, 156, 18, 0.4);
        animation: liq-pulse 2s ease-in-out infinite;
    }
    @@keyframes liq-pulse {
        0%, 100% { box-shadow: 0 3px 12px rgba(243, 156, 18, 0.4); }
        50% { box-shadow: 0 3px 20px rgba(243, 156, 18, 0.7); }
    }
    .liq-stepper-label {
        font-size: 10px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 8px;
        text-align: center;
        max-width: 100px;
        line-height: 1.3;
        transition: color 0.3s;
    }
    .liq-stepper-step.completed .liq-stepper-label {
        color: var(--hialpesa-blue, #002D72);
    }
    .liq-stepper-step.current .liq-stepper-label {
        color: var(--hialpesa-accent, #f39c12);
    }
    .liq-stepper-line {
        flex: 1;
        height: 3px;
        background: #e2e8f0;
        margin: 0 8px;
        margin-bottom: 28px;
        border-radius: 3px;
        position: relative;
        z-index: 1;
        transition: background 0.4s;
    }
    .liq-stepper-line.filled {
        background: var(--hialpesa-blue, #002D72);
    }

    /* Animación de pulso para Call To Action principal */
    .btn-pulse {
        animation: pulse-animation 2s infinite;
    }
    @@keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .btn-pulse-blue {
        animation: pulse-blue 2s infinite;
    }
    @@keyframes pulse-blue {
        0% { box-shadow: 0 0 0 0 rgba(0, 45, 114, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(0, 45, 114, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 45, 114, 0); }
    }
</style>

<div class="container-fluid py-4">

    <!-- CABECERA -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 25px; padding: 0 10px;">
        <div style="margin-bottom: 15px;">
            <h1 style="margin: 0; color: var(--hialpesa-blue); font-weight: 800; font-size: 28px; border-left: 6px solid #002D72; padding-left: 15px; letter-spacing: -0.5px;">
                Control Operativo (NPs)
            </h1>
            <p style="margin: 5px 0 0 20px; color: #6c757d; font-size: 14px;">Administre el registro diario de consumos, mermas, devoluciones<br/>y ejecute el cierre de las órdenes.</p>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 15px; justify-content: flex-end;">
            <a href="@Url.Action("Index", "Liquidacion")" class="btn-header-back">
                <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Regresar
            </a>
            <button class="btn-outline-hialpesa" onclick="abrirModalHabilitarNP()"><i class="fas fa-check-circle" style="color:#0ea5e9;"></i> Habilitar NP</button>
            <button class="btn-primary-hialpesa" onclick="abrirNuevaLiquidacion()"><i class="fas fa-plus"></i> Nuevo Movimiento</button>
        </div>
    </div>

    <!-- MASTER-DETAIL LAYOUT -->
    <div class="layout-wrapper">
        
        <!-- SIDEBAR: LISTA DE NPs (MASTER) -->
        <div class="sidebar-container" id="npSidebar">
            <div class="sidebar-header">
                <h3 class="sidebar-title">Liquidaciones Activas</h3>
                <button class="btn-collapse" onclick="toggleSidebar()" title="Colapsar panel">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <!-- BUSCADOR EN SIDEBAR -->
            <div style="padding: 10px 15px; border-bottom: 1px solid var(--color-border); background: #fff;">
                <div class="input-group" style="width: 100%;">
                    <span class="input-group-addon" style="background: transparent; border-right: none; border-radius: 20px 0 0 20px; color: #94a3b8; font-size: 11px;"><i class="fas fa-search"></i></span>
                    <input type="text" id="txtBuscarSidebar" class="form-control input-sm" placeholder="Buscar NP o Cliente..." onkeyup="filtrarSidebar()" style="border-radius: 0 20px 20px 0; border-left: none; font-size: 12px; box-shadow: none;">
                </div>
            </div>
            <!-- FIN BUSCADOR -->
            <div class="sidebar-content" id="listaNPsContainer" style="flex: 1;">
                <!-- Se inyectan las tarjetas NP dinámicamente -->
            </div>
            <div class="sidebar-header" style="border-top: 1px solid var(--color-border); background: #f1f5f9; padding: 10px 15px;">
                <h3 class="sidebar-title" style="color: #64748b; font-size: 12px;">Liquidaciones Terminadas</h3>
            </div>
            <div class="sidebar-content" id="listaNPsTerminadasContainer" style="flex: 0.8;">
                <!-- Se inyectan las NPs terminadas -->
            </div>
        </div>

        <!-- MAIN CONTENT (DETAIL & TABS) -->
        <div class="main-content">

            <div id="globalStepperContainer" style="display:none; padding: 20px 20px 0 20px;">
                <!-- STEPPER DE PROGRESO GLOBAL -->
                <div class="liq-stepper" id="stepperProgreso" style="margin-bottom: 0;">
                    <div class="liq-stepper-step" id="step-1">
                        <div class="liq-stepper-circle" data-toggle="tooltip" data-html="true" data-placement="top" title="<b>Activo:</b> Se ingresarán sólo los consumos realizados.">1</div>
                        <div class="liq-stepper-label">Activo</div>
                    </div>
                    <div class="liq-stepper-line" id="line-1-2"></div>
                    <div class="liq-stepper-step" id="step-2">
                        <div class="liq-stepper-circle" data-toggle="tooltip" data-html="true" data-placement="top" title="<b>En Proceso:</b> Se agregarán sólo las mermas en caso existan.">2</div>
                        <div class="liq-stepper-label">En Proceso</div>
                    </div>
                    <div class="liq-stepper-line" id="line-2-3"></div>
                    <div class="liq-stepper-step" id="step-3">
                        <div class="liq-stepper-circle" data-toggle="tooltip" data-html="true" data-placement="top" title="<b>Pendiente:</b> Se agregarán sólo ajustes en caso existan.">3</div>
                        <div class="liq-stepper-label">Pendiente</div>
                    </div>
                    <div class="liq-stepper-line" id="line-3-4"></div>
                    <div class="liq-stepper-step" id="step-4">
                        <div class="liq-stepper-circle" data-toggle="tooltip" data-html="true" data-placement="top" title="<b>Liquidado:</b> Se distribuirán todas las devoluciones pendientes.">4</div>
                        <div class="liq-stepper-label">Liquidado</div>
                    </div>
                    <div class="liq-stepper-line" id="line-4-5"></div>
                    <div class="liq-stepper-step" id="step-5">
                        <div class="liq-stepper-circle" data-toggle="tooltip" data-html="true" data-placement="top" title="<b>Terminado:</b> Proceso operativo cerrado. No se permiten más modificaciones.">5</div>
                        <div class="liq-stepper-label">Terminado</div>
                    </div>
                </div>
            </div>
            
            <!-- TABS MOCKUP (AHORA SON 3) -->
            <div class="nav-tabs-custom" style="margin-top: 15px;">
                <a href="javascript:void(0)" class="tab-item active" id="tabLinkLiquidaciones" onclick="switchMainTab('liquidaciones')">
                    <i class="fas fa-file-alt"></i> Liquidación de NP
                </a>
