    function cargarHistoricoMermasColor(np, pantoneDesc) {
        var $tbody = $("#tablaHistoricoMermas tbody");
        $tbody.empty();
        $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;"><i class="fas fa-spinner fa-spin"></i> Cargando historial...</td></tr>`);

        $.get('@Url.Action("ObtenerMermasPorColor", "Liquidacion")', { np: np, color: pantoneDesc }, function(data) {
            $tbody.empty();
            if(data.error) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Error al cargar historial.</td></tr>`);
            } else if (!data || data.length === 0) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;">No hay mermas registradas previamente.</td></tr>`);
            } else {
                data.forEach(function(item) {
                    var isNoMerma = item.Cantidad === 0 && item.CodigoMerma === 'NO_MERMA';
                    var stLabel = isNoMerma ? '<span class="label label-default" style="background-color:#94a3b8;">No existe merma</span>' : '<span class="label label-success" style="background-color:#10b981;">Registrado</span>';
                    var row = `<tr>
                        <td><strong>${item.CodigoMerma || '-'}</strong></td>
                        <td class="text-right">${item.Cantidad.toFixed(2)}</td>
                        <td>${item.FechaVencimiento || '-'}</td>
                        <td>${item.FechaRegistro}</td>
                        <td>${stLabel}</td>
                    </tr>`;
                    $tbody.append(row);
                });
            }
        }).fail(function() {
            $tbody.empty();
            $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Fallo de conexión al cargar el historial.</td></tr>`);
        });
    }

    function cargarHistoricoAjustes(np, codInsumo) {
        var $tbody = $("#tablaHistoricoAjustes tbody");
        $tbody.empty();
        $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;"><i class="fas fa-spinner fa-spin"></i> Cargando historial...</td></tr>`);

        $.get('@Url.Action("ObtenerAjustesPorInsumo", "Liquidacion")', { np: np, codInsumo: codInsumo }, function(data) {
            $tbody.empty();
            if(data.error) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Error al cargar historial.</td></tr>`);
            } else if (!data || data.length === 0) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;">No hay ajustes registrados previamente.</td></tr>`);
            } else {
                data.forEach(function(item) {
                    var isNoAjuste = item.Cantidad === 0 && item.Motivo === 'No existe ajuste';
                    var row = `<tr>
                        <td>${item.FechaRegistro}</td>
                        <td>${item.UsuarioRegistro}</td>
                        <td>${item.Fuente || '-'}</td>
                        <td>${item.Motivo || '-'}</td>
                        <td class="text-right"><strong>${item.Cantidad.toFixed(2)}</strong></td>
                    </tr>`;
                    $tbody.append(row);
                });
            }
        }).fail(function() {
            $tbody.empty();
            $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Fallo de conexión al cargar el historial.</td></tr>`);
        });
    }

