    // ── FUNCION MAESTRA PARA ENVIAR OPERACION AL SERVIDOR ──
    function enviarOperacion(np, codInsumo, tipoOpe, cant, motivo, mermaRef, modalId, fuenteConsumo, colorPantone) {
        var ope = {
            NP: np, CodInsumo: codInsumo, TipoOperacion: tipoOpe, 
            Cantidad: cant, Motivo: motivo, MermaReutilizada: mermaRef,
            FuenteConsumo: fuenteConsumo || null,
            NombreColor: colorPantone || null
        };
        $.post('@Url.Action("RegistrarOperacion", "Liquidacion")', ope, function(response) {
            if (response.success) {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success', 
                    title: 'Operación registrada en servidor.', showConfirmButton: false, timer: 3000
                });
                $(modalId).modal("hide");
                cargarDataInicial(); // Recarga toda la data desde BD para obtener nuevos saldos matemáticos
            } else {
                Swal.fire('Error en Servidor', response.message, 'error');
            }
        }).fail(function() {
            Swal.fire('Error de Conexión', 'No se pudo conectar con el servidor', 'error');
        });
    }

    // ── REGISTRO DE ACCIÓN: CONSUMO ──
    function registrarConsumo() {
        var codInsumo = $("#ddlConsumoInsumo").val();
        var cant = parseFloat($("#txtConsumoCantidad").val());
        var fuente = $("input[name='optFuenteConsumo']:checked").val();

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }

        var mermaRef = null;
        var motivo = "Consumo registrado";
        var saldoDisp = 0;

        if (fuente === 'Stock Inicial') {
            saldoDisp = parseFloat($("#txtSaldoInicial").val());
        } else if (fuente === 'Solicitud Realizada') {
            saldoDisp = parseFloat($("#txtSaldoSolicitud").val());
        } else if (fuente === 'Stock Merma') {
            var ddlMerma = $("#ddlMermaReutilizar option:selected");
            if (!ddlMerma.val()) {
                Swal.fire({ title: 'Error', text: 'Debe seleccionar una merma existente a reutilizar.', icon: 'error', confirmButtonColor: '#002D72' });
                return;
            }
            mermaRef = ddlMerma.val();
            motivo = $("#txtMotivoMerma").val().trim();
            if (!motivo) {
                Swal.fire({ title: 'Error', text: 'El motivo es obligatorio al consumir merma.', icon: 'error', confirmButtonColor: '#002D72' });
                return;
            }
            saldoDisp = parseFloat(ddlMerma.data("stock"));
        }

        if (cant > saldoDisp) {
            Swal.fire({ title: 'Saldo Insuficiente', text: 'La cantidad a consumir supera el saldo disponible de la fuente seleccionada (' + fuente + ': ' + saldoDisp.toFixed(2) + ' gr).', icon: 'warning', confirmButtonColor: '#f39c12' });
            return;
        }

        var pantone = $("#consumoModal").data("color");
        enviarOperacion(selectedNP, codInsumo, "Consumo", cant, motivo, mermaRef, "#consumoModal", fuente, pantone);
    }

    // ── REGISTRO DE ACCIÓN: MERMA POR COLOR ──
    function registrarMermaColorBtn() {
        var isNoMerma = $("#chkNoMerma").is(":checked");
        var cant = parseFloat($("#txtMermaColorCantidad").val());
        var fechaVenc = $("#txtMermaColorVencimiento").val();
        var pantone = $("#hdnMermaColorPantone").val();

        if (!isNoMerma) {
            if (isNaN(cant) || cant <= 0) {
                Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0, o marque "No existe merma".', icon: 'error', confirmButtonColor: '#f39c12' });
                return;
            }
            if (!fechaVenc) {
                Swal.fire({ title: 'Error', text: 'Debe ingresar una fecha de vencimiento válida estimada para la merma.', icon: 'error', confirmButtonColor: '#f39c12' });
                return;
            }
        }

        var objMerma = {
            NP: selectedNP,
            NombreColor: pantone,
            Gramos: isNoMerma ? 0 : cant,
            FechaVencimiento: fechaVenc
        };

        $.post('@Url.Action("RegistrarMermaColor", "Liquidacion")', objMerma, function(response) {
            if(response.success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Merma por color registrada.', showConfirmButton: false, timer: 3000 });
                
                $("#mermaColorModal").modal("hide");

                // Refrescar la data global de fondo para asegurar cálculos consistentes si se cierra luego
                cargarDataInicial(); 
            } else {
                Swal.fire('Error', response.message, 'error');
            }
        });
    }

    // ── REGISTRO DE ACCIÓN: AJUSTE DE SALDO ──
    function registrarAjuste() {
        var codInsumo = $("#ddlAjusteInsumo").val();
        var isNoAjuste = $("#chkNoAjuste").is(":checked");
        var cant = parseFloat($("#txtAjusteCantidad").val());
        var motivo = $("#txtAjusteMotivo").val().trim();
        var pantone = $("#ajusteModal").data("color");
        var fuenteAjuste = $("input[name='optFuenteAjuste']:checked").val();

        if (!isNoAjuste) {
            if (isNaN(cant) || cant <= 0) {
                Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida para ajustar.', icon: 'error', confirmButtonColor: '#10b981' });
                return;
            }
            if (!motivo) {
                Swal.fire({ title: 'Atención', text: 'El motivo del ajuste es obligatorio.', icon: 'warning', confirmButtonColor: '#10b981' });
                return;
            }

            var saldoReferencia = 0;
            var mermaRef = null;

            if (fuenteAjuste === "Stock Inicial") {
                saldoReferencia = parseFloat($("#txtAjusteSaldoInicial").val());
            } else if (fuenteAjuste === "Solicitud Realizada") {
                saldoReferencia = parseFloat($("#txtAjusteSaldoSolicitud").val());
            } else if (fuenteAjuste === "Stock Merma") {
                var ddlMermaAjuste = $("#ddlMermaReutilizarAjuste option:selected");
                if (!ddlMermaAjuste.val()) {
                    Swal.fire({ title: 'Error', text: 'Debe seleccionar una merma existente a ajustar.', icon: 'error', confirmButtonColor: '#10b981' });
                    return;
                }
                mermaRef = ddlMermaAjuste.val();
                saldoReferencia = parseFloat(ddlMermaAjuste.data("stock"));
            }

            if (cant > saldoReferencia) {
                Swal.fire({ title: 'Sobrepasa Saldo', text: 'La cantidad a ajustar no puede exceder el saldo disponible de la fuente seleccionada (' + saldoReferencia.toFixed(2) + ').', icon: 'error', confirmButtonColor: '#10b981' });
                return;
            }
        }
        
        var cantFinal = isNoAjuste ? 0 : cant;
        enviarOperacion(selectedNP, codInsumo, "Ajuste", cantFinal, isNoAjuste ? "No existe ajuste" : motivo, mermaRef, "#ajusteModal", fuenteAjuste, pantone);
    }

    // ── REGISTRO DE ACCIÓN: INGRESO ADICIONAL ──
    function registrarIngreso() {
        var codInsumo = $("#ddlIngresoInsumo").val();
        var cant = parseFloat($("#txtIngresoCantidad").val());
        var motivo = $("#txtIngresoMotivo").val().trim();
        var mermaReutilizada = $("#ddlIngresoReutilizarMerma").val();

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }
        if (!motivo) {
            Swal.fire({ title: 'Campo requerido', text: 'Por favor, detalle el motivo de este ingreso adicional.', icon: 'warning', confirmButtonColor: '#002D72' });
            return;
        }
        enviarOperacion(selectedNP, codInsumo, "Ingreso", cant, motivo, mermaReutilizada, "#ingresoModal");
    }

    // ── REGISTRO DE ACCIÓN: DEVOLUCIÓN AL ALMACÉN ──
    function registrarDevolucion() {
        var codInsumo = $("#ddlDevolucionInsumo").val();
        var cant = parseFloat($("#txtDevolucionCantidad").val());
        var tipoDevolucion = $("#ddlTipoDevolucion").val();
        var motivoDestino = $("#ddlMotivoDevolucion").val();
        var motivo = tipoDevolucion + ' - ' + motivoDestino;

        if (isNaN(cant) || cant <= 0) {
            Swal.fire({ title: 'Error', text: 'Ingrese una cantidad válida mayor a 0.', icon: 'error', confirmButtonColor: '#002D72' });
            return;
        }
        
        var pantone = $("#devolucionModal").data("color");

        var insFound = findInsumoInNP(selectedNP, codInsumo);
        if (insFound) {
            var saldo = insFound.stockRecibido - insFound.consumidoSolicitud - (insFound.ajusteSolicitud || 0) - (insFound.devueltoCentral || 0) - (insFound.devueltoOperativo || 0);
            if (cant > saldo) {
                Swal.fire({ title: 'Sobrepasa Saldo', text: 'La cantidad a devolver no puede exceder el saldo actual (' + saldo.toFixed(2) + ' gr).', icon: 'error', confirmButtonColor: '#002D72' });
                return;
            }
        }
        enviarOperacion(selectedNP, codInsumo, "Devolucion", cant, motivo, null, "#devolucionModal", "Solicitud Realizada", pantone);
    }

    // ── ABRIR MODAL NUEVA LIQUIDACIÓN ──
    function abrirNuevaLiquidacion() {
        $("#chkAllNPs").prop("checked", false);
        $(".chk-np-pendiente").prop("checked", false);
        $("#nuevaModal").modal("show");
        buscarNPsPendientes(); // Cargar automáticamente al abrir el modal
    }

    // ── BUSQUEDA FILTRADA DE NPS PENDIENTES ──
    function buscarNPsPendientes() {
        Swal.fire({
            title: 'Buscando órdenes...',
            text: 'Consultando NPs pendientes de liquidar',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.get('@Url.Action("ObtenerNPsPendientes", "Liquidacion")', function(data) {
            Swal.close();
            if(data.error) {
                Swal.fire('Error', data.error, 'error');
            } else {
                // Ya que la BD trae todos, aplicamos un renderizado directo
                renderNPsPendientes(data);
            }
        }).fail(function() {
            Swal.fire('Error', 'Fallo de conexión al buscar NPs.', 'error');
        });
    }

    // ── SELECCIONAR / DESELECCIONAR TODOS LOS PENDIENTES ──
    function toggleAllNPsCheckboxes(master) {
        $(".chk-np-pendiente").prop("checked", $(master).prop("checked"));
    }

    // ── GENERAR NUEVA LIQUIDACIÓN DESDE EL MODAL ──
    function generarLiquidacion() {
        var selectedKeys = [];
        $(".chk-np-pendiente:checked").each(function() {
            selectedKeys.push($(this).data("np"));
        });

        if (selectedKeys.length === 0) {
            Swal.fire({ title: 'Atención', text: 'Por favor, seleccione al menos una NP para liquidar.', icon: 'warning', confirmButtonColor: '#002D72' });
            return;
        }

        // En el sistema real aquí se enviaría la solicitud de generación.
        // Simularemos recargando la data inicial completa, asumiendo que el backend la marca en proceso.
        // Por ahora solo mostraremos un mensaje.
        
        Swal.fire({ title: 'Generando', text: 'Liquidación generada con éxito.', icon: 'success', timer: 2000, showConfirmButton: false });
        $("#nuevaModal").modal("hide");
        
        // Recargar data real
        setTimeout(function() { cargarDataInicial(); }, 2000);

        Swal.fire({
            title: 'Liquidaciones Creadas',
            text: 'Las órdenes seleccionadas fueron cargadas en el panel lateral.',
            icon: 'success',
            confirmButtonColor: '#002D72'
        });
    }

    function findInsumoInNP(np, codInsumo) {
        var liq = activeLiquidations[np] || finishedLiquidations[np];
        if (!liq) return null;
        
        var insumoEncontrado = null;
        liq.colores.forEach(function(col) {
            col.insumos.forEach(function(ins) {
                if (ins.codigo === codInsumo) {
                    insumoEncontrado = ins;
                }
            });
        });
        return insumoEncontrado;
    }

    $(document).ready(function() {
        $("input[name='optFuenteConsumo']").change(function() {
            if ($(this).val() === 'Stock Merma') {
                $("#contenedor-merma").slideDown(250);
                $("#ddlMermaReutilizar").prop('required', true);
                $("#txtMotivoMerma").prop('required', true);
            } else {
                $("#contenedor-merma").slideUp(250);
                $("#ddlMermaReutilizar").prop('required', false).val("");
                $("#txtMotivoMerma").prop('required', false).val("");
            }
        });

        $("input[name='optFuenteAjuste']").change(function() {
            if ($(this).val() === 'Stock Merma') {
                $("#contenedor-merma-ajuste").slideDown(250);
                $("#ddlMermaReutilizarAjuste").prop('required', true);
            } else {
                $("#contenedor-merma-ajuste").slideUp(250);
                $("#ddlMermaReutilizarAjuste").prop('required', false).val("");
            }
        });

        // Toggle visibilidad y estado para checkbox de No Ajuste
        $("#chkNoAjuste").change(function() {
            if ($(this).is(":checked")) {
                $("#txtAjusteCantidad").val('').prop("disabled", true);
                $("#lblEqAjuste").hide();
            } else {
                $("#txtAjusteCantidad").prop("disabled", false);
                $("#lblEqAjuste").show();
                actualizarEquivalenciaUX();
            }
        });
    });

    function abrirHistorialMerma(codigoMerma) {
        $("#lblHistorialUsoMermaCodigo").text(codigoMerma);
        $("#tbodyHistorialUsoMermaConsumo").html('<tr><td colspan="6" class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Cargando...</td></tr>');
        $("#tbodyHistorialUsoMermaAjuste").html('<tr><td colspan="6" class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Cargando...</td></tr>');
        
        $("#historialUsoMermaModal").modal("show");

        $.get('@Url.Action("ObtenerHistorialUsoMerma", "Liquidacion")?codigoMerma=' + codigoMerma, function(response) {
            if (response && !response.error) {
                var consumosHtml = '';
                var ajustesHtml = '';

                response.forEach(function(item) {
                    var row = `<tr>
                        <td>${item.Fecha}</td>
                        <td>${item.Usuario}</td>
                        <td>${item.Fuente}</td>
                        <td><strong>${item.NP || '-'}</strong></td>
                        <td>${item.Motivo}</td>
                        <td class="text-right"><strong>${item.Cantidad.toFixed(2)}</strong></td>
                    </tr>`;

                    if (item.TipoOperacion === 'Consumo') {
                        consumosHtml += row;
                    } else if (item.TipoOperacion === 'Ajuste') {
                        ajustesHtml += row;
                    }
                });

                if (consumosHtml === '') {
                    consumosHtml = '<tr><td colspan="6" class="text-center text-muted">No hay consumos registrados para esta merma.</td></tr>';
                }
                if (ajustesHtml === '') {
                    ajustesHtml = '<tr><td colspan="6" class="text-center text-muted">No hay ajustes registrados para esta merma.</td></tr>';
                }

                $("#tbodyHistorialUsoMermaConsumo").html(consumosHtml);
                $("#tbodyHistorialUsoMermaAjuste").html(ajustesHtml);
            } else {
                var errRow = '<tr><td colspan="6" class="text-center text-danger">Error al cargar historial</td></tr>';
                $("#tbodyHistorialUsoMermaConsumo").html(errRow);
                $("#tbodyHistorialUsoMermaAjuste").html(errRow);
                console.error("Error obteniendo historial de merma:", response.error);
            }
        });
    }

    // --- UX: Conversión Dinámica de Gramos a Kilos y Alertas Smart ---
    function actualizarEquivalenciaUX() {
        $('.conversion-gramos').each(function() {
            var val = parseFloat($(this).val());
            var targetId = $(this).data('target');
            var $lbl = $('#' + targetId);
            var modalId = $(this).closest('.modal').attr('id');

            if (isNaN(val) || val <= 0) {
                $lbl.text('');
                return;
            }

            var icon = 'fa-exchange-alt';
            var color = '#0ea5e9'; // Color por defecto (Stock Total / Neutro)

            // Asignar color dinámicamente según la fuente que se está afectando
            if (modalId === 'consumoModal') {
                var fuenteConsumo = $("input[name='optFuenteConsumo']:checked").val();
                if (fuenteConsumo === 'Stock Inicial') color = 'var(--hialpesa-dark)'; // Stock Operativo
                else if (fuenteConsumo === 'Solicitud Realizada') color = 'var(--hialpesa-accent)'; // Stock Recibido
                else if (fuenteConsumo === 'Stock Merma') color = '#c2410c'; // Stock Merma
            } 
            else if (modalId === 'ajusteModal') {
                var fuenteAjuste = $("input[name='optFuenteAjuste']:checked").val();
                if (fuenteAjuste === 'Stock Inicial') color = 'var(--hialpesa-dark)'; // Stock Operativo
                else if (fuenteAjuste === 'Solicitud Realizada') color = 'var(--hialpesa-accent)'; // Stock Recibido
                else if (fuenteAjuste === 'Stock Merma') color = '#c2410c'; // Stock Merma
            }
            else if (modalId === 'mermaColorModal') {
                color = '#dc3545'; // Merma es una salida/pérdida (Rojo)
            }
            else if (modalId === 'ingresoModal') {
                var reutilizarMerma = $("#ddlIngresoReutilizarMerma").val();
                if (reutilizarMerma === '') color = '#28a745'; // Ingreso nuevo (Verde)
                else color = '#c2410c'; // Reutilizando Merma (Naranja)
            }
            else if (modalId === 'devolucionModal') {
                var tipoDevolucion = $("#ddlTipoDevolucion").val();
                if (tipoDevolucion === 'Almacén Central') color = '#dc3545'; // Salida definitiva
                else color = '#8b5cf6'; // Morado (Almacén Operativo interno)
            }
            
            var htmlEq = '<i class="fas ' + icon + '"></i> Equivale a: ' + (val / 1000).toFixed(3) + ' KG';
            
            // Smart Warning
            if (val >= 20000) {
                htmlEq += ' <span style="color:#d97706; font-size:0.9em; margin-left:10px;"><i class="fas fa-exclamation-triangle"></i> ¡Atención! Son más de 20 Kilos.</span>';
            }

            $lbl.html(htmlEq).css('color', color);
        });
    }

    $('.conversion-gramos').on('input', actualizarEquivalenciaUX);
    $("input[name='optFuenteConsumo']").on('change', actualizarEquivalenciaUX);
    $("input[name='optFuenteAjuste']").on('change', actualizarEquivalenciaUX);
    $("#ddlIngresoReutilizarMerma").on('change', actualizarEquivalenciaUX);
    $("#ddlTipoDevolucion").on('change', actualizarEquivalenciaUX);

</script>
}
