    function cargarHistoricoMermasColor(np, pantoneDesc) {
        var $tbody = $("#tablaHistoricoMermas tbody");
        $tbody.empty();
        $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;"><i class="fas fa-spinner fa-spin"></i> Cargando historial...</td></tr>`);

        $.get('@Url.Action("ObtenerMermasPorColor", "Liquidacion")', { np: np, color: pantoneDesc }, function(data) {
            $tbody.empty();
            if(data.error) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Error al cargar historial.</td></tr>`);
            } else if (!data || data.length === 0) {
                $tbody.append(`<tr><td colspan="5" class="text-center text-muted" style="padding: 15px;">No hay mermas registradas previamente.</td></tr>`);
            } else {
                var hasRealMerma = false;
                data.forEach(function(item) {
                    var isNoMerma = item.Cantidad === 0 && item.CodigoMerma === 'NO_MERMA';
                    if (!isNoMerma) { hasRealMerma = true; }
                    var stLabel = isNoMerma ? '<span class="label label-default" style="background-color:#f1f5f9; color:#64748b; border: 1px solid #cbd5e1;">No existe merma</span>' : '<span class="label label-primary" style="background-color:#f0f9ff; color:#0284c7; border: 1px solid #bae6fd;">Registrado</span>';
                    var row = `<tr>
                        <td class="text-center"><strong>${item.CodigoMerma || '-'}</strong></td>
                        <td class="text-center" style="color: #d97706;"><strong>${item.Cantidad.toFixed(2)}</strong></td>
                        <td class="text-center">${item.FechaRegistro}</td>
                        <td class="text-center">${item.FechaVencimiento || '-'}</td>
                        <td class="text-center">${stLabel}</td>
                    </tr>`;
                    $tbody.append(row);
                });
                if (hasRealMerma) {
                    $("#chkNoMerma").prop("checked", false).prop("disabled", true);
                    $("#chkNoMerma").closest(".form-group").slideUp();
                } else {
                    $("#chkNoMerma").prop("disabled", false);
                    $("#chkNoMerma").closest(".form-group").slideDown();
                }
            }
        }).fail(function() {
            $tbody.empty();
            $tbody.append(`<tr><td colspan="5" class="text-center text-danger">Fallo de conexión al cargar el historial.</td></tr>`);
        });
    }

