@inherits System.Web.Mvc.WebViewPage<System.Collections.Generic.List<AppGenReceta.BE.LIQ_RequerimientoBE>>
@{
    ViewBag.Title = "Pendientes de Ingreso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<style>
    /* ESTANDARIZACION GLOBAL DE BOTONES UI/UX */
    .btn { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); z-index: 1; position: relative; }
    .table .btn:hover { transform: scale(1.05) translateY(0); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

    :root {
        --hialpesa-blue: #002D72;
        --hialpesa-accent: #e67e22; /* Tono naranja más intenso para jerarquía hija */
        --bg-light: #f8f9fa;
    }

    .btn-header-back {
        background-color: #f8f9fa;
        color: #6c757d;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 20px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

    .btn-header-back:hover {
        background-color: #e2e6ea;
        color: #495057;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        text-decoration: none;
    }

    .btn-warning {
        background-color: var(--hialpesa-accent) !important;
        border-color: var(--hialpesa-accent) !important;
        color: white !important;
    }

    .btn-warning:hover {
        background-color: #d35400 !important; /* Tono aún más profundo al pasar el mouse */
        border-color: #d35400 !important;
        color: white !important;
    }

    .table-container {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .table thead {
        background-color: #f4f8fa !important;
        border-top: 4px solid var(--hialpesa-blue) !important;
        border-bottom: 2px solid #DEE2E6 !important;
    }

    .table thead th {
        border: none !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        font-size: 1.1rem !important;
        letter-spacing: 0.8px;
        padding: 14px !important;
        color: var(--hialpesa-blue) !important;
    }
</style>

<div class="container-fluid py-4">
    <!-- Título y Botones de Acción -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 25px; padding: 0 10px;">
        <div style="flex: 1 1 auto; margin-bottom: 15px;">
            <h1 style="margin: 0; color: var(--hialpesa-blue); font-weight: 800; font-size: 28px; border-left: 6px solid var(--hialpesa-accent); padding-left: 15px; letter-spacing: -0.5px;">
                Pendientes de Ingreso
            </h1>
            <p style="margin: 5px 0 0 20px; color: #6c757d; font-size: 14px;">Lista de requerimientos de insumos pendientes de confirmación y recepción.</p>
        </div>

            <a href="@Url.Action("MantenimientoProcesoProductivo", "Liquidacion")" class="btn-header-back">
                <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Regresar
            </a>
    </div>

    <!-- Panel de Filtros -->
    <div class="panel panel-default shadow-sm mb-4" style="border: 1px solid var(--hialpesa-accent); border-left: 6px solid var(--hialpesa-accent); border-radius: 8px;">
        <div class="panel-body" style="padding: 15px;">
            <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 15px;">
                <div style="flex: 0 0 auto; min-width: 150px; background: #f8f9fa; padding: 10px; border-radius: 6px; border: 1px solid #ddd;">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="optBusqueda" id="optFecha" value="1" checked>
                        <label class="form-check-label font-weight-bold" for="optFecha">Fecha</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="optBusqueda" id="optNP" value="2">
                        <label class="form-check-label font-weight-bold" for="optNP">Partidas (NP)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="optBusqueda" id="optNumReq" value="3">
                        <label class="form-check-label font-weight-bold" for="optNumReq">N° Requerimiento</label>
                    </div>
                </div>
                <div style="flex: 1; min-width: 200px;" id="divDesde">
                    <label class="font-weight-bold text-muted mb-1"><i class="fas fa-calendar-alt text-warning mr-1"></i> Desde</label>
                    <input type="date" class="form-control" id="txtDesde" />
                </div>
                <div style="flex: 1; min-width: 200px;" id="divHasta">
                    <label class="font-weight-bold text-muted mb-1"><i class="fas fa-calendar-check text-warning mr-1"></i> Hasta</label>
                    <input type="date" class="form-control" id="txtHasta" />
                </div>
                <div style="flex: 1; min-width: 150px;" id="divNumReq">
                    <label class="font-weight-bold text-muted mb-1"><i class="fas fa-hashtag text-warning mr-1"></i> N° Req.</label>
                    <input type="number" class="form-control" id="txtNumReq" placeholder="Ej. 12345" min="1" step="1" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                </div>
                <div style="flex: 1; min-width: 150px;" id="divNP">
                    <label class="font-weight-bold text-muted mb-1"><i class="fas fa-file-alt text-warning mr-1"></i> NP</label>
                    <input type="text" class="form-control" id="txtNP" placeholder="Nota Pedido" />
                </div>
                <div style="flex: 0 0 auto; min-width: auto; padding-bottom: 2px;">
                    <button type="button" class="btn btn-warning px-4 mb-0" id="btnBuscar" style="border-radius: 6px; color: white;">
                        <i class="fas fa-search mr-2"></i> Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Contenido -->
    <div class="table-container">
        <div class="table-responsive">
            <table id="tblRequerimientos" class="table table-hover table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th class="text-center">N° Req.</th>
                        <th class="text-center">Fecha Creación</th>
                        <th class="text-center">Partida</th>
                        <th>Observaciones</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Llenado por AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

    <div class="modal fade" id="modalVistaPrevia" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog modal-lg" role="document" style="max-width: 900px;">
            <div class="modal-content" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                <div class="modal-header" style="background-color: var(--hialpesa-blue); color: white; border-bottom: 4px solid var(--hialpesa-accent);">
                    <h5 class="modal-title" id="modalVistaPreviaLabel" style="font-weight: 700;"><i class="fas fa-box-open mr-2" style="color: var(--hialpesa-accent);"></i> Confirmar Recepción Física - Req. N° <span id="spanNumReq"></span></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body bg-light" style="padding: 25px;">
                    <input type="hidden" id="hdnNumReq" />
                    <input type="hidden" id="hdnCodOrdPro" />
                    <input type="hidden" id="hdnMotivo" />
                    
                    <div class="alert" style="background-color: #fffaf0; border: 1px solid #fbdcbf; border-left: 5px solid var(--hialpesa-accent); color: #8a3800;">
                    <strong><i class="fas fa-info-circle mr-1"></i> OP:</strong> <span id="spanOp"></span><br />
                    <strong><i class="fas fa-comment mr-1"></i> Observaciones:</strong> <span id="spanObs"></span>
                </div>

                <div id="divSelectorVersion" class="alert alert-warning p-2" style="display:none;">
                    <strong><i class="fas fa-exclamation-triangle"></i> Múltiples versiones detectadas</strong>
                    <p class="mb-1" style="font-size: 0.9em;">Seleccione la versión destino para el ingreso del material:</p>
                    <select id="cboDestinoVersion" class="form-control form-control-sm"></select>
                </div>

                <div id="divSelectorItem" class="alert alert-info p-2 mb-2" style="display:none;">
                    <strong><i class="fas fa-tags"></i> Item de Fórmula Activa</strong>
                    <p class="mb-1" style="font-size: 0.9em;">Seleccione el Item correspondiente a la fórmula para registrar la recepción:</p>
                    <select id="cboDestinoItem" class="form-control form-control-sm"></select>
                </div>

                    <div class="table-responsive" style="border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #dee2e6;">
                        <table class="table table-sm table-hover mb-0 bg-white" id="tblDetalleReq">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th style="color: var(--hialpesa-blue); padding: 12px 10px; border-bottom: 2px solid #dee2e6;">Item</th>
                                    <th style="color: var(--hialpesa-blue); padding: 12px 10px; border-bottom: 2px solid #dee2e6;">Descripción</th>
                                    <th class="text-right" style="color: var(--hialpesa-blue); padding: 12px 10px; border-bottom: 2px solid #dee2e6;">Cantidad</th>
                                    <th class="text-center" style="color: var(--hialpesa-blue); padding: 12px 10px; border-bottom: 2px solid #dee2e6;">UM</th>
                                    <th class="text-center" style="color: var(--hialpesa-blue); padding: 12px 10px; border-bottom: 2px solid #dee2e6;">Lote</th>
                                </tr>
                            </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
                <div class="modal-footer" style="background-color: #f8f9fa; border-top: 1px solid #dee2e6; padding: 15px 25px;">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" style="border-radius: 8px; font-weight: 600; padding: 10px 20px;"><i class="fas fa-times mr-1"></i> Cancelar</button>
                    <button type="button" class="btn btn-warning" id="btnConfirmarRecepcion" style="border-radius: 8px; font-weight: 600; padding: 10px 20px;"><i class="fas fa-check-circle mr-1"></i> Registrar Recepción</button>
                </div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/Liquidacion/Requerimientos.js")?v=@DateTime.Now.Ticks"></script>
}
