@model SenatiLR.Web.Models.Home.ReclamoViewModel
@using SenatiLR.BE;
@{
    ViewBag.Title = "Libro de Reclamaciones Virtual";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.9/dist/css/bootstrap-select.min.css">



<div class="panel-body">

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-xs-12 col-sm-6">
                    <h2>
                        <span style="padding-left:10px; border-left:5px solid #07238a; color: #07238a;">
                            Fecha: <span id="lblFecha" style="padding-left:10px; color: #07238a;">@Model.FechaRegistro.ToShortDateString()</span>
                        </span>
                    </h2>
                </div>



            </div>
        </div>
    </div>


    <form action="@Url.Action("RegistrarReclamo","Home")" method="post" id="formLibroReclamo">

        <input type="hidden" name="IDEmpleadoCreador" value="@Model.IDEmpleado" />



        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Identificación del Consumidor Reclamante</span>
                </h2>
                <div class="row">
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="Clasificacion">
                                Contacto:
                            </label>
                            <select name="IDContacto" id="IDContacto" class="form-control select">
                                @foreach (ContactoBE contacto in Model.Contactos)
                                {
                                    <option value="@contacto.IDContacto">@contacto.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="Nombres">
                                Nombres:
                            </label>
                            <input name="Nombres" type="text" id="Nombres" class="form-control" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="ApellidoPaterno">
                                Apellido Paterno:
                            </label>
                            <input name="ApellidoPaterno" type="text" id="ApellidoPaterno" class="form-control" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="ApellidoMaterno">
                                Apellido Materno:
                            </label>
                            <input name="ApellidoMaterno" type="text" id="ApellidoMaterno" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="IDAlumno">
                                ID:
                            </label>
                            <input name="IDAlumno" type="text" id="IDAlumno" class="form-control" maxlength="12" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="Documento">
                                DNI / CE:
                            </label>
                            <input name="Documento" type="text" id="Documento" class="form-control" maxlength="12" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="TelefonoCelular">
                                Celular o Teléfono Fijo:
                            </label>
                            <input name="TelefonoCelular" type="text" id="TelefonoCelular" class="form-control" maxlength="9" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="Correo">
                                Correo:
                            </label>
                            <input name="Correo" type="text" id="Correo" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="CodigoDepartamento">
                                Departamento:
                            </label>
                            <select name="CodigoDepartamento" id="CodigoDepartamento" class="form-control select">
                                <option value="0">Seleccione</option>
                                @foreach (UbigeoBE departamento in Model.Departamentos)
                                {
                                    <option value="@departamento.CodigoDepartamento">@departamento.Departamento</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="CodigoProvincia">
                                Provincia:
                            </label>
                            <select name="CodigoProvincia" id="CodigoProvincia" class="form-control select">
                                <option value="0">Seleccione</option>

                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="IDUbigeo">
                                Distrito:
                            </label>
                            <select name="IDUbigeo" id="IDUbigeo" class="form-control select">
                                <option value="0">Seleccione</option>

                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-3">
                        <div class="form-group">
                            <label for="Direccion">
                                Dirección:
                            </label>
                            <input name="Direccion" type="text" id="Direccion" class="form-control upper-case" />
                        </div>
                    </div>
                </div>

                <div id="div_apoderado_2" class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label for="txtApoderado">
                                En caso sea menor de edad colocar el nombre del Padre, Madre o Apoderado:
                            </label>
                            <input name="Apoderado" type="text" id="Apoderado" class="form-control" placeholder="Para el caso de menores de edad" />
                        </div>
                    </div>
                </div>


            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Identificación del Bien Contratado</span>
                </h2>

                <div class="row">

                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group">
                            <label for="TelefonoCelular">
                                Tipo de bien:
                            </label>
                            <select name="IDBienContratado" id="IDBienContratado" class="form-control select">
                                @foreach (BienContratadoBE bien in Model.BienContratados)
                                {
                                    <option value="@bien.IDBienContratado">@bien.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group">
                            <label for="TelefonoCelular">
                                Monto reclamado :
                            </label>
                            <div class="form-inline">
                                <b>S./&nbsp;</b> <input name="MontoReclamado" type="number" id="MontoReclamado" class="form-control" style="display:inline-block;width:auto;" />
                            </div>
                        </div>
                    </div>



                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group">
                            <label for="Clasificacion">
                                Clasificación:
                            </label>
                            <select name="IDClasificacion" id="IDClasificacion" class="form-control select">
                                @foreach (ClasificacionBE clasificacion in Model.Clasificaciones)
                                {
                                    <option value="@clasificacion.IDClasificacion">@clasificacion.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label style="font-weight:bold">Descripción:</label>
                            <textarea name="Descripcion" id="Descripcion" class="form-control" rows="5" placeholder="En este espacio se debe ingresar la descripción del bien contratado"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Zonal / Sede</span>
                </h2>




                <div class="form-inline" style="margin-bottom:10px">

                    <div class="form-group">
                        <label for="SedeBuscar">
                            Buscar Sede:
                        </label>
                        <input name="SedeBuscar" type="text" id="SedeBuscar" class="form-control" style="width:200px;" />
                        <input type="button" class="btn btn-default" value="Buscar" id="btnBuscarSede" />
                    </div>



                    <div class="form-group">
                        &nbsp;&nbsp;
                        <label for="SedeBuscarResultado" id="SedeBuscarResultadoLabel">
                            
                        </label>
                    </div>


                </div>




                <div class="row">
                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group">
                            <label for="IDZonal">
                                Zonal:
                            </label>
                            <select name="IDZonal" id="IDZonal" class="form-control selectpicker" data-live-search="true">
                                <option value="0">Seleccione</option>
                                @foreach (ZonalBE zonal in Model.Zonales)
                                {
                                    <option value="@zonal.IDZonal">@zonal.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-4">
                        <div class="form-group">
                            <label for="IDSede">
                                Sede:
                            </label>
                            <select name="IDSede" id="IDSede" class="form-control selectpicker" data-live-search="true">
                                <option value="0">Seleccione</option>

                            </select>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-4">
                        <label for="">
                            &nbsp;
                        </label>
                        <p id="Sede_Direccion" style="color:#07238a;font-weight:bold;"></p>
                    </div>


                </div>

            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #07238a;">
                    <span style="padding-left: 10px; border-left: 5px solid #07238a; color: #07238a;">Detalle de la Reclamación y Pedido del Consumidor</span>
                </h2>

                @foreach (TipoBE tipo in Model.Tipos)
                {
                    if (tipo.IDTipo == 1)
                    {
                        <div class="radio">
                            <label>
                                <input type="radio" name="IDTipo" id="@String.Concat("Tipo", tipo.IDTipo)" value="@tipo.IDTipo"  />
                                <span style="font-weight: bold;">@tipo.Nombre:</span> @tipo.Descripcion
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="radio">
                            <label>
                                <input type="radio" name="IDTipo" id="@String.Concat("Tipo", tipo.IDTipo)" value="@tipo.IDTipo" checked />
                                <span style="font-weight: bold;">@tipo.Nombre:</span> @tipo.Descripcion
                            </label>
                        </div>
                    }
                }

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label for="DetallePedido">
                                Detalle2:
                            </label>

                            <textarea name="Detalle" id="Detalle" class="form-control" rows="5" placeholder="En este espacio se debe ingresar el detalle del reclamo a realizar"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label for="DetallePedido">
                                Pedido:
                            </label>

                            <textarea name="Pedido" id="Pedido" class="form-control" rows="5" placeholder="En este espacio se debe ingresar lo que solicite el reclamante para solucionar el reclamo"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12 col-sm-12">
                        <div class="form-group">
                            <label for="Evidencia">
                                Evidencia (Max. 30 MB):
                            </label>

                            <input type="file" name="Evidencia" id="Evidencia" class="form-control" />
                        </div>
                    </div>
                </div>

            </div>
        </div>


        <div class="panel panel-default">
            <div class="panel-body">
                <h2 class="page-header" style="margin-top: 0px; margin-bottom: 5px; border-bottom: 1px solid #ff0000;">
                    <span style="padding-left: 10px; border-left: 5px solid #ff0000; color: #ff0000;">Observaciones y acciones tomadas por el proveedor.</span>
                </h2>

                <p>
                    La respuesta a la presente será atendida mediante correo electrónico a la dirección que usted ha consignado en la presente hoja de reclamación.
                </p>

            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">


                <ol>
                    <li>
                        La formulación de reclamo no impide acudir a otras vias de solución de controversias ni es requisito previo para interponer una denuncia ante el INDECOPI
                    </li>
                    <li>
                        El proveedor deberá dar respuesta al reclamo en un plazo no mayor a treinta (30) días calendario, pudiendo ampliar el plazo hasta por treinta (30) días más, previa comunicación al consumidor
                    </li>
                </ol>


            </div>
        </div>


        <div style="text-align: right;">
            <a id="btnRegistrar" class="btn btn-info"><i class="fa fa-check"></i>&nbsp;Registrar</a>
            <a class="btn btn-default" href="@Url.Action("Index","Home")"><i class="fa fa-arrow-left"></i>&nbsp;Cancelar</a>


        </div>
    </form>

</div>

<input type="hidden" id="URL_ListarProvinciasPorDepartamento" value="@Url.Action("ListarProvinciasPorDepartamento","Home")" />
<input type="hidden" id="URL_ListarDistritosPorProvincia" value="@Url.Action("ListarDistritosPorProvincia","Home")" />

<input type="hidden" id="URL_ListarSedesPorIDZonal" value="@Url.Action("ListarSedesPorIDZonal","Home")" />
<input type="hidden" id="URL_BuscarSedePorNombre" value="@Url.Action("BuscarSedePorNombre","Home")" />



@section scripts{

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/sweetalert2@9.1.5/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.9/dist/js/bootstrap-select.min.js"></script>

    <script type="text/javascript" src="@Url.Content("~/Scripts/Home/Reclamo2.js?v=1.0.4")"></script>

}
